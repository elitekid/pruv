fn max_subarray(a: [i64]) -> i64
  requires len(a) >= 1
  requires len(a) <= 1_000_000
  requires forall k in 0..len(a): a[k] >= -1_000_000_000 && a[k] <= 1_000_000_000
{
  let mut cur: i64 = a[0];
  let mut best: i64 = a[0];
  let mut i: i64 = 1;
  while i < len(a)
    invariant 1 <= i && i <= len(a)
    invariant cur >= -1_000_000_000 && cur <= 1_000_000_000 * i
    invariant best >= -1_000_000_000 && best <= 1_000_000_000 * i
    decreases len(a) - i
  {
    if cur > 0 {
      cur = cur + a[i];
    } else {
      cur = a[i];
    }
    if cur > best {
      best = cur;
    }
    i = i + 1;
  }
  return best;
}
