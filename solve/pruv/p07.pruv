fn count_less(a: [i64], x: i64) -> i64
  requires len(a) <= 1_000_000
  ensures result >= 0 && result <= len(a)
{
  let mut c: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant 0 <= c && c <= i
    decreases len(a) - i
  {
    if a[i] < x {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}
