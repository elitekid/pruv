fn gcd(a: i64, b: i64) -> i64
  requires a >= 0 && a <= 1_000_000_000_000
  requires b >= 0 && b <= 1_000_000_000_000
  ensures result >= 0
{
  let mut x: i64 = a;
  let mut y: i64 = b;
  while y > 0
    invariant x >= 0 && y >= 0
    decreases y
  {
    let t: i64 = x % y;
    x = y;
    y = t;
  }
  return x;
}
