// G5 A0 frontend: old(a) in ensures (length, indexed content, quantified frame)
fn zero_first(inout a: [i64]) -> ()
  requires len(a) >= 1
  ensures len(a) == len(old(a))
  ensures a[0] == 0
  ensures forall k in 1..len(a): a[k] == old(a)[k]
  ensures sum(k in 0..len(a): a[k]) == sum(k in 0..len(a): old(a)[k]) - old(a)[0]
{
  a[0] = 0;
}
