// G5 A0 frontend: an inout [i64] parameter, an element store, old(a) in ensures, a marked call on a mutable local
fn set_at(inout a: [i64], i: i64, value: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures a[i] == value
  ensures len(a) == len(old(a))
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = value;
}

fn demo() -> i64 ! alloc {
  let mut data: [i64] = alloc(4, 0);
  set_at(inout data, 0, 7);
  return data[0];
}
