// G5 A1 proof: locals that are not passed inout keep their values and facts across an inout call; the marked one keeps its length
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo() -> i64 ! alloc
  ensures result == 11
{
  let mut a: [i64] = alloc(3, 5);
  let mut b: [i64] = alloc(3, 7);
  let m: i64 = len(a);
  set_at(inout a, 0, 1);
  assert len(a) == m;
  assert len(b) == 3;
  return a[0] + b[2] + m;
}
