// G5 A1 proof: direct recursion on an inout parameter with a decreases measure; the recursive call's own ensures
// is assumed only after its requires and termination obligations
fn zero_from(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i <= len(a)
  ensures len(a) == len(old(a))
  ensures forall k in i..len(a): a[k] == 0
  ensures forall k in 0..i: a[k] == old(a)[k]
  decreases len(a) - i
{
  if i < len(a) {
    a[i] = 0;
    zero_from(inout a, i + 1);
  }
}

fn demo() -> i64 ! alloc
  ensures result == 0
{
  let mut d: [i64] = alloc(3, 4);
  zero_from(inout d, 0);
  return d[1];
}
