// G5 A1 proof: exact store and frame contract of an inout [i64]; the caller relies on both across two calls
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo() -> i64 ! alloc
  ensures result == 17
{
  let mut data: [i64] = alloc(4, 3);
  set_at(inout data, 1, 9);
  set_at(inout data, 2, 5);
  return data[0] + data[1] + data[2];
}
