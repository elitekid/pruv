// G5 A1 proof (infer control): a local changed only by inout calls in a loop is neither an alloc initializer nor an
// element-store template for inference; the loop still verifies with and without --infer
fn set_zero(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == 0
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = 0;
}

fn demo(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 10
  ensures result == 0
{
  let mut a: [i64] = alloc(n, 7);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant len(a) == n
    invariant forall k in 0..i: a[k] == 0
    decreases n - i
  {
    set_zero(inout a, i);
    i = i + 1;
  }
  if n > 0 {
    return a[0];
  }
  return 0;
}
