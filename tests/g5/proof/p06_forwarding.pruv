// G5 A1 proof: an inout parameter forwarded to inout callees twice; the second call's frame keeps the first store
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn set_pair(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i + 1 < len(a) && -1000 < v && v < 1000
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures a[i + 1] == v + 1
{
  set_at(inout a, i, v);
  set_at(inout a, i + 1, v + 1);
}

fn demo() -> i64 ! alloc
  ensures result == 21
{
  let mut d: [i64] = alloc(4, 0);
  set_pair(inout d, 1, 10);
  return d[1] + d[2];
}
