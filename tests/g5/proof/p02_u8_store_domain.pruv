// G5 A1 proof: exact store and frame contract of an inout [u8]; fresh post-call contents keep the u8 domain
fn put_byte(inout buf: [u8], i: i64, b: i64) -> ()
  requires 0 <= i && i < len(buf) && 0 <= b && b <= 255
  ensures len(buf) == len(old(buf))
  ensures buf[i] == b
  ensures forall k in 0..len(buf): k != i ==> buf[k] == old(buf)[k]
{
  buf[i] = b;
}

fn noop(inout b: [u8]) -> () {
  let n: i64 = len(b);
}

fn first_after(inout b: [u8]) -> i64
  requires len(b) >= 1
  ensures 0 <= result && result <= 255
{
  noop(inout b);
  return b[0];
}

fn demo() -> i64 ! alloc
  ensures result == 207
{
  let mut bytes: [u8] = alloc(3, 7);
  put_byte(inout bytes, 1, 200);
  return bytes[0] + bytes[1];
}
