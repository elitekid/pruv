// G5 A1 proof: explicit old(a) loop invariants in a callee that stores element by element
fn double_all(inout a: [i64]) -> ()
  requires forall k in 0..len(a): 0 <= a[k] && a[k] <= 1000
  ensures len(a) == len(old(a))
  ensures forall k in 0..len(a): a[k] == 2 * old(a)[k]
{
  let n: i64 = len(a);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant n == len(old(a))
    invariant forall k in 0..i: a[k] == 2 * old(a)[k]
    invariant forall k in i..n: a[k] == old(a)[k]
    decreases n - i
  {
    a[i] = a[i] * 2;
    i = i + 1;
  }
}

fn demo() -> i64 ! alloc
  ensures result == 6
{
  let mut d: [i64] = alloc(2, 3);
  double_all(inout d);
  return d[1];
}
