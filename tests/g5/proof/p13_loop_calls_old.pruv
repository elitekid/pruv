// G5 A1 proof: a loop that calls an inout function; inout call havoc keeps the length, and the explicit invariants
// name the function-entry array with old(a)
fn inc_at(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a) && a[i] < 1000
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[i] + 1
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = a[i] + 1;
}

fn inc_all(inout a: [i64]) -> ()
  requires forall k in 0..len(a): a[k] < 1000
  ensures len(a) == len(old(a))
  ensures forall k in 0..len(a): a[k] == old(a)[k] + 1
{
  let n: i64 = len(a);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant n == len(old(a))
    invariant forall k in 0..i: a[k] == old(a)[k] + 1
    invariant forall k in i..n: a[k] == old(a)[k]
    decreases n - i
  {
    inc_at(inout a, i);
    i = i + 1;
  }
}

fn demo() -> i64 ! alloc
  ensures result == 3
{
  let mut d: [i64] = alloc(3, 2);
  inc_all(inout d);
  return d[0];
}
