// Source finding: bench/g8/results/mutants.json m038 (incorrect_maximum).
mod std;
pub fn array_max_i64(a: [i64]) -> i64
  requires len(a) > 0
  ensures result == max(k in 0..len(a): a[k])
{
  let mut m: i64 = 0;
  let mut i: i64 = 1;
  while i < len(a)
    invariant 1 <= i && i <= len(a)
    invariant m == max(k in 0..i: a[k])
    decreases len(a) - i
  {
    if a[i] > m { m = a[i]; }
    i = i + 1;
  }
  return m;
}
