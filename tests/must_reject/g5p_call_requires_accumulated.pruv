// G5 A1 reject: the third call's requires fails on the pre-call value (998 -> 999 -> 1000, then a[0] < 1000 is false)
fn bump(inout a: [i64]) -> ()
  requires len(a) >= 1 && a[0] < 1000
  ensures len(a) == len(old(a))
  ensures a[0] == old(a)[0] + 1
{
  a[0] = a[0] + 1;
}

fn demo() -> () ! alloc {
  let mut d: [i64] = alloc(1, 998);
  bump(inout d);
  bump(inout d);
  bump(inout d);
}
