fn f(n: i64) -> i64
  requires 0 <= n && n <= 10
{
  let mut x: i64 | 0..=10 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    decreases n - i
  {
    let mut j: i64 = 0;
    while j < n
      invariant 0 <= j && j <= n
      decreases n - j
    {
      x = x + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return x;
}
