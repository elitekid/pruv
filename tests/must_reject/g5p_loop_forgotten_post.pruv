// G5 A1 reject: after a loop whose body calls an inout function, the contents of the array are havocked (length kept)
fn set_zero(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == 0
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = 0;
}

fn demo() -> i64 ! alloc {
  let mut a: [i64] = alloc(3, 7);
  let mut i: i64 = 0;
  while i < 3
    invariant 0 <= i && i <= 3
    decreases 3 - i
  {
    set_zero(inout a, i);
    i = i + 1;
  }
  assert a[1] == 7;
  return 0;
}
