fn chk(a: [i64], i: i64) -> bool
  requires 0 <= i && i < len(a)
  ensures 0 <= i && i < len(a)
{ return true; }

fn bad(a: [i64], i: i64) -> i64 {
  let ok: bool = (0 <= i && i < len(a)) && chk(a, i);
  return a[i];
}

fn main() -> () ! io, alloc {
  let a: [i64] = alloc(0, 0);
  print(bad(a, 100));
}
