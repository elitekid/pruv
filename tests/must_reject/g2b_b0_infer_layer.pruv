// unsupported_type(codegen, --infer): B1부터 증명은 통과하고 생성 층이 거부한다 (while 루프가 있는 정상 str 프로그램, --infer)
fn zeros(s: str) -> i64
  requires len(s) >= 0
{
  let mut i: i64 = 0;
  let mut z: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s)
    decreases len(s) - i
  {
    if s[i] == 0 {
      z = z + 1;
    }
    i = i + 1;
  }
  return z;
}
