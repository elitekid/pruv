// G5 A1 reject: the loop calls an inout function on a and also replaces a with a 1-element array; no fixed-length
// assumption may leak out of the loop, so a[1] after the loop is not provably in bounds
fn set_zero(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == 0
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = 0;
}

fn demo(n: i64) -> i64 ! alloc
  requires 2 <= n && n <= 8
{
  let mut a: [i64] = alloc(n, 1);
  let mut i: i64 = 0;
  while i < 2
    invariant 0 <= i && i <= 2
    decreases 2 - i
  {
    if len(a) > 0 {
      set_zero(inout a, 0);
    }
    a = alloc(1, 3);
    i = i + 1;
  }
  return a[1];
}
