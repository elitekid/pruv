// unsupported_type(codegen): 리터럴 → copy → substr → 함수 반환 → 호출자 흐름의 모든 의무가 증명되고 생성 층에서 거부된다 (B1 양성 증명)
fn head(s: str, i: i64) -> str ! alloc
  requires 0 <= i && i <= len(s)
  requires is_char_boundary(s, i)
  ensures len(result) == i
  ensures forall k in 0..i: k < len(result) && result[k] == s[k]
{
  let c: str = copy(s);
  let d: str = substr(c, 0, i);
  return d;
}

fn driver() -> i64 ! alloc {
  let a: str = "안녕";
  let b: str = head(a, 3);
  assert len(b) == 3;
  assert b[0] == 236;
  let t: str = substr("héllo", 1, 3);
  assert len(t) == 2;
  assert t[0] == 195;
  assert t[1] == 169;
  return 0;
}
