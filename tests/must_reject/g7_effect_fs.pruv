// G7: fs is reachable from a branch (declared on a helper)
fn set_first(inout a: [i64], value: i64) -> ()
  requires len(a) > 0
  ensures a[0] == value
{ a[0] = value; }

fn probe(inout a: [i64]) -> () ! fs {
}

fn demo(inout a: [i64], inout b: [i64]) -> () ! fs {
  par {
    set_first(inout b, 2);
    probe(inout a);
  }
}
