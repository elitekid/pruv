// G9 A1 reject: the loop assigns a field so the whole struct is havocked; without `invariant len(q.bytes) >= 1` the index fails (index_oob)
struct Packet { bytes: [u8], tag: i64 }

fn touch(p: Packet) -> i64 ! alloc
  requires len(p.bytes) >= 1
{
  let mut q: Packet = p;
  let mut i: i64 = 0;
  while i < 3
    invariant 0 <= i && i <= 3
    decreases 3 - i
  {
    q.tag = i;
    i = i + 1;
  }
  return q.bytes[0];
}
