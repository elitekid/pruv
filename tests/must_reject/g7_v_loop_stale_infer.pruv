// G7 A1 reject with --infer: inference must not keep the initializer content fact a[0] == 7 across a loop group
fn bump(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == 1
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = 1;
}

fn demo(n: i64) -> () ! alloc
  requires 0 <= n && n <= 4
{
  let mut a: [i64] = alloc(4, 7);
  let mut b: [i64] = alloc(4, 7);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    decreases n - i
  {
    par {
      bump(inout a, i);
      bump(inout b, i);
    }
    i = i + 1;
  }
  assert b[0] == 7;
}
