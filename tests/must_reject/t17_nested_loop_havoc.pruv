fn f(a: [i64]) -> i64 requires len(a) == 4 {
  let mut i: i64 = 0;
  let mut k: i64 = 0;
  while i < 2
    invariant 0 <= i && i <= 2
    decreases 2 - i
  {
    let mut j: i64 = 0;
    while j < 2
      invariant 0 <= j && j <= 2
      decreases 2 - j
    {
      k = k + 3;
      j = j + 1;
    }
    i = i + 1;
  }
  return a[k];
}
