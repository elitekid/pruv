// G7 A1 reject: stale contents of a written array do not survive the group (the helper writes nothing but promises nothing)
fn scramble(inout a: [i64]) -> () {
  let n: i64 = len(a);
}

fn touch(inout b: [i64]) -> () {
  let n: i64 = len(b);
}

fn demo() -> i64 ! alloc {
  let mut p: [i64] = alloc(2, 5);
  let mut q: [i64] = alloc(2, 6);
  par {
    scramble(inout p);
    touch(inout q);
  }
  assert p[0] == 5;
  return 0;
}
