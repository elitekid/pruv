// G3 A3 specialization limit (depth): every generic function calls the next one with 8 more nested Option layers,
// so d_k is instantiated at nesting depth 8k + 1 (d0::<i64> is depth 1). d15 is depth 121; d16 would be depth 129,
// over the limit of 128. The program is small, type-correct and proves; code generation stops at the call of d16.
fn d17<T>() -> i64 {
  return 0;
}

fn d16<T>() -> i64 {
  return d17::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d15<T>() -> i64 {
  return d16::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d14<T>() -> i64 {
  return d15::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d13<T>() -> i64 {
  return d14::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d12<T>() -> i64 {
  return d13::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d11<T>() -> i64 {
  return d12::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d10<T>() -> i64 {
  return d11::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d9<T>() -> i64 {
  return d10::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d8<T>() -> i64 {
  return d9::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d7<T>() -> i64 {
  return d8::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d6<T>() -> i64 {
  return d7::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d5<T>() -> i64 {
  return d6::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d4<T>() -> i64 {
  return d5::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d3<T>() -> i64 {
  return d4::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d2<T>() -> i64 {
  return d3::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d1<T>() -> i64 {
  return d2::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn d0<T>() -> i64 {
  return d1::<Option<Option<Option<Option<Option<Option<Option<Option<T>>>>>>>>>();
}

fn run() -> i64 {
  return d0::<i64>();
}
