// G9 A1 reject: node_total is correct, but the caller passes a tree whose size is not known to be <= 1000 (call_requires)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn node_total(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result == size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 1; }
    Tree::Node(v, l, r) => { return 1 + node_total(l) + node_total(r); }
  }
}

fn doubled(t: Tree) -> i64 ! alloc {
  let big: Tree = Tree::Node(0, t, t);
  return node_total(big);
}
