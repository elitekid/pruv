// G7 A1 reject: the first branch index is out of the entry length (5 >= 3)
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo() -> () ! alloc {
  let mut p: [i64] = alloc(3, 0);
  let mut q: [i64] = alloc(3, 0);
  par {
    set_at(inout p, 5, 1);
    set_at(inout q, 0, 2);
  }
}
