// unsupported_type(codegen): is_char_boundary 의 모든 경계 판정(0·len·가운데·음수·len 초과)이 증명되고 생성 층에서 거부된다 (B1 양성 증명)
fn f() -> i64 ! alloc {
  assert is_char_boundary("é", 0);
  assert !is_char_boundary("é", 1);
  assert is_char_boundary("é", 2);
  assert !is_char_boundary("é", -1);
  assert !is_char_boundary("é", 3);
  assert is_char_boundary("", 0);
  assert is_char_boundary("abc", 1);
  assert !is_char_boundary("😀", 1);
  assert !is_char_boundary("😀", 2);
  assert !is_char_boundary("😀", 3);
  assert is_char_boundary("😀", 4);
  assert is_char_boundary("안a", 3);
  return 0;
}
