// G9 A1 reject: the cursor jumps i + 2, which can exceed len(a) and violate the callee's requires i <= len(a) (call_requires)
fn find_from(a: [i64], i: i64, x: i64) -> bool
  requires 0 <= i && i <= len(a)
  decreases len(a) - i
{
  if i == len(a) { return false; }
  if a[i] == x { return true; }
  return find_from(a, i + 2, x);
}
