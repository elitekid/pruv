// Source finding: bench/g8/results/mutants.json m023 (premature_sum).
mod std;
pub fn sum_i64(a: [i64]) -> i64
  requires len(a) <= 1_000_000
  requires forall k in 0..len(a): -1_000_000_000 <= a[k] && a[k] <= 1_000_000_000
  ensures result == sum(k in 0..len(a): a[k])
{
  let mut i: i64 = 0;
  let mut s: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant s == sum(k in 0..i: a[k])
    invariant -1_000_000_000 * i <= s && s <= 1_000_000_000 * i
    decreases len(a) - i
  {
    return s;
    i = i + 1;
  }
  return s;
}
