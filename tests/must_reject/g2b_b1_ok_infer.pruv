// unsupported_type(codegen, --infer): 불변식 없는 str 루프를 --infer 가 0 <= i && i <= len(s) 로 증명하고 생성 층이 거부한다 (플래그 없이는 index_oob 로 실패함을 감사에서 확인)
fn last_byte(s: str) -> i64 {
  let mut i: i64 = 0;
  let mut last: i64 = 0;
  while i < len(s)
    decreases len(s) - i
  {
    last = s[i];
    i = i + 1;
  }
  return last;
}
