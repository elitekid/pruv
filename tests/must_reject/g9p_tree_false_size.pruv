// G9 A1 reject: the Node arm forgets the right subtree, so result == size(t) is false (ensures); termination and requires hold
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn node_total(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result == size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 1; }
    Tree::Node(v, l, r) => { return 1 + node_total(l); }
  }
}
