// unsupported_type(verify): 앞단은 통과하는 정상 str 프로그램(리터럴·len·색인·copy·substr·is_char_boundary·str 반환)이 증명 층에서 거부된다
fn pick(s: str, i: i64) -> str ! alloc
  requires 0 <= i && i <= len(s)
  requires is_char_boundary(s, i)
{
  let a: str = "hello";
  let c: str = copy(s);
  let d: str = substr(c, 0, i);
  let n: i64 = len(a) + len(d);
  if n > 0 && len(s) > 0 && is_char_boundary(s, 0) {
    let b: i64 = s[0];
    assert b >= 0 || b < 0;
  }
  return d;
}
