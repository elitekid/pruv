// G7 A1 reject: old/current confusion: after the group a[0] is the incremented value, not the entry value
fn inc(inout a: [i64]) -> ()
  requires len(a) > 0 && a[0] < 1000
  ensures len(a) == len(old(a))
  ensures a[0] == old(a)[0] + 1
  ensures forall k in 1..len(a): a[k] == old(a)[k]
{
  a[0] = a[0] + 1;
}

fn demo() -> () ! alloc {
  let mut a: [i64] = alloc(2, 5);
  let mut b: [i64] = alloc(2, 40);
  par {
    inc(inout a);
    inc(inout b);
  }
  assert a[0] == 5;
}
