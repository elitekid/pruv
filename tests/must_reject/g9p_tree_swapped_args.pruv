// G9 A1 reject: the call walk(b, a) swaps the trees, so size(b) is not known to be below size(a) (recursive_decrease)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn walk(a: Tree, b: Tree) -> i64
  decreases size(a)
{
  match a {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => { return walk(b, a); }
  }
}
