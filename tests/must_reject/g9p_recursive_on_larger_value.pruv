// G9 A1 reject: the function recurses on a value it just made larger (Node wraps t), so size grows by 2 (recursive_decrease)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn grow(t: Tree) -> i64 ! alloc
  decreases size(t)
{
  let bigger: Tree = Tree::Node(0, t, Tree::Empty);
  return grow(bigger);
}
