// type/recursive_borrow: assigning to the root of a match scrutinee while a payload view is live
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn f() -> i64 ! alloc {
  let mut t: Tree = Tree::Empty;
  match t {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => {
      t = Tree::Empty;
      return v;
    }
  }
}
