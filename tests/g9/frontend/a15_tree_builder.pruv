// G9 A0 accept: builders with the alloc effect; fresh call results move, named locals are cloned into constructors
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn leaf(v: i64) -> Tree ! alloc {
  return Tree::Node(v, Tree::Empty, Tree::Empty);
}

fn pair(a: i64, b: i64) -> Tree ! alloc {
  let l: Tree = leaf(a);
  let r: Tree = leaf(b);
  return Tree::Node(0, l, r);
}
