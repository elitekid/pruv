// G9 A0 accept: size() of a struct that contains a recursive enum; a field of extended type read as a view
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }
struct Doc { root: Tree, version: i64 }

fn doc_version(d: Doc) -> i64
  requires size(d) >= 1 && size(d.root) >= 1
  ensures result == d.version
{
  return d.version;
}
