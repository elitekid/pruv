// G9 A1 proof: two-function SCC with differing phase measures (2n+1 versus 2n); both always return 0
fn ping(n: i64) -> i64
  requires n >= 0
  ensures result == 0
  decreases 2 * n + 1
{
  if n == 0 { return 0; }
  return pong(n);
}

fn pong(n: i64) -> i64
  requires n >= 1
  ensures result == 0
  decreases 2 * n
{
  return ping(n - 1);
}
