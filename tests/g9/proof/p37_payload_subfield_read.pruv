// G9 A2 audit fix: a subfield of a non-extended payload inside an extended type is read from the original reference, and
// the whole-payload comparison is charged to the contract budget
struct Leaf { v: i64 }
struct P { a: Leaf, b: Leaf }
enum T { End, Node(p: P, next: T) }

fn f(t: T) -> i64
  requires is_variant(t, T::Node) ==> variant_field(t, T::Node, p) == variant_field(t, T::Node, p)
  requires is_variant(t, T::Node) ==> variant_field(t, T::Node, p).a.v == variant_field(t, T::Node, p).a.v
{
  return 0;
}
