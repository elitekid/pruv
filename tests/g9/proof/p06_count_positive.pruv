// G9 A1 proof: array descent with a count aggregate postcondition and a length bound that keeps `1 + ...` inside i64
fn count_pos(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a)
  ensures result == count(k in i..len(a): a[k] > 0)
  ensures 0 <= result && result <= len(a) - i
  decreases len(a) - i
{
  if i == len(a) { return 0; }
  if a[i] > 0 { return 1 + count_pos(a, i + 1); }
  return count_pos(a, i + 1);
}
