// G9 A1 proof: array descent (decreases len(a) - i) with an aggregate postcondition: result is the suffix sum, bounded by 1000 per element
fn sum_from(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a)
  requires forall k in 0..len(a): 0 <= a[k] && a[k] <= 1000
  ensures result == sum(k in i..len(a): a[k])
  ensures 0 <= result && result <= 1000 * (len(a) - i)
  decreases len(a) - i
{
  if i == len(a) { return 0; }
  return a[i] + sum_from(a, i + 1);
}
