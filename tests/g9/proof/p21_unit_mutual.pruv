// G9 A1 proof: mutually recursive unit functions with phase measures (2n+1 versus 2n) and ensures assumed after each call
fn ping_u(n: i64) -> ()
  requires n >= 0
  ensures n >= 0
  decreases 2 * n + 1
{
  if n > 0 {
    pong_u(n);
  }
}

fn pong_u(n: i64) -> ()
  requires n >= 1
  ensures n >= 1
  decreases 2 * n
{
  ping_u(n - 1);
}
