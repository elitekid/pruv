// G9 A1 proof: a scalar measure over two parameters (a + b) with two recursive calls on different branches; result is 0
fn drain(a: i64, b: i64) -> i64
  requires a >= 0 && b >= 0
  ensures result == 0
  decreases a + b
{
  if a > 0 { return drain(a - 1, b); }
  if b > 0 { return drain(a, b - 1); }
  return 0;
}
