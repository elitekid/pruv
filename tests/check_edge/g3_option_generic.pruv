// G3 A1 accepted: Option<T> generalized; Some::<T>, None::<T>; Option<i64> from substitution is the legacy type
fn some_or<T>(o: Option<T>, d: T) -> T {
  match o {
    Some(v) => { return v; }
    None => { return d; }
  }
}

fn wrap<T>(x: T) -> Option<T>
  ensures is_some(result)
{
  return Some::<T>(x);
}

fn flags() -> Option<bool> {
  let a: Option<bool> = Some::<bool>(true);
  let b: Option<bool> = None::<bool>;
  match a {
    Some(v) => { return Some::<bool>(v); }
    None => { return b; }
  }
}

fn legacy_use(o: Option<i64>) -> i64 {
  return some_or::<i64>(o, 0);
}
