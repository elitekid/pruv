// G3 A1 accepted: generic-to-generic calls map the callee's parameters to the caller's type expressions
fn wrap<T>(x: T) -> Option<T> {
  return Some::<T>(x);
}

fn id<T>(x: T) -> T {
  return x;
}

fn wrap_twice<T>(x: T) -> Option<Option<T>> {
  let inner: Option<T> = wrap::<T>(x);
  return Some::<Option<T>>(inner);
}

fn forward<U>(x: U) -> Option<U> {
  return wrap::<U>(id::<U>(x));
}

fn via_option<T>(x: T) -> Option<T> {
  return id::<Option<T>>(wrap::<T>(x));
}
