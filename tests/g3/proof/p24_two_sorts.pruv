// G3 A2 positive: two parameters of one function are two independent sorts (no cross-parameter equality);
// a mutable local of an abstract type and a branch
struct Pair<A, B> {
  first: A,
  second: B
}

fn pick_by<A, B>(flag: bool, a: A, a2: A, b: B) -> Pair<A, B>
  ensures flag ==> result.first == a
  ensures !flag ==> result.first == a2
  ensures result.second == b
{
  let mut chosen: A = a2;
  if flag {
    chosen = a;
  }
  return Pair::<A, B> { first: chosen, second: b };
}
