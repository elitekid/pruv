// G3 A2 positive: generic-to-generic calls map the callee's parameters to the caller's type expressions,
// including a callee instantiated at the caller's own Option<T>
fn wrap<T>(x: T) -> Option<T>
  ensures is_some(result) && some_val(result) == x
{
  return Some::<T>(x);
}

fn id<T>(x: T) -> T
  ensures result == x
{
  return x;
}

fn forward<U>(x: U) -> Option<U>
  ensures is_some(result) && some_val(result) == x
{
  return wrap::<U>(id::<U>(x));
}

fn via_option<T>(x: T) -> Option<T>
  ensures is_some(result) && some_val(result) == x
{
  return id::<Option<T>>(wrap::<T>(x));
}

fn wrap_twice<T>(x: T) -> Option<Option<T>>
  ensures is_some(result) && is_some(some_val(result)) && some_val(some_val(result)) == x
{
  let inner: Option<T> = wrap::<T>(x);
  return Some::<Option<T>>(inner);
}
