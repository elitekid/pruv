// G3 A2 positive: instantiating a [T] result at bool: the caller's fresh result is a concrete [bool]
fn repeat<T: Element>(n: i64, value: T) -> [T] ! alloc
  requires 0 <= n && n <= 1000
  ensures len(result) == n
  ensures forall k in 0..n: result[k] == value
{
  let out: [T] = alloc(n, value);
  return out;
}

fn trues(n: i64) -> [bool] ! alloc
  requires 0 <= n && n <= 10
  ensures len(result) == n
  ensures forall k in 0..n: result[k]
{
  let out: [bool] = repeat::<bool>(n, true);
  return out;
}
