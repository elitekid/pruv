// G3 A2 positive: a phantom type parameter; Tag<A> and Tag<B> are distinct datatypes with the same concrete field
struct Tag<T> {
  id: i64
}

fn retag<A, B>(t: Tag<A>) -> Tag<B>
  ensures result.id == t.id
{
  return Tag::<B> { id: t.id };
}

fn make<T>(id: i64) -> Tag<T>
  ensures result.id == id
{
  return Tag::<T> { id: id };
}
