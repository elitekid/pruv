// query budget: six conditional counters give 21 candidates whose exploration needs more than 512 queries, so the
// function's automatic candidates are all dropped (budget_exhausted) and the final verification runs without them.
fn many(a: [i64]) -> i64
  requires len(a) <= 100
{
  let mut c1: i64 = 0;
  let mut c2: i64 = 0;
  let mut c3: i64 = 0;
  let mut c4: i64 = 0;
  let mut c5: i64 = 0;
  let mut c6: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    decreases len(a) - i
  {
    if a[i] > 1 { c1 = c1 + 1; }
    if a[i] > 2 { c2 = c2 + 1; }
    if a[i] > 3 { c3 = c3 + 1; }
    if a[i] > 4 { c4 = c4 + 1; }
    if a[i] > 5 { c5 = c5 + 1; }
    if a[i] > 6 { c6 = c6 + 1; }
    i = i + 1;
  }
  return 0;
}
