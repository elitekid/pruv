fn max_of(a: [i64]) -> i64
  requires len(a) <= 1_000_000
  ensures len(a) > 0 ==> result == max(k in 0..len(a): a[k])
{
  if len(a) == 0 {
    return 0;
  }
  let mut m: i64 = a[0];
  let mut i: i64 = 1;
  while i < len(a)
    decreases len(a) - i
  {
    if a[i] > m {
      m = a[i];
    }
    i = i + 1;
  }
  return m;
}
