// nested loops share one candidate set per round: the inner loop stores into b, so its havoc renews len(b) and
// there is no inner length candidate (b is not initialized in the outer body). The outer candidate `len(b) == n`
// therefore fails preservation and is dropped, and the outer store b[0] = 50 / the final b[0] cannot be proved in
// bounds: an outer proof must not survive on a fact the inner loop destroyed.
fn nested_range(a: [i64], n: i64) -> i64 ! alloc
  requires len(a) <= 100 && 1 <= n && n <= 100
  requires forall k in 0..len(a): a[k] >= 0 && a[k] <= 10
  ensures result <= 10
{
  let mut b: [i64] = alloc(n, 0);
  let mut i: i64 = 0;
  while i < n
    decreases n - i
  {
    let mut j: i64 = 0;
    while j < len(b)
      decreases len(b) - j
    {
      b[j] = b[j];
      j = j + 1;
    }
    if len(b) > 0 {
      b[0] = 50;
    }
    i = i + 1;
  }
  return b[0];
}
