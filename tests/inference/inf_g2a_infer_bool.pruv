// --infer with a [bool] and an [i64] array in one loop: bounds hold, but the final assert is false (b[3] is true), so verify rejects it with assert.
fn f() -> i64 ! alloc {
  let mut a: [i64] = alloc(4, 0);
  let mut b: [bool] = alloc(4, false);
  let mut i: i64 = 0;
  while i < 4
    invariant 0 <= i && i <= 4
    invariant len(a) == 4
    invariant len(b) == 4
    decreases 4 - i
  {
    a[i] = i;
    b[i] = i > 1;
    i = i + 1;
  }
  assert b[3] == false;
  return a[0];
}
