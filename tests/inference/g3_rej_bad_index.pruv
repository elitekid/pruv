// G3 A2 inference (rejected): the candidates `0 <= i` and `i <= n + 1` survive exploration but a[i] for i == n is out
// of bounds; the final verification of the generic definition still rejects it
fn walk<T: Element>(a: [T]) -> i64 {
  let n: i64 = len(a);
  let mut i: i64 = 0;
  while i <= n
    decreases n - i + 1
  {
    let x: T = a[i];
    i = i + 1;
  }
  return i;
}
