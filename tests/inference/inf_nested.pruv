fn rank_all(a: [i64]) -> i64
  requires len(a) <= 1000
  ensures result == len(a)
{
  let mut i: i64 = 0;
  while i < len(a)
    decreases len(a) - i
  {
    let mut c: i64 = 0;
    let mut j: i64 = 0;
    while j < len(a)
      decreases len(a) - j
    {
      if a[j] < a[i] {
        c = c + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return i;
}
