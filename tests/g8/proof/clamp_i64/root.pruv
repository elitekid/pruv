mod std;
pub fn f(x: i64) -> i64 ensures -10 <= result && result <= 10 { return crate::std::clamp_i64(x, -10, 10); }
pub fn edges() -> () { let value1: i64 = crate::std::clamp_i64(-9223372036854775808, 0, 0); assert value1 == 0; let value2: i64 = crate::std::clamp_i64(9223372036854775807, 0, 0); assert value2 == 0; }
