mod std;
pub fn f(a: [i64]) -> i64
 requires len(a) <= 1000000
 requires forall k in 0..len(a): -1000000000 <= a[k] && a[k] <= 1000000000
 ensures result == sum(k in 0..len(a): a[k]) { return crate::std::sum_i64(a); }
pub fn edges() -> () ! alloc { let empty: [i64] = alloc(0, 0); let value1: i64 = crate::std::sum_i64(empty); assert value1 == 0; let single: [i64] = alloc(1, -1000000000); let value2: i64 = crate::std::sum_i64(single); assert value2 == -1000000000; }
