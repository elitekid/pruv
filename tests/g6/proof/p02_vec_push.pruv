// G6 A1 proof: vec_push grows by one, keeps the prefix and stores the pushed value at the old length
fn two() -> Vec<i64> ! alloc
  ensures len(result) == 2
  ensures result[0] == 10 && result[1] == 20
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 10);
  v = vec_push::<i64>(move v, 20);
  return move v;
}

fn push_flag(take v: Vec<bool>, b: bool) -> Vec<bool> ! alloc
  requires len(v) < 1099511627776
  ensures len(result) == len(v) + 1
  ensures result[len(v)] == b
  ensures forall i in 0..len(v): result[i] == v[i]
{
  return vec_push::<bool>(move v, b);
}
