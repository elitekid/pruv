// G6 A1 proof: vec_get under 0 <= i < len returns the element, matching the contract-only v[i]
fn sum_two(v: Vec<i64>) -> i64
  requires len(v) >= 2
  requires 0 <= v[0] && v[0] <= 1000
  requires 0 <= v[1] && v[1] <= 1000
  ensures result == v[0] + v[1]
{
  return vec_get::<i64>(v, 0) + vec_get::<i64>(v, 1);
}

fn built_second() -> i64 ! alloc
  ensures result == 20
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 10);
  v = vec_push::<i64>(move v, 20);
  return vec_get::<i64>(v, 1);
}

fn last_of(v: Vec<bool>) -> bool
  requires len(v) > 0
  ensures result == v[len(v) - 1]
{
  return vec_get::<bool>(v, len(v) - 1);
}
