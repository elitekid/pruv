// G6 A1 proof: map_new yields an empty map (len == 0, every lookup is None) for i64 and bool keys
fn fresh() -> HashMap<i64, i64> ! alloc
  ensures len(result) == 0
  ensures !is_some(map_lookup::<i64, i64>(result, 5))
{
  return map_new::<i64, i64>();
}

fn fresh_bool() -> HashMap<bool, bool> ! alloc
  ensures len(result) == 0
  ensures !is_some(map_lookup::<bool, bool>(result, true))
{
  let m: HashMap<bool, bool> = map_new::<bool, bool>();
  return move m;
}

fn missing_in_fresh() -> i64 ! alloc
  ensures result == -1
{
  let m: HashMap<i64, i64> = map_new::<i64, i64>();
  let found: Option<i64> = map_get::<i64, i64>(m, 42);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}
