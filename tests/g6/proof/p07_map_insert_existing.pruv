// G6 A1 proof: map_insert on an existing key keeps the size and replaces the value (no growth precondition needed there)
fn overwrite() -> HashMap<i64, i64> ! alloc
  ensures len(result) == 1
  ensures is_some(map_lookup::<i64, i64>(result, 3)) && some_val(map_lookup::<i64, i64>(result, 3)) == 8
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  m = map_insert::<i64, i64>(move m, 3, 8);
  return move m;
}

fn reinsert_present(take m: HashMap<i64, i64>, k: i64) -> HashMap<i64, i64> ! alloc
  requires is_some(map_lookup::<i64, i64>(m, k))
  ensures len(result) == len(m)
{
  return map_insert::<i64, i64>(move m, k, 0);
}
