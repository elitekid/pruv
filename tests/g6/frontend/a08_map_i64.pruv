// G6 A0 accept: HashMap<i64, i64> with map_new / map_insert / map_get; the Option result is matched
fn lookup_seven() -> i64 ! alloc
  ensures result == 7
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  let found: Option<i64> = map_get::<i64, i64>(m, 3);
  match found {
    Some(x) => { return x; }
    None => { return 0; }
  }
}

fn lookup_missing() -> i64 ! alloc
  ensures result == -1
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  let found: Option<i64> = map_get::<i64, i64>(m, 4);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}
