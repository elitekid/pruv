pub fn write(path: str, text: str, data: [u8]) -> bool ! fs {
  let f: File = file_create(path);
  if !file_writable(f) { return false; }
  let g: File = file_write_str(move f, text);
  if !file_writable(g) { return false; }
  let h: File = file_write_bytes(move g, data);
  return file_close(move h);
}
