// G7 A1 proof: a legacy unit branch without inout is part of the group; its ensures is applied too
fn note(a: [i64]) -> ()
  requires len(a) > 0
  ensures len(a) > 0
{
  let n: i64 = len(a);
}

fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo(q: [i64], inout p: [i64]) -> ()
  requires len(q) > 0 && len(p) > 0
  ensures p[0] == 3
{
  par {
    note(q);
    set_at(inout p, 0, 3);
  }
  assert len(q) > 0;
}
