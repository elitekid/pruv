// G7 A1 proof: groups in both arms of an if; the facts of both arms hold after the join
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn pick(x: i64, inout p: [i64], inout q: [i64]) -> ()
  requires len(p) > 0 && len(q) > 0
  ensures p[0] >= 1 && q[0] >= 2
{
  if x > 0 {
    par {
      set_at(inout p, 0, 1);
      set_at(inout q, 0, 2);
    }
  } else {
    par {
      set_at(inout p, 0, 3);
      set_at(inout q, 0, 4);
    }
  }
}
