// G7 A1 proof: a group repeated in a loop body; inout parameters keep their length across the loop
fn bump(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == 1
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = 1;
}

fn run(inout a: [i64], inout b: [i64], n: i64) -> ()
  requires 0 <= n && n <= len(a) && n <= len(b)
  ensures len(a) == len(old(a)) && len(b) == len(old(b))
{
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    decreases n - i
  {
    par {
      bump(inout a, i);
      bump(inout b, i);
    }
    i = i + 1;
  }
}
