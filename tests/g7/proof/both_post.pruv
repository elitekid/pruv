// G7 A1 proof: both branch postconditions are usable after the join
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo() -> i64 ! alloc {
  let mut p: [i64] = alloc(3, 0);
  let mut q: [i64] = alloc(3, 0);
  par {
    set_at(inout p, 1, 7);
    set_at(inout q, 2, 9);
  }
  assert p[1] == 7 && q[2] == 9;
  return p[1] + q[2];
}
