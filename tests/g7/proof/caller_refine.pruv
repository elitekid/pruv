// G7 A1 proof: a refined local passed inout keeps its refinement after the join (7 is within 0..=9)
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo() -> () ! alloc {
  let mut buf: [i64 | 0..=9; <=8] = alloc(4, 0);
  let mut other: [i64] = alloc(4, 0);
  par {
    set_at(inout buf, 1, 7);
    set_at(inout other, 2, 100);
  }
  assert buf[1] == 7 && other[2] == 100;
}
