// G7 A1 proof: exact frames of two forwarded inout parameters are visible after the join
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn both(inout p: [i64], inout q: [i64]) -> ()
  requires len(p) >= 3 && len(q) >= 3
  ensures len(p) == len(old(p)) && len(q) == len(old(q))
  ensures p[0] == 1 && q[1] == 2
  ensures p[2] == old(p)[2] && q[2] == old(q)[2]
{
  par {
    set_at(inout p, 0, 1);
    set_at(inout q, 1, 2);
  }
}
