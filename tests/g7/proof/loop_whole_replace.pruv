// G7 A1 proof: in a loop, a local replaced by a whole assignment loses its length fact, a local only written by the
// group keeps it
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo(n: i64) -> () ! alloc
  requires n >= 0
{
  let mut a: [i64] = alloc(4, 0);
  let mut b: [i64] = alloc(4, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    decreases n - i
  {
    a = alloc(4, i);
    par {
      set_at(inout a, 0, 1);
      set_at(inout b, 0, 2);
    }
    i = i + 1;
  }
  assert len(b) == 4;
}
