// G7 A1 proof: every branch requires holds against the group-entry state (read-only unit helpers with valid ensures)
fn pos(x: i64) -> ()
  requires x > 0
  ensures x > 0
{
  let n: i64 = x;
}

fn need(x: i64) -> ()
  requires x > 0
{
  let n: i64 = x;
}

fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn demo(x: i64, inout p: [i64]) -> ()
  requires x > 0 && len(p) == 5
  ensures p[4] == 1
{
  par {
    pos(x);
    need(x);
    set_at(inout p, 4, 1);
  }
}
