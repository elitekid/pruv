// G3 A4 ABI 4/10: every new Result<X> branch (X != i64): W = 1 + W(X) + 1; tag 1 = Ok, 0 = Err; the error
// word is the last word; the inactive words are zero.
struct Point {
  x: i64,
  y: i64,
}

fn res_bool(r: Result<bool>) -> Result<bool>
{
  return r;
}

fn ok_bool(b: bool) -> Result<bool>
{
  return Ok::<bool>(b);
}

fn err_bool(c: i64) -> Result<bool>
{
  return Err::<bool>(c);
}

fn code_of(r: Result<bool>) -> i64
{
  match r {
    Ok(v) => { return 0; }
    Err(c) => { return c; }
  }
}

fn res_point(r: Result<Point>) -> Result<Point>
{
  return r;
}
