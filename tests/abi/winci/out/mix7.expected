mix(1, Some(9), 2, 3, 4) = Ok(9)
mix(1, None, 2, 3, 4) = Err(10)
mix(-1000000, Some(i64::MIN), -1000000, -1000000, -1000000) = Ok(-9223372036854775808)
mix(1000000, Some(i64::MAX), 1000000, 1000000, 1000000) = Ok(9223372036854775807)
mix(1000000, None, 1000000, 1000000, 1000000) = Err(4000000)
mix(-1000000, None, -1000000, -1000000, -1000000) = Err(-4000000)
repeat mix n=100000 sum=7753183853155891174
