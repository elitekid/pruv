// flags: default | --no-verify
// expect: run
struct Point {
  x: i64,
  y: i64,
}

enum Event {
  Empty,
  Hit(point: Point, accepted: bool),
  Failed(code: i64),
}

fn make_hit(x: i64, y: i64, ok: bool) -> Event
  ensures is_variant(result, Event::Hit)
  ensures variant_field(result, Event::Hit, accepted) == ok
{
  return Event::Hit(Point { x: x, y: y }, ok);
}

fn score(e: Event) -> i64
  requires is_variant(e, Event::Failed) ==> (variant_field(e, Event::Failed, code) >= 0 && variant_field(e, Event::Failed, code) <= 1_000)
  ensures result >= 0 || is_variant(e, Event::Hit)
{
  match e {
    Event::Empty => { return 0; }
    Event::Hit(p, accepted) => {
      if accepted {
        return 1;
      }
      return -1;
    }
    Event::Failed(code) => { return code; }
  }
}

fn main() -> () ! io {
  let a: Event = Event::Empty;
  let b: Event = make_hit(1, 2, true);
  let c: Event = Event::Failed(999);
  let d: Event = make_hit(0, 0, false);
  print(score(a));
  print(score(b));
  print(score(c));
  print(score(d));
  match b {
    Event::Empty => { print(100); }
    Event::Hit(p, ok) => { print(p.x); print(p.y); print(ok); }
    Event::Failed(code) => { print(200); }
  }
}
