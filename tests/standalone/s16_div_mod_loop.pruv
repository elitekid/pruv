// flags: default | --no-verify
// expect: run
fn main() -> () ! io {
  let a: i64 = 17;
  let b: i64 = 5;
  print(a / b);
  print(a % b);
  print(0 / 3);
  let mut i: i64 = 1;
  while i <= 20
    invariant 1 <= i && i <= 21
    decreases 21 - i
  {
    if i % 3 == 0 {
      print(i / 3);
    } else {
      print(0 - i);
    }
    i = i + 1;
  }
}
