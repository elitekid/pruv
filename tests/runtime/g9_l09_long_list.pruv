// G9 A3 runtime (LLVM layout/cleanup): a 1000-element linked list built recursively, cloned and scored, to stress the
// recursive clone/drop helpers (recursion depth 1000)
// build(n) = Cons(n, build(n-1)): heads 1000, 999, ..., 1; size n + 1
// score(l, lim): 2 per head >= lim, else 1
// lim 500: heads 500..1000 (501 of them) -> 2*501 + 499 = 1501; lim 1000: 2 + 999 = 1001; length = 1000
// expected stdout: list_score(500) = 1501, clone_score(1000) = 1001, list_len() = 1000
enum List { Nil, Cons(head: i64, tail: List) }

fn build(n: i64) -> List ! alloc
  requires n >= 0 && n <= 2000
  ensures size(result) == n + 1
  decreases n
{
  if n == 0 { return List::Nil; }
  return List::Cons(n, build(n - 1));
}

fn score(l: List, lim: i64) -> i64
  requires size(l) <= 5000
  ensures result >= 0 && result <= 2 * size(l)
  decreases size(l)
{
  match l {
    List::Nil => { return 0; }
    List::Cons(h, t) => {
      if h >= lim { return 2 + score(t, lim); }
      return 1 + score(t, lim);
    }
  }
}

fn length(l: List) -> i64
  requires size(l) <= 5000
  ensures result >= 0 && result <= size(l)
  decreases size(l)
{
  match l {
    List::Nil => { return 0; }
    List::Cons(h, t) => { return 1 + length(t); }
  }
}

fn list_score(lim: i64) -> i64 ! alloc {
  let l: List = build(1000);
  return score(l, lim);
}

fn clone_score(lim: i64) -> i64 ! alloc {
  let l: List = build(1000);
  let c: List = l;
  return score(c, lim);
}

fn list_len() -> i64 ! alloc {
  let l: List = build(1000);
  let c: List = l;
  return length(c);
}
