// substr(fs(), lo(), hi()) evaluates its arguments left to right (prints 1 2 3), then cuts bytes 1..3 of "héllo" (= é, length 2).
fn fs() -> str ! io, alloc
  ensures len(result) == 6
  ensures is_char_boundary(result, 1)
  ensures is_char_boundary(result, 3)
{
  print(1);
  return "héllo";
}

fn lo() -> i64 ! io
  ensures result == 1
{
  print(2);
  return 1;
}

fn hi() -> i64 ! io
  ensures result == 3
{
  print(3);
  return 3;
}

fn f() -> i64 ! io, alloc {
  let t: str = substr(fs(), lo(), hi());
  return len(t);
}
