// G3 A5 runtime: a failed requires reached through a public entry that calls a generic function. The entries
// at_int / at_bool check their own requires with the bad input before the specialization is entered.
fn at<T: Element>(a: [T], i: i64) -> T
  requires 0 <= i && i < len(a)
{
  return a[i];
}

fn at_int(a: [i64], i: i64) -> i64
  requires 0 <= i && i < len(a)
{
  return at::<i64>(a, i);
}

fn at_bool(a: [bool], i: i64) -> bool
  requires 0 <= i && i < len(a)
{
  return at::<bool>(a, i);
}
