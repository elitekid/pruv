// G9 A2 runtime: recursion over an array index (decreases len(a) - i): suffix sum, positive count and linear search; arrays come from the host
fn sum_from(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a)
  requires forall k in 0..len(a): 0 <= a[k] && a[k] <= 1000
  ensures result == sum(k in i..len(a): a[k])
  ensures 0 <= result && result <= 1000 * (len(a) - i)
  decreases len(a) - i
{
  if i == len(a) { return 0; }
  return a[i] + sum_from(a, i + 1);
}

fn count_pos(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a)
  ensures result == count(k in i..len(a): a[k] > 0)
  ensures 0 <= result && result <= len(a) - i
  decreases len(a) - i
{
  if i == len(a) { return 0; }
  if a[i] > 0 { return 1 + count_pos(a, i + 1); }
  return count_pos(a, i + 1);
}

fn find_from(a: [i64], i: i64, x: i64) -> bool
  requires 0 <= i && i <= len(a)
  ensures !result ==> forall k in i..len(a): a[k] != x
  ensures result ==> exists k in i..len(a): a[k] == x
  decreases len(a) - i
{
  if i == len(a) { return false; }
  if a[i] == x { return true; }
  return find_from(a, i + 1, x);
}
