// a [u8] variable is reassigned inside a loop and the function returns early from the loop.

fn f(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 10
{
  let mut b: [u8] = alloc(1, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant len(b) >= 1
    decreases n - i
  {
    b = alloc(i + 1, 5);
    if i == 3 {
      return len(b);
    }
    i = i + 1;
  }
  return len(b);
}
