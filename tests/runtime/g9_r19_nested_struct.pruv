// G9 A2 runtime: a struct holding a struct with a [u8] field; the outer clone gets a new inner struct while the original keeps its bytes
// data is [4, 6, 4]; the clone's data becomes [4, 9, 4]
struct Inner { data: [u8] }
struct Outer { inner: Inner, tag: i64 }

fn make_outer() -> Outer ! alloc
  ensures len(result.inner.data) == 3 && result.tag == 1
{
  let mut raw: [u8] = alloc(3, 4);
  raw[1] = 6;
  let i: Inner = Inner { data: copy(raw) };
  return Outer { inner: i, tag: 1 };
}

fn reseat(o: Outer) -> Outer ! alloc
  requires len(o.inner.data) >= 2
  ensures len(result.inner.data) == len(o.inner.data)
{
  let mut o2: Outer = o;
  let mut d: [u8] = copy(o2.inner.data);
  d[1] = 9;
  o2.inner = Inner { data: copy(d) };
  return o2;
}

fn orig_second() -> i64 ! alloc {
  let o: Outer = make_outer();
  let n: Outer = reseat(o);
  return o.inner.data[1];
}

fn new_second() -> i64 ! alloc {
  let o: Outer = make_outer();
  let n: Outer = reseat(o);
  return n.inner.data[1];
}

fn new_first() -> i64 ! alloc {
  let o: Outer = make_outer();
  let n: Outer = reseat(o);
  return n.inner.data[0];
}

fn new_tag() -> i64 ! alloc {
  let o: Outer = make_outer();
  let n: Outer = reseat(o);
  return n.tag;
}
