// G6 A2 runtime: HashMap<bool, i64> and HashMap<bool, bool>; the true key is replaced, the false key kept
fn bool_lookup(b: bool) -> i64 ! alloc
  ensures b == true ==> result == 3
  ensures b == false ==> result == 2
{
  let mut m: HashMap<bool, i64> = map_new::<bool, i64>();
  m = map_insert::<bool, i64>(move m, true, 1);
  m = map_insert::<bool, i64>(move m, false, 2);
  m = map_insert::<bool, i64>(move m, true, 3);
  let found: Option<i64> = map_get::<bool, i64>(m, b);
  match found {
    Some(x) => { return x; }
    None => { return 0; }
  }
}

fn bool_size() -> i64 ! alloc
  ensures result == 2
{
  let mut m: HashMap<bool, i64> = map_new::<bool, i64>();
  m = map_insert::<bool, i64>(move m, true, 1);
  m = map_insert::<bool, i64>(move m, false, 2);
  m = map_insert::<bool, i64>(move m, true, 3);
  return len(m);
}

fn flag_roundtrip(k: bool, v: bool) -> bool ! alloc
  ensures result == v
{
  let mut m: HashMap<bool, bool> = map_new::<bool, bool>();
  m = map_insert::<bool, bool>(move m, k, v);
  let found: Option<bool> = map_get::<bool, bool>(m, k);
  match found {
    Some(x) => { return x; }
    None => { return v; }
  }
}
