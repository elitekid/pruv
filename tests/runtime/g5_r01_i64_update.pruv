// G5 A2 runtime: an in-place i64 store through an inout parameter (borrowed &mut [i64], no copy of the borrowed array).
// The host enters through the ordinary wrapper `update`, which owns a copy and returns it.
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

pub fn update(a: [i64], i: i64, v: i64) -> [i64] ! alloc
  requires 0 <= i && i < len(a)
{
  let mut w: [i64] = copy(a);
  set_at(inout w, i, v);
  return w;
}
