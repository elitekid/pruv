// G9 A2 runtime: early returns inside recursion: a tree search that stops on the first value above a limit, and a three-function cycle
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn sample() -> Tree ! alloc
  ensures size(result) == 9
{
  return Tree::Node(4, Tree::Node(2, Tree::Empty, Tree::Empty), Tree::Node(7, Tree::Node(5, Tree::Empty, Tree::Empty), Tree::Empty));
}

fn any_over(t: Tree, limit: i64) -> bool
  ensures is_variant(t, Tree::Empty) ==> !result
  decreases size(t)
{
  match t {
    Tree::Empty => { return false; }
    Tree::Node(v, l, r) => {
      if v > limit { return true; }
      if any_over(l, limit) { return true; }
      return any_over(r, limit);
    }
  }
}

fn first_over(t: Tree, limit: i64) -> i64
  decreases size(t)
{
  match t {
    Tree::Empty => { return 0 - 1; }
    Tree::Node(v, l, r) => {
      if v > limit { return v; }
      let fl: i64 = first_over(l, limit);
      if fl >= 0 { return fl; }
      return first_over(r, limit);
    }
  }
}

fn base() -> i64
  ensures result == 0
{
  return 0;
}

fn fa(n: i64) -> i64
  requires n >= 0
  ensures result >= 0 && result <= 2
  decreases n
{
  if n == 0 { return base(); }
  return fb(n - 1);
}

fn fb(n: i64) -> i64
  requires n >= 0
  ensures result >= 0 && result <= 2
  decreases n
{
  if n == 0 { return 1; }
  return fc(n - 1);
}

fn fc(n: i64) -> i64
  requires n >= 0
  ensures result >= 0 && result <= 2
  decreases n
{
  if n == 0 { return 2; }
  return fa(n - 1);
}

fn sample_any_over(limit: i64) -> bool ! alloc {
  return any_over(sample(), limit);
}

fn sample_first_over(limit: i64) -> i64 ! alloc {
  return first_over(sample(), limit);
}
