// G5 A2 runtime: early returns from a function with an inout parameter; the untouched paths leave the array as it was
fn put_if_room(inout a: [i64], i: i64, v: i64) -> bool
  ensures len(a) == len(old(a))
  ensures result ==> (0 <= i && i < len(a) && a[i] == v)
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  if i < 0 {
    return false;
  }
  if i >= len(a) {
    return false;
  }
  a[i] = v;
  return true;
}

pub fn try_put(a: [i64], i: i64, v: i64) -> [i64] ! alloc {
  let mut w: [i64] = copy(a);
  let ok: bool = put_if_room(inout w, i, v);
  return w;
}

pub fn try_put_ok(a: [i64], i: i64, v: i64) -> bool ! alloc {
  let mut w: [i64] = copy(a);
  let ok: bool = put_if_room(inout w, i, v);
  return ok;
}
