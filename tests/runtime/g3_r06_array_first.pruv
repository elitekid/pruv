// G3 A3 runtime: [T] with T: Element specializes to the existing [i64] / [bool] code; borrowed parameters
fn first<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn first_int(a: [i64]) -> i64
  requires len(a) > 0
  ensures result == a[0]
{
  return first::<i64>(a);
}

fn first_bool(a: [bool]) -> bool
  requires len(a) > 0
  ensures result == a[0]
{
  return first::<bool>(a);
}
