// G3 A3 runtime: match on Option<T>; Option<i64> keeps its legacy lowering, Option<bool> is new
fn get_or<T>(o: Option<T>, d: T) -> T {
  match o {
    Some(v) => { return v; }
    None => { return d; }
  }
}

fn get_or_int(o: Option<i64>, d: i64) -> i64 {
  return get_or::<i64>(o, d);
}

fn get_or_bool(o: Option<bool>, d: bool) -> bool {
  return get_or::<bool>(o, d);
}

fn wrap_bool(x: bool) -> Option<bool> {
  return Some::<bool>(x);
}

fn none_bool() -> Option<bool> {
  return None::<bool>;
}
