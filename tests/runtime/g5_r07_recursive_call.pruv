// G5 A2 runtime: direct recursion on an inout parameter; every level reborrows the same slice (&mut *a)
fn zero_from(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i <= len(a)
  ensures len(a) == len(old(a))
  ensures forall k in i..len(a): a[k] == 0
  ensures forall k in 0..i: a[k] == old(a)[k]
  decreases len(a) - i
{
  if i < len(a) {
    a[i] = 0;
    zero_from(inout a, i + 1);
  }
}

pub fn zero_tail(a: [i64], i: i64) -> [i64] ! alloc
  requires 0 <= i && i <= len(a)
{
  let mut w: [i64] = copy(a);
  zero_from(inout w, i);
  return w;
}
