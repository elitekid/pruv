// G6 A2 runtime: vec_new / vec_push / vec_get / len on a Vec<i64> built from literals; the index is a public parameter
fn pick(i: i64) -> i64 ! alloc
  requires 0 <= i && i < 3
  ensures result == 10 + i
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 10);
  v = vec_push::<i64>(move v, 11);
  v = vec_push::<i64>(move v, 12);
  return vec_get::<i64>(v, i);
}

fn count() -> i64 ! alloc
  ensures result == 3
{
  let mut v: Vec<i64> = vec_new::<i64>();
  v = vec_push::<i64>(move v, 10);
  v = vec_push::<i64>(move v, 11);
  v = vec_push::<i64>(move v, 12);
  return len(v);
}
