{
  "flags_matrix": [
    [],
    [
      "--no-verify"
    ],
    [
      "--no-verify",
      "--trust-callers"
    ]
  ],
  "exit": 101,
  "gen_contains": [
    "spawn_scoped",
    "std::thread::scope",
    "move ||"
  ],
  "gen_absent": [
    ".clone()"
  ],
  "g7_hook": "spawn",
  "g7_joined": 1,
  "stderr_contains": "pruv: parallel spawn failed",
  "stdout_lines": [],
  "ll_contains": [
    "%pruv_g7_job = type { ptr, ptr }",
    "declare void @pruv_g7_v1_run(ptr, i64) nounwind",
    "define private void @pruv_g7_cb_"
  ],
  "ll_absent": [
    "ptr readonly %ctx",
    "ptr nocapture %ctx",
    "ptr noalias %ctx"
  ],
  "llvm_exports": [
    "pruv_abi_run",
    "pruv_abi_sequential"
  ]
}
