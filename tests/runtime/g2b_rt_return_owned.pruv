// a substr of a local str is returned (the original is freed at function end); the host reads the new bytes.
// "héllo wörld": h 0, é 1..3, l 3, l 4, o 5, ' ' 6, w 7, ö 8..10, r 10, l 11, d 12 (len 13).
fn pre() -> str ! alloc {
  let s: str = "héllo wörld";
  let t: str = substr(s, 0, 3);
  return t;
}

fn post() -> str ! alloc {
  let s: str = "héllo wörld";
  return substr(s, 7, 10);
}
