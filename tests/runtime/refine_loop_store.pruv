// stores into an element-refined local array inside a loop and a branch; the element range is only a refinement
// (no user invariant about it) and is needed after the loop by the ensures. Regression for "store value checked,
// not assumed": the loop-head invariant synthesized from the refinement must still be provable.
fn g(x: i64) -> i64
  requires 0 <= x && x <= 100
  ensures 0 <= result && result <= 9
{
  return x % 10;
}

fn f(n: i64, x: i64) -> i64 ! alloc
  requires 0 <= n && n <= 100
  requires 0 <= x && x <= 100
{
  let mut a: [i64 | 0..=9; <=100] = alloc(n, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(a) == n
    decreases n - i
  {
    if x <= 9 {
      a[i] = x;
    } else {
      a[i] = g(x);
    }
    i = i + 1;
  }
  let mut s: i64 = 0;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && len(a) == n
    invariant 0 <= s && s <= 9 * j
    decreases n - j
  {
    s = s + a[j];
    j = j + 1;
  }
  return s;
}
