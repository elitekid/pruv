// G3 A3 runtime: one generic function instantiated at i64, bool, Option<bool> and Result<bool>
fn identity<T>(x: T) -> T {
  return x;
}

fn id_int(x: i64) -> i64 {
  return identity::<i64>(x);
}

fn id_bool(x: bool) -> bool {
  return identity::<bool>(x);
}

fn id_opt(x: Option<bool>) -> Option<bool> {
  return identity::<Option<bool>>(x);
}

fn id_res(x: Result<bool>) -> Result<bool> {
  return identity::<Result<bool>>(x);
}
