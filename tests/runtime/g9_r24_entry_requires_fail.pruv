// G9 A2 runtime: a public scalar entry guards the tree builder with its own requires; the host violates it (default and --no-verify keep the check)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn chain(n: i64) -> Tree ! alloc
  requires n >= 0
  ensures size(result) == 2 * n + 1
  decreases n
{
  if n == 0 { return Tree::Empty; }
  return Tree::Node(n, chain(n - 1), Tree::Empty);
}

fn nodes(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result >= 0 && result <= size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => { return 1 + nodes(l) + nodes(r); }
  }
}

fn chain_nodes(n: i64) -> i64 ! alloc
  requires n >= 0 && n <= 100
{
  let t: Tree = chain(n);
  return nodes(t);
}
