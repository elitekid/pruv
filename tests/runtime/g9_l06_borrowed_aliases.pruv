// G9 A3 runtime (LLVM layout/cleanup): borrowed aliases; the same tree (or a subtree of it) is passed as two read arguments,
// and a child is read while its parent is still alive; nothing may be freed twice or early
// overlap(a, b) = number of positions where both trees have a Node
// sample: Node(4, Node(2), Node(7, Node(5), Empty)) has 4 nodes
// self_overlap() = overlap(t, t) = 4; right_vs_parent(t) = overlap(right child 7[5], t) = 1 + overlap(5, 2) + overlap(Empty, 7) = 2;
// with_empty() = overlap(t, Empty) = 0
// expected stdout: 4, 2, 0
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn sample() -> Tree ! alloc
  ensures size(result) == 9
{
  return Tree::Node(4, Tree::Node(2, Tree::Empty, Tree::Empty), Tree::Node(7, Tree::Node(5, Tree::Empty, Tree::Empty), Tree::Empty));
}

fn overlap(a: Tree, b: Tree) -> i64
  requires size(a) <= 1000
  ensures result >= 0 && result <= size(a)
  decreases size(a)
{
  match a {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => {
      match b {
        Tree::Empty => { return 0; }
        Tree::Node(w, bl, br) => { return 1 + overlap(l, bl) + overlap(r, br); }
      }
    }
  }
}

fn right_vs_parent(t: Tree) -> i64
  requires size(t) <= 1000
{
  match t {
    Tree::Empty => { return 0 - 1; }
    Tree::Node(v, l, r) => { return overlap(r, t); }
  }
}

fn self_overlap() -> i64 ! alloc {
  let t: Tree = sample();
  return overlap(t, t);
}

fn parent_child() -> i64 ! alloc {
  let t: Tree = sample();
  return right_vs_parent(t);
}

fn with_empty() -> i64 ! alloc {
  let t: Tree = sample();
  return overlap(t, Tree::Empty);
}
