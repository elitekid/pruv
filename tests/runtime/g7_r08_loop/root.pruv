fn set(inout a: [i64], v: i64) -> ()
 requires len(a) > 0
 ensures a[0] == v
 ensures forall k in 1..len(a): a[k] == old(a)[k]
{ a[0] = v; }
fn run() -> [i64] ! alloc {
 let mut a: [i64] = alloc(3, 0);
 let mut b: [i64] = alloc(3, 0);
 let mut i: i64 = 0;
 while i < 3 invariant 0 <= i && i <= 3 decreases 3 - i {
  par { set(inout a, i); set(inout b, i); }
  i = i + 1;
 }
 return a;
}
