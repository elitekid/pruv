// companion module of g4_r13_same_spelled_layouts (path crate::b): Point has a bool and three i64 fields
pub struct Point { on: bool, p: i64, q: i64, r: i64 }

pub fn make(x: i64) -> Point
  requires 1 <= x && x <= 100
  ensures result.on && result.p == x && result.q == 2 * x && result.r == 3 * x
{
  return Point { on: x > 0, p: x, q: 2 * x, r: 3 * x };
}

pub fn sum(p: Point) -> i64
  requires 0 <= p.p && p.p <= 1000
  requires 0 <= p.q && p.q <= 1000
  requires 0 <= p.r && p.r <= 1000
  ensures p.on ==> result == p.p + p.q + p.r
{
  if p.on {
    return p.p + p.q + p.r;
  }
  return 0;
}
