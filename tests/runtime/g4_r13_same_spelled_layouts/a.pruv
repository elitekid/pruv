// companion module of g4_r13_same_spelled_layouts (path crate::a): Point has two i64 fields
pub struct Point { x: i64, y: i64 }

pub fn make(x: i64) -> Point
  requires 1 <= x && x <= 100
  ensures result.x == x && result.y == x + 1
{
  return Point { x: x, y: x + 1 };
}

pub fn sum(p: Point) -> i64
  requires 0 <= p.x && p.x <= 1000
  requires 0 <= p.y && p.y <= 1000
  ensures result == p.x + p.y
{
  return p.x + p.y;
}
