// G5 A2 runtime: an inout parameter passed unmarked to a read-only parameter is a shared reborrow (&*a); a later
// write and a later read through the same inout parameter see the updated contents
fn first(a: [i64]) -> i64
  requires len(a) >= 1
  ensures result == a[0]
{
  return a[0];
}

fn bump_first(inout a: [i64]) -> ()
  requires len(a) >= 1 && a[0] < 1000
  ensures len(a) == len(old(a))
  ensures a[0] == old(a)[0] + 1
  ensures forall k in 1..len(a): a[k] == old(a)[k]
{
  let x: i64 = first(a);
  a[0] = x + 1;
}

fn bump_then_read(inout a: [i64]) -> i64
  requires len(a) >= 1 && a[0] < 1000
  ensures result == old(a)[0] + 1
{
  bump_first(inout a);
  return first(a);
}

pub fn bump(a: [i64]) -> [i64] ! alloc
  requires len(a) >= 1 && a[0] < 1000
{
  let mut w: [i64] = copy(a);
  bump_first(inout w);
  return w;
}

pub fn bump_value(a: [i64]) -> i64 ! alloc
  requires len(a) >= 1 && a[0] < 1000
{
  let mut w: [i64] = copy(a);
  let r: i64 = bump_then_read(inout w);
  return r;
}
