// G9 A2 runtime: scalar self-recursion (linear sum with an n <= 1000 bound, halving log2) through public scalar functions
fn sum_to(n: i64) -> i64
  requires n >= 0 && n <= 1000
  ensures result >= 0 && result <= 1000 * n
  decreases n
{
  if n == 0 { return 0; }
  return n + sum_to(n - 1);
}

fn log2(n: i64) -> i64
  requires n >= 1
  ensures result >= 0 && result < n
  decreases n
{
  if n == 1 { return 0; }
  return 1 + log2(n / 2);
}
