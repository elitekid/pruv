fn read(inout a: [i64], src: [i64], x: i64) -> ()
 requires len(a) == 1 && len(src) == 1
 ensures a[0] == src[0]
{ a[0] = src[0]; }

fn run() -> [i64] ! alloc {
let mut a: [i64] = alloc(1, 0); let mut b: [i64] = alloc(1, 0); let left: [i64] = alloc(1, 7); let right: [i64] = alloc(1, 9);
par { read(inout a, left, 0); read(inout b, right, 0); }
let mut out: [i64] = alloc(2, 0); out[0] = a[0]; out[1] = b[0]; return out;
}
fn sequential() -> [i64] ! alloc {
let mut a: [i64] = alloc(1, 0); let mut b: [i64] = alloc(1, 0); let left: [i64] = alloc(1, 7); let right: [i64] = alloc(1, 9);
read(inout a, left, 0); read(inout b, right, 0);
let mut out: [i64] = alloc(2, 0); out[0] = a[0]; out[1] = b[0]; return out;
}
