struct Boxed { values: [i64] }
fn generic<T: Element>(a: [T]) -> [T] ! alloc ensures len(result) == len(a) { return copy(a); }
fn mixed<T>(a: [i64 | 0..=728]) -> [i64 | 0..=728] ! alloc
  requires forall i in 0..len(a): forall j in i..len(a): a[i] <= a[j]
  ensures len(result) == len(a)
{ return copy(a); }
fn empty<T>() -> [i64 | 0..=255] ! alloc
  ensures len(result) == 0
{ let a: [i64 | 0..=255] = alloc(0, 7); return a; }
fn mutate(inout a: [i64 | -128..=127], sorted: [i64 | 0..=255]) -> ()
  requires len(a) == 1
  requires forall i in 0..len(sorted): forall j in i..len(sorted): sorted[i] <= sorted[j]
  ensures a[0] == 7
{ a[0] = 7; }
fn boundary(a: [i64 | 0..=255]) -> [i64 | 0..=255] ! alloc
  ensures len(result) == len(a)
{ return copy(a); }
fn run() -> () ! alloc, io {
  let mut a_u8: [i64 | 0..=255] = alloc(2, 255);
  a_u8[0] = 0;
  a_u8[1] = 255;
  print(a_u8[0]); print(a_u8[1]); print(a_u8[0] + 1);
  let mut a_i8: [i64 | -128..=127] = alloc(2, 127);
  a_i8[0] = -128;
  a_i8[1] = 127;
  print(a_i8[0]); print(a_i8[1]); print(a_i8[0] + 1);
  let mut a_u16: [i64 | 0..=65535] = alloc(2, 65535);
  a_u16[0] = 0;
  a_u16[1] = 65535;
  print(a_u16[0]); print(a_u16[1]); print(a_u16[0] + 1);
  let mut a_i16: [i64 | -32768..=32767] = alloc(2, 32767);
  a_i16[0] = -32768;
  a_i16[1] = 32767;
  print(a_i16[0]); print(a_i16[1]); print(a_i16[0] + 1);
  let mut a_u32: [i64 | 0..=4294967295] = alloc(2, 4294967295);
  a_u32[0] = 0;
  a_u32[1] = 4294967295;
  print(a_u32[0]); print(a_u32[1]); print(a_u32[0] + 1);
  let mut a_i32: [i64 | -2147483648..=2147483647] = alloc(2, 2147483647);
  a_i32[0] = -2147483648;
  a_i32[1] = 2147483647;
  print(a_i32[0]); print(a_i32[1]); print(a_i32[0] + 1);
  let small: [i64 | 0..=8] = alloc(2, 8);
  let large: [i64 | 0..=728] = mixed::<i64>(small);
  let short: [i64 | 0..=728] = truncate(large, 1);
  print(short[0]);
  let zero: [i64 | 0..=255] = empty::<i64>(); print(len(zero));
  let refined: [i64 | 0..=255] = alloc(1, 5);
  let wide: [i64] = copy(refined); print(wide[0]);
  let field_src: [i64 | 0..=255] = alloc(1, 6);
  let boxed: Boxed = Boxed { values: copy(field_src) }; print(boxed.values[0]);
  let gen_src: [i64 | 0..=255] = alloc(1, 9);
  let gen_result: [i64] = generic::<i64>(gen_src); print(gen_result[0]);
  let host_src: [i64 | 0..=255] = alloc(1, 10);
  let host_result: [i64 | 0..=255] = boundary(host_src); print(host_result[0]);
  let mut mutable: [i64 | -128..=127] = alloc(1, 0);
  let sorted: [i64 | 0..=255] = alloc(2, 12);
  mutate(inout mutable, sorted); print(mutable[0]);
}
