// the empty str: length 0, substr("", 0, 0), copy(""), boundary 0 true and 1 false; empty results cross the ABI as a zero-length String.
fn e() -> i64 ! alloc {
  let s: str = "";
  let t: str = substr("", 0, 0);
  let c: str = copy("");
  assert len(s) == 0;
  assert len(t) == 0;
  assert len(c) == 0;
  assert is_char_boundary("", 0);
  assert !is_char_boundary("", 1);
  if is_char_boundary(s, 0) {
    return len(t) + len(c) + 1;
  }
  return 0;
}

fn ret() -> str ! alloc {
  return substr("", 0, 0);
}

fn ret2() -> str ! alloc {
  return copy("");
}
