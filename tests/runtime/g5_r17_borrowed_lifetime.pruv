// G5 A3 runtime: a caller-owned buffer borrowed by several inout calls (directly and through a forwarding helper) is
// neither freed, replaced nor moved by the callees: it is still valid after every call, a copy taken in between stays
// independent, and the caller frees each buffer exactly once (llvm: alloc_balance).
fn put_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn put_two(inout a: [i64], v: i64) -> ()
  requires len(a) >= 2 && -1000 < v && v < 1000
  ensures len(a) == len(old(a))
  ensures a[0] == v
  ensures a[1] == v + 1
{
  put_at(inout a, 0, v);
  put_at(inout a, 1, v + 1);
}

pub fn lifetime(n: i64, v: i64) -> i64 ! alloc
  requires 2 <= n && n <= 100 && -900 < v && v < 900
{
  let mut w: [i64] = alloc(n, 0);
  put_two(inout w, v);
  put_two(inout w, v + 1);
  put_two(inout w, v + 2);
  let c: [i64] = copy(w);
  put_two(inout w, 0);
  return c[0] + c[1] * 1000 + w[0];
}
