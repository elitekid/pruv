// G9 A2 runtime: sum of clamped node values over a literal tree and over a recursively built chain (chain(n) sums n..1)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn sample() -> Tree ! alloc
  ensures size(result) == 9
{
  return Tree::Node(4, Tree::Node(2, Tree::Empty, Tree::Empty), Tree::Node(7, Tree::Node(5, Tree::Empty, Tree::Empty), Tree::Empty));
}

fn chain(n: i64) -> Tree ! alloc
  requires n >= 0
  ensures size(result) == 2 * n + 1
  decreases n
{
  if n == 0 { return Tree::Empty; }
  return Tree::Node(n, chain(n - 1), Tree::Empty);
}

fn clamp(v: i64) -> i64
  ensures result >= 0 && result <= 100
{
  if v < 0 { return 0; }
  if v > 100 { return 100; }
  return v;
}

fn tree_sum(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result >= 0 && result <= 100 * size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => { return clamp(v) + tree_sum(l) + tree_sum(r); }
  }
}

fn sample_sum() -> i64 ! alloc {
  return tree_sum(sample());
}

fn chain_sum(n: i64) -> i64 ! alloc
  requires n >= 0 && n <= 100
{
  return tree_sum(chain(n));
}
