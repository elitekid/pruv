// G9 A2 runtime: tree construction and pure traversals (size, depth, node count, contains) over a tree built inside Pruv
// sample(): 4 with children 2 (leaf) and 7 (left child 5): 4 Node + 5 Empty constructors, depth 4 counting Empty as 1
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn sample() -> Tree ! alloc
  ensures size(result) == 9
{
  return Tree::Node(4, Tree::Node(2, Tree::Empty, Tree::Empty), Tree::Node(7, Tree::Node(5, Tree::Empty, Tree::Empty), Tree::Empty));
}

fn node_total(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result == size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 1; }
    Tree::Node(v, l, r) => { return 1 + node_total(l) + node_total(r); }
  }
}

fn depth(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result >= 1 && result <= size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 1; }
    Tree::Node(v, l, r) => {
      let dl: i64 = depth(l);
      let dr: i64 = depth(r);
      if dl > dr { return 1 + dl; }
      return 1 + dr;
    }
  }
}

fn nodes(t: Tree) -> i64
  requires size(t) <= 1000
  ensures result >= 0 && result <= size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => { return 1 + nodes(l) + nodes(r); }
  }
}

fn contains(t: Tree, x: i64) -> bool
  ensures is_variant(t, Tree::Empty) ==> !result
  ensures is_variant(t, Tree::Node) &&
          variant_field(t, Tree::Node, value) == x ==> result
  decreases size(t)
{
  match t {
    Tree::Empty => { return false; }
    Tree::Node(v, l, r) => {
      if v == x { return true; }
      if contains(l, x) { return true; }
      return contains(r, x);
    }
  }
}

fn sample_total() -> i64 ! alloc {
  return node_total(sample());
}

fn sample_depth() -> i64 ! alloc {
  return depth(sample());
}

fn sample_nodes() -> i64 ! alloc {
  return nodes(sample());
}

fn sample_has(x: i64) -> bool ! alloc {
  return contains(sample(), x);
}
