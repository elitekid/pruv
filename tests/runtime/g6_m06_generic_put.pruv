// G6 A2 runtime: a generic helper put<K: Element, V> specialized at (i64, i64) and (bool, bool); results read back with map_get
fn put<K: Element, V>(take m: HashMap<K, V>, k: K, x: V) -> HashMap<K, V> ! alloc
  requires len(m) < 1000
  ensures map_updated::<K, V>(result, m, k, x)
{
  return map_insert::<K, V>(move m, k, x);
}

fn int_roundtrip(k: i64, v: i64) -> i64 ! alloc
  ensures result == v
{
  let m0: HashMap<i64, i64> = map_new::<i64, i64>();
  let m1: HashMap<i64, i64> = put::<i64, i64>(move m0, k, v);
  let found: Option<i64> = map_get::<i64, i64>(m1, k);
  match found {
    Some(x) => { return x; }
    None => { return v; }
  }
}

fn flag_roundtrip(k: bool, v: bool) -> bool ! alloc
  ensures result == v
{
  let m0: HashMap<bool, bool> = map_new::<bool, bool>();
  let m1: HashMap<bool, bool> = put::<bool, bool>(move m0, k, v);
  let found: Option<bool> = map_get::<bool, bool>(m1, k);
  match found {
    Some(x) => { return x; }
    None => { return v; }
  }
}

fn other_key_missing(k: i64, j: i64) -> i64 ! alloc
  requires k != j
  ensures result == -1
{
  let m0: HashMap<i64, i64> = map_new::<i64, i64>();
  let m1: HashMap<i64, i64> = put::<i64, i64>(move m0, k, 1);
  let found: Option<i64> = map_get::<i64, i64>(m1, j);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}
