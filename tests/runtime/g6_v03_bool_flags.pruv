// G6 A2 runtime: Vec<bool> with a symbolic bool element; counted by unrolled vec_get reads
fn count_with(b: bool) -> i64 ! alloc
  ensures result >= 1 && result <= 2
{
  let mut v: Vec<bool> = vec_new::<bool>();
  v = vec_push::<bool>(move v, true);
  v = vec_push::<bool>(move v, false);
  v = vec_push::<bool>(move v, b);
  let mut c: i64 = 0;
  if vec_get::<bool>(v, 0) {
    c = c + 1;
  }
  if vec_get::<bool>(v, 1) {
    c = c + 1;
  }
  if vec_get::<bool>(v, 2) {
    c = c + 1;
  }
  return c;
}

fn third(b: bool) -> bool ! alloc
  ensures result == b
{
  let mut v: Vec<bool> = vec_new::<bool>();
  v = vec_push::<bool>(move v, false);
  v = vec_push::<bool>(move v, true);
  v = vec_push::<bool>(move v, b);
  return vec_get::<bool>(v, 2);
}
