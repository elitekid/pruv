// G6 A2 runtime: HashMap<i64, i64> with two inserts; lookup of present keys and of a missing key through map_get
fn lookup(k: i64) -> i64 ! alloc
  ensures k == 3 ==> result == 7
  ensures k == 4 ==> result == 9
  ensures (k != 3 && k != 4) ==> result == -1
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  m = map_insert::<i64, i64>(move m, 4, 9);
  let found: Option<i64> = map_get::<i64, i64>(m, k);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}

fn size_two() -> i64 ! alloc
  ensures result == 2
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, 3, 7);
  m = map_insert::<i64, i64>(move m, 4, 9);
  return len(m);
}
