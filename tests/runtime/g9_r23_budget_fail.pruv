// G9 A2 runtime: the size() visit count of an internal requires exhausts the contract budget (--contract-budget 1000) and the check is undefined
// chain(10) has 21 constructors and passes; chain(2000) has 4001, so evaluating size(t) <= 100000 runs out of budget (run under --no-verify)
enum Tree { Empty, Node(value: i64, left: Tree, right: Tree) }

fn chain(n: i64) -> Tree ! alloc
  requires n >= 0
  ensures size(result) == 2 * n + 1
  decreases n
{
  if n == 0 { return Tree::Empty; }
  return Tree::Node(n, chain(n - 1), Tree::Empty);
}

fn nodes(t: Tree) -> i64
  requires size(t) <= 100000
  ensures result >= 0 && result <= size(t)
  decreases size(t)
{
  match t {
    Tree::Empty => { return 0; }
    Tree::Node(v, l, r) => { return 1 + nodes(l) + nodes(r); }
  }
}

fn chain_nodes(n: i64) -> i64 ! alloc
  requires n >= 0 && n <= 5000
{
  let t: Tree = chain(n);
  return nodes(t);
}
