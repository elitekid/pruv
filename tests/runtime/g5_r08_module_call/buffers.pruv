// companion module of g5_r08_module_call: a child `pub` function may take an inout parameter
pub fn set_at(inout a: [i64], i: i64, value: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == value
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = value;
}
