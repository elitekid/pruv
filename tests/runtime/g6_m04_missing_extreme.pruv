// G6 A2 runtime: missing keys (empty map and absent probes) and extreme i64 keys 0, 9223372036854775807, -9223372036854775807
fn probe_empty(k: i64) -> i64 ! alloc
  ensures result == -1
{
  let m: HashMap<i64, i64> = map_new::<i64, i64>();
  let found: Option<i64> = map_get::<i64, i64>(m, k);
  match found {
    Some(x) => { return x; }
    None => { return -1; }
  }
}

fn extreme(k: i64) -> i64 ! alloc
  ensures k == 0 ==> result == 2
  ensures k == 9223372036854775807 ==> result == 3
  ensures k == -9223372036854775807 ==> result == 1
  ensures (k != 0 && k != 9223372036854775807 && k != -9223372036854775807) ==> result == 0
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  m = map_insert::<i64, i64>(move m, -9223372036854775807, 1);
  m = map_insert::<i64, i64>(move m, 0, 2);
  m = map_insert::<i64, i64>(move m, 9223372036854775807, 3);
  let found: Option<i64> = map_get::<i64, i64>(m, k);
  match found {
    Some(x) => { return x; }
    None => { return 0; }
  }
}
