// G6b runtime: a trusted adapter taking str and returning Vec<i64> whose contents mirror the text bytes
trusted rust fn codes(text: str) -> Vec<i64> ! alloc
  ensures len(result) == len(text)
  ensures forall i in 0..len(result): result[i] == text[i]
  = "::g6b_adapter::codes";

fn code_sum(text: str) -> i64 ! alloc
  requires len(text) <= 100
  ensures result >= 0
{
  let v: Vec<i64> = codes(text);
  let mut total: i64 = 0;
  let mut i: i64 = 0;
  while i < len(v)
    invariant 0 <= i && i <= len(v) && len(v) == len(text) && total >= 0 && total <= 255 * i
    decreases len(v) - i
  {
    total = total + vec_get::<i64>(v, i);
    i = i + 1;
  }
  return total;
}
