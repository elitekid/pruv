// G6b runtime (injected wrong Rust): a Vec<i64> with the wrong content, caught by --foreign-checks all (exit 101)
trusted rust fn short_word() -> String ! alloc
  ensures len(result) == 3
  = "::g6b_liar::short_word";

trusted rust fn wrong_nums() -> Vec<i64> ! alloc
  ensures len(result) == 2
  ensures result[0] == 1 && result[1] == 3
  = "::g6b_liar::wrong_nums";

fn lie_len() -> i64 ! alloc
{
  let s: String = short_word();
  return len(s);
}

fn lie_second() -> i64 ! alloc
{
  let v: Vec<i64> = wrong_nums();
  return vec_get::<i64>(v, 1);
}
