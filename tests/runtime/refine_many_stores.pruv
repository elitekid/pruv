// performance regression sample: 62 straight-line stores `a[len(a)-1-J] = V` into a refined array. Each store costs
// one index_oob query and one stored-value range query (no synthesized forall assert on the whole array).
// a[63-J] = 10*J + 1 for J = 0..=61; a[0] and a[1] stay 0. f() = a[63] + a[33] + a[2] + a[1] = 1 + 301 + 611 + 0.

fn f() -> i64 ! alloc {
  let mut a: [i64 | 0..=1000; <=64] = alloc(64, 0);
  a[len(a)-1-0] = 1;
  a[len(a)-1-1] = 11;
  a[len(a)-1-2] = 21;
  a[len(a)-1-3] = 31;
  a[len(a)-1-4] = 41;
  a[len(a)-1-5] = 51;
  a[len(a)-1-6] = 61;
  a[len(a)-1-7] = 71;
  a[len(a)-1-8] = 81;
  a[len(a)-1-9] = 91;
  a[len(a)-1-10] = 101;
  a[len(a)-1-11] = 111;
  a[len(a)-1-12] = 121;
  a[len(a)-1-13] = 131;
  a[len(a)-1-14] = 141;
  a[len(a)-1-15] = 151;
  a[len(a)-1-16] = 161;
  a[len(a)-1-17] = 171;
  a[len(a)-1-18] = 181;
  a[len(a)-1-19] = 191;
  a[len(a)-1-20] = 201;
  a[len(a)-1-21] = 211;
  a[len(a)-1-22] = 221;
  a[len(a)-1-23] = 231;
  a[len(a)-1-24] = 241;
  a[len(a)-1-25] = 251;
  a[len(a)-1-26] = 261;
  a[len(a)-1-27] = 271;
  a[len(a)-1-28] = 281;
  a[len(a)-1-29] = 291;
  a[len(a)-1-30] = 301;
  a[len(a)-1-31] = 311;
  a[len(a)-1-32] = 321;
  a[len(a)-1-33] = 331;
  a[len(a)-1-34] = 341;
  a[len(a)-1-35] = 351;
  a[len(a)-1-36] = 361;
  a[len(a)-1-37] = 371;
  a[len(a)-1-38] = 381;
  a[len(a)-1-39] = 391;
  a[len(a)-1-40] = 401;
  a[len(a)-1-41] = 411;
  a[len(a)-1-42] = 421;
  a[len(a)-1-43] = 431;
  a[len(a)-1-44] = 441;
  a[len(a)-1-45] = 451;
  a[len(a)-1-46] = 461;
  a[len(a)-1-47] = 471;
  a[len(a)-1-48] = 481;
  a[len(a)-1-49] = 491;
  a[len(a)-1-50] = 501;
  a[len(a)-1-51] = 511;
  a[len(a)-1-52] = 521;
  a[len(a)-1-53] = 531;
  a[len(a)-1-54] = 541;
  a[len(a)-1-55] = 551;
  a[len(a)-1-56] = 561;
  a[len(a)-1-57] = 571;
  a[len(a)-1-58] = 581;
  a[len(a)-1-59] = 591;
  a[len(a)-1-60] = 601;
  a[len(a)-1-61] = 611;
  return a[63] + a[33] + a[2] + a[1];
}
