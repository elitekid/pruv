// G9 A2 runtime: a struct that combines a recursive root (Json) with str and [i64] buffer fields, built and read inside Pruv
// document: root [1, 2] (6 constructors), source "[1,2]", offsets [1, 3]
struct Document { root: Json, source: str, offsets: [i64] }
enum Json {
  Null, Boolean(value: bool), Number(value: i64), Text(value: str),
  Array(items: Items), Object(members: Members)
}
enum Items { End, Next(value: Json, rest: Items) }
enum Members { End, Next(key: str, value: Json, rest: Members) }

fn json_numbers(j: Json) -> i64
  requires size(j) <= 1000
  ensures result >= 0 && result <= size(j)
  decreases size(j)
{
  match j {
    Json::Null => { return 0; }
    Json::Boolean(b) => { return 0; }
    Json::Number(n) => { return 1; }
    Json::Text(s) => { return 0; }
    Json::Array(items) => { return items_numbers(items); }
    Json::Object(members) => { return members_numbers(members); }
  }
}

fn items_numbers(it: Items) -> i64
  requires size(it) <= 1000
  ensures result >= 0 && result <= size(it)
  decreases size(it)
{
  match it {
    Items::End => { return 0; }
    Items::Next(v, rest) => { return json_numbers(v) + items_numbers(rest); }
  }
}

fn members_numbers(m: Members) -> i64
  requires size(m) <= 1000
  ensures result >= 0 && result <= size(m)
  decreases size(m)
{
  match m {
    Members::End => { return 0; }
    Members::Next(k, v, rest) => { return json_numbers(v) + members_numbers(rest); }
  }
}

fn make_doc() -> Document ! alloc
  ensures size(result.root) == 6 && len(result.offsets) == 2
{
  let mut offs: [i64] = alloc(2, 0);
  offs[0] = 1;
  offs[1] = 3;
  return Document { root: Json::Array(Items::Next(Json::Number(1), Items::Next(Json::Number(2), Items::End))), source: copy("[1,2]"), offsets: copy(offs) };
}

fn doc_numbers() -> i64 ! alloc {
  let d: Document = make_doc();
  return json_numbers(d.root);
}

fn doc_offset(i: i64) -> i64 ! alloc
  requires 0 <= i && i < 2
{
  let d: Document = make_doc();
  return d.offsets[i];
}

fn doc_source_len() -> i64 ! alloc {
  let d: Document = make_doc();
  return len(d.source);
}

fn doc_source_first() -> i64 ! alloc {
  let d: Document = make_doc();
  if len(d.source) >= 1 { return d.source[0]; }
  return 0 - 1;
}
