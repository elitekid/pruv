// G5 A2 runtime: an inout parameter forwarded to inout callees again and again (twice in a row, and once per loop
// iteration); every call reborrows the same borrowed slice and the stores accumulate
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn set_pair(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i + 1 < len(a) && -1000 < v && v < 1000
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures a[i + 1] == v + 1
{
  set_at(inout a, i, v);
  set_at(inout a, i + 1, v + 1);
}

fn inc_at(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a) && a[i] < 1000
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[i] + 1
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = a[i] + 1;
}

fn inc_all(inout a: [i64]) -> ()
  requires forall k in 0..len(a): a[k] < 1000
  ensures len(a) == len(old(a))
  ensures forall k in 0..len(a): a[k] == old(a)[k] + 1
{
  let n: i64 = len(a);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant n == len(old(a))
    invariant forall k in 0..i: a[k] == old(a)[k] + 1
    invariant forall k in i..n: a[k] == old(a)[k]
    decreases n - i
  {
    inc_at(inout a, i);
    i = i + 1;
  }
}

pub fn bump_all(a: [i64]) -> [i64] ! alloc
  requires forall k in 0..len(a): a[k] < 1000
{
  let mut w: [i64] = copy(a);
  inc_all(inout w);
  return w;
}

pub fn pair(a: [i64], i: i64, v: i64) -> [i64] ! alloc
  requires 0 <= i && i + 1 < len(a) && -1000 < v && v < 1000
{
  let mut w: [i64] = copy(a);
  set_pair(inout w, i, v);
  return w;
}
