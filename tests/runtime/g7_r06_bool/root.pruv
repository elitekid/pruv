fn set<T: Element>(inout a: [T], v: T) -> ()
 requires len(a) > 0
 ensures a[0] == v
{ a[0] = v; }

fn run(pick: i64) -> [bool] ! alloc {
let mut a: [bool] = alloc(3, false);
 let mut b: [bool] = alloc(3, false);
 let mut c: [bool] = alloc(3, false);
 
 par { set::<bool>(inout a, true); set::<bool>(inout b, false); }
 
 if pick == 0 { return a; }
 if pick == 1 { return b; }
 return c;
}

fn sequential(pick: i64) -> [bool] ! alloc {
let mut a: [bool] = alloc(3, false);
 let mut b: [bool] = alloc(3, false);
 let mut c: [bool] = alloc(3, false);
 
 set::<bool>(inout a, true); set::<bool>(inout b, false);
 
 if pick == 0 { return a; }
 if pick == 1 { return b; }
 return c;
}
