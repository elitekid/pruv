// fuzz (bench/fuzz) finding: `b[i] = v` must evaluate the index before the value in every mode.
// Proof mode (rust and llvm) evaluated the value first, safe mode the index first.

fn ix() -> i64 ! io
  ensures result == 0
{
  print(1);
  return 0;
}

fn val() -> i64 ! io {
  print(2);
  return 5;
}

fn f() -> i64 ! io, alloc {
  let mut b: [i64] = alloc(1, 0);
  b[ix()] = val();
  return b[0];
}
