// with --infer: sibling blocks use the same name as [i64] and [bool]; the else-block loop reads the [bool] one, so its invariants must come from the per-loop element-type table.
fn f(c: i64) -> i64 ! alloc {
  let mut n: i64 = 0;
  if c > 0 {
    let a: [i64] = alloc(3, 5);
    n = len(a);
  } else {
    let a: [bool] = alloc(4, true);
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < len(a)
      decreases len(a) - i
    {
      if a[i] {
        t = t + 1;
      }
      i = i + 1;
    }
    n = t;
  }
  return n;
}
