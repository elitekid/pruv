// G6 A2 runtime (injected wrong Rust): the same false ensures as g6_liar_ensures_quiet, caught by --foreign-checks all (exit 101)
trusted rust fn liar_positive(x: i64) -> i64
  requires 0 <= x && x <= 100
  ensures result > x
  = "::g6_liar::liar_positive";

fn bump(x: i64) -> i64
  requires 0 <= x && x <= 100
{
  return liar_positive(x);
}
