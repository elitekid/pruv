// B2: 생성·실행까지 통과 — 내부 선행 바이트·continuation 문턱, lo == hi, 3·4바이트 경계 부분 문자열
fn f() -> i64 ! alloc {
  assert is_char_boundary("a¿", 1);
  assert is_char_boundary("aé", 1);
  assert is_char_boundary("a~", 1);
  assert is_char_boundary("a안", 1);
  assert !is_char_boundary("¿", 1);
  assert !is_char_boundary("a¿", 2);
  let e: str = substr("é", 0, 0);
  assert len(e) == 0;
  let k: str = substr("안녕", 3, 6);
  assert len(k) == 3 && k[0] == 235;
  let m: str = substr("😀a", 0, 4);
  assert len(m) == 4 && m[0] == 240 && m[3] == 128;
  return 0;
}
