// Source finding: G8 fuzz seed 41 case 12, sum_add composition.
mod std;
pub fn combined_sum(a: [i64], b: [i64]) -> Option<i64>
 requires len(a) <= 1000000 && len(b) <= 1000000
 requires forall k in 0..len(a): -1000000000 <= a[k] && a[k] <= 1000000000
 requires forall k in 0..len(b): -1000000000 <= b[k] && b[k] <= 1000000000
 ensures is_some(result) ==> some_val(result) == sum(k in 0..len(a): a[k]) + sum(k in 0..len(b): b[k])
{
 return crate::std::checked_add_i64(crate::std::sum_i64(a), crate::std::sum_i64(b));
}
