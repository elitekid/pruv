// [u8] stores in a loop: after the loop havoc the elements are still within 0..=255.
fn f() -> i64 ! alloc {
  let mut b: [u8] = alloc(8, 0);
  let mut i: i64 = 0;
  while i < 8
    invariant 0 <= i && i <= 8
    invariant len(b) == 8
    decreases 8 - i
  {
    b[i] = i * 30;
    i = i + 1;
  }
  assert b[3] <= 255;
  return 0;
}
