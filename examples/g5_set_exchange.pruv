// G5: in-place set and exchange on an inout array with exact frame contracts; the pub entry owns a copy
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn exchange(inout a: [i64], i: i64, j: i64) -> ()
  requires 0 <= i && i < len(a) && 0 <= j && j < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[j]
  ensures a[j] == old(a)[i]
  ensures forall k in 0..len(a): k != i && k != j ==> a[k] == old(a)[k]
{
  let x: i64 = a[i];
  let y: i64 = a[j];
  a[i] = y;
  a[j] = x;
}

pub fn set_then_swap(a: [i64], i: i64, j: i64, v: i64) -> [i64] ! alloc
  requires 0 <= i && i < len(a) && 0 <= j && j < len(a)
{
  let mut w: [i64] = copy(a);
  set_at(inout w, i, v);
  exchange(inout w, i, j);
  return w;
}
