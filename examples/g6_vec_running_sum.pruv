// G6: build a Vec in a loop (move + reassignment) and read it back with vec_get
fn prefix_sums(a: [i64]) -> i64 ! alloc
  requires len(a) <= 1000
  requires forall k in 0..len(a): 0 <= a[k] && a[k] <= 1000
  ensures 0 <= result && result <= 1000000
{
  let mut v: Vec<i64> = vec_new::<i64>();
  let mut s: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(v) == i
    invariant 0 <= s && s <= 1000 * i
    invariant forall k in 0..i: 0 <= v[k] && v[k] <= 1000 * i
    decreases len(a) - i
  {
    s = s + a[i];
    v = vec_push::<i64>(move v, s);
    i = i + 1;
  }
  if len(v) == 0 {
    return 0;
  }
  return vec_get::<i64>(v, len(v) - 1);
}
