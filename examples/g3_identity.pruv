// G3 example: the identity function, one generic definition used at i64 and at bool
fn id<T>(x: T) -> T
  ensures result == x
{
  return x;
}

fn id_int(x: i64) -> i64
  ensures result == x
{
  return id::<i64>(x);
}

fn id_bool(x: bool) -> bool
  ensures result == x
{
  return id::<bool>(x);
}

fn bit(b: bool) -> i64 {
  if b {
    return 1;
  }
  return 0;
}

fn main() -> () ! io {
  print(id_int(42));
  print(bit(id_bool(true)));
}
