// G3 example: first and last element of a [T]; the requires establish the index obligations
fn first<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn last<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[len(a) - 1]
{
  return a[len(a) - 1];
}

fn main() -> () ! io, alloc {
  let a: [i64] = alloc(3, 7);
  print(first::<i64>(a));
  print(last::<i64>(a));
}
