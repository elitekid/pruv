// sibling blocks declare the same name as [i64] and as [bool]; the loop in the else block reads the [bool] one (explicit invariants, so no --infer needed).
fn f(c: i64) -> i64 ! alloc {
  let mut n: i64 = 0;
  if c > 0 {
    let a: [i64] = alloc(3, 5);
    n = len(a);
  } else {
    let a: [bool] = alloc(4, true);
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < len(a)
      invariant 0 <= i && i <= len(a)
      invariant len(a) == 4
      invariant 0 <= t && t <= i
      decreases len(a) - i
    {
      if a[i] {
        t = t + 1;
      }
      i = i + 1;
    }
    n = t;
  }
  return n;
}
