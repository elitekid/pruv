// module crate::engine::rules of examples/g4_backend
mod limits;

// private helper: only this module can call it
fn floor_zero(x: i64) -> i64
  ensures result >= 0 && (x >= 0 ==> result == x)
{
  if x < 0 {
    return 0;
  }
  return x;
}

pub fn score(raw: i64, cap: i64) -> i64
  requires 0 <= raw && raw <= 1000000
  requires 1 <= cap && cap <= 1000000
  ensures 0 <= result && result <= cap
{
  let r: i64 = floor_zero(raw);
  return crate::engine::rules::limits::clamp(r, 0, cap);
}
