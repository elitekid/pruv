// G3 example: a [T] filled with one value; length and contents are in the contract
fn repeat<T: Element>(n: i64, value: T) -> [T] ! alloc
  requires 0 <= n && n <= 1000
  ensures len(result) == n
  ensures forall k in 0..n: result[k] == value
{
  let out: [T] = alloc(n, value);
  return out;
}

fn main() -> () ! io, alloc {
  let a: [i64] = repeat::<i64>(3, 9);
  print(a[2]);
}
