// G9: recursion over an array suffix (decreases len(a) - i): nonnegative count and the suffix maximum, both fully specified
fn count_nonneg(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a)
  ensures result == count(k in i..len(a): a[k] >= 0)
  ensures 0 <= result && result <= len(a) - i
  decreases len(a) - i
{
  if i == len(a) { return 0; }
  if a[i] >= 0 { return 1 + count_nonneg(a, i + 1); }
  return count_nonneg(a, i + 1);
}

fn max_from(a: [i64], i: i64) -> i64
  requires 0 <= i && i < len(a)
  ensures forall k in i..len(a): a[k] <= result
  ensures exists k in i..len(a): a[k] == result
  decreases len(a) - i
{
  if i == len(a) - 1 { return a[i]; }
  let m: i64 = max_from(a, i + 1);
  if a[i] > m { return a[i]; }
  return m;
}
