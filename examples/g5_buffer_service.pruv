// G5: a small buffer service. One initial copy, then several internal in-place operations on the same buffer;
// the host entries own the buffer and return it (no copy-and-return between the internal steps).
fn set_at(inout a: [i64], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == v
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = v;
}

fn exchange(inout a: [i64], i: i64, j: i64) -> ()
  requires 0 <= i && i < len(a) && 0 <= j && j < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[j]
  ensures a[j] == old(a)[i]
  ensures forall k in 0..len(a): k != i && k != j ==> a[k] == old(a)[k]
{
  let x: i64 = a[i];
  let y: i64 = a[j];
  a[i] = y;
  a[j] = x;
}

fn bump(inout a: [i64], i: i64) -> ()
  requires 0 <= i && i < len(a) && a[i] < 1000
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[i] + 1
  ensures forall k in 0..len(a): k != i ==> a[k] == old(a)[k]
{
  a[i] = a[i] + 1;
}

fn prepare(inout a: [i64], v: i64) -> ()
  requires len(a) >= 3 && -1000 < v && v < 1000
  ensures len(a) == len(old(a))
  ensures a[0] == v + 1
  ensures a[2] == v
{
  set_at(inout a, 0, v);
  set_at(inout a, 2, v);
  bump(inout a, 0);
  exchange(inout a, 1, 2);
  exchange(inout a, 1, 2);
}

pub fn serve(a: [i64], v: i64) -> [i64] ! alloc
  requires len(a) >= 3 && -1000 < v && v < 1000
{
  let mut buf: [i64] = copy(a);
  prepare(inout buf, v);
  return buf;
}

pub fn first_after(a: [i64], v: i64) -> i64 ! alloc
  requires len(a) >= 3 && -1000 < v && v < 1000
{
  let mut buf: [i64] = copy(a);
  prepare(inout buf, v);
  return buf[0];
}
