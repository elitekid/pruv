// plb2 nqueen (nq_solve) with the loop structure of reference.rs: one array per mask kind
// (a = chosen column per row, l/c/r = left diagonal / column / right diagonal masks), explicit backtracking, no recursion.
// Result: [number of solutions]  (n = 12 -> 14200, n = 15 -> 2279184).
//
// Differences that only serve the prover (none changes a result):
//  * `break` is expressed as k = -1 with the loop guard `k >= 0` (the reference breaks exactly when k == 0 and would do k -= 1).
//  * `fuel` is the termination witness (the search tree for n <= 15 has far fewer than 10^12 steps).
//  * the bit operations sit in small helpers so the loop proof sees only their contracts (bit-vector terms inside the
//    loop body made the invariant check time out); rustc and clang inline them.
//  * `top` / `i >= n` are two never-taken guards: wrapping_shl has no range fact, and "the free bit found by the scan is
//    below n" is a bit-vector argument over a loop; the guard gives the prover 2 <= 2^n <= 32768 and i < n <= 15.
// Bit helpers: keep the bit-vector terms out of the search loop (the loop needs only their shift-count rules).
fn bit(i: i64) -> i64
  requires 0 <= i && i < 64
{ return wrapping_shl(1, i); }
fn free_mask(l: i64, c: i64, r: i64, y0: i64) -> i64 { return band(bor(bor(l, c), r), y0); }
fn has_free(y: i64, y0: i64, s: i64) -> bool
  requires 0 <= s && s < 64
{ return ushr(bxor(y, y0), s) != 0; }
fn taken(y: i64, i: i64) -> bool
  requires 0 <= i && i < 64
{ return band(y, wrapping_shl(1, i)) != 0; }
fn left(m: i64, z: i64) -> i64 { return wrapping_shl(bor(m, z), 1); }
fn orb(m: i64, z: i64) -> i64 { return bor(m, z); }
fn right(m: i64, z: i64) -> i64 { return ushr(bor(m, z), 1); }
pub fn bench(data: [u8], n: i64) -> [i64] ! alloc
  requires 1 <= n && n <= 15
{
  let mut out: [i64] = alloc(1, 0);
  // y0 = (1 << n) - 1
  let top: i64 = wrapping_shl(1, n);
  if top < 2 || top > 32768 { return out; }
  let y0: i64 = top - 1;
  let mut a: [i64 | -1..=14] = alloc(n, -1);
  let mut l: [i64] = alloc(n, 0);
  let mut c: [i64] = alloc(n, 0);
  let mut r: [i64] = alloc(n, 0);
  let mut m: i64 = 0;
  let mut k: i64 = 0;
  let mut fuel: i64 = 1000000000000;
  while k >= 0 && fuel > 0
    invariant len(out) == 1 && len(a) == n && len(l) == n && len(c) == n && len(r) == n
    invariant 1 <= y0 && y0 <= 32767
    invariant -1 <= k && k < n
    invariant 0 <= fuel && fuel <= 1000000000000
    invariant 0 <= m && m + fuel <= 1000000000000
    decreases fuel
  {
    fuel = fuel - 1;
    let y: i64 = free_mask(l[k], c[k], r[k], y0);
    if has_free(y, y0, a[k] + 1) {
      let mut i: i64 = a[k] + 1;
      while i < n && taken(y, i)
        invariant 0 <= i && i <= 15
        decreases 15 - i
      {
        i = i + 1;
      }
      // Never taken: a free bit at or above a[k] + 1 exists, so the scan stops below n.
      if i >= n { return out; }
      if k < n - 1 {
        let z: i64 = bit(i);
        a[k] = i;
        k = k + 1;
        l[k] = left(l[k - 1], z);
        c[k] = orb(c[k - 1], z);
        r[k] = right(r[k - 1], z);
      } else {
        m = m + 1;
        k = k - 1;
      }
    } else {
      a[k] = -1;
      k = k - 1;
    }
  }
  out[0] = m;
  return out;
}
