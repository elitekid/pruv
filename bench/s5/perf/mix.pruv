fn step(x: i64) -> i64
 requires 0 <= x && x < 65521
 ensures 0 <= result && result < 65521
 cost 0
{ return (x * 251 + 17) % 65521; }
fn mix(n: i64, seed: i64) -> i64
 requires 0 <= n && n <= 1000000
 requires 0 <= seed && seed < 65521
 cost 65 * n
{
 let mut x: i64 = seed;
 let mut i: i64 = 0;
 while i < n
 invariant 0 <= i && i <= n
 invariant 0 <= x && x < 65521
 invariant spent == 65 * i
 decreases n - i
 {
  let mut j: i64 = 0;
  while j < 32
  invariant 0 <= j && j <= 32
  invariant 0 <= x && x < 65521
  invariant spent == 65 * i + 1 + 2 * j
  decreases 32 - j
  { x = step(x); j = j + 1; }
  i = i + 1;
 }
 return x;
}
