// q03: mutual recursion value_end <-> list_end.
// measures: value_end = 2*(len-i), list_end = 2*(len-j)+1.

fn list_end(a: [i64], j: i64) -> i64
  requires 0 <= j && j <= len(a) && len(a) <= 1000
  ensures result == 0 - 1 || (j < result && result <= len(a))
  decreases 2 * (len(a) - j) + 1
{
  if j >= len(a) {
    return 0 - 1;
  }
  if a[j] == 2 {
    return j + 1;
  }
  let e: i64 = value_end(a, j);
  if e < 0 {
    return 0 - 1;
  }
  return list_end(a, e);
}

fn value_end(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a) && len(a) <= 1000
  ensures result == 0 - 1 || (i < result && result <= len(a))
  ensures (i < len(a) && a[i] == 0) ==> result == i + 1
  ensures (i == len(a) || (a[i] != 0 && a[i] != 1)) ==> result == 0 - 1
  decreases 2 * (len(a) - i)
{
  if i >= len(a) {
    return 0 - 1;
  }
  if a[i] == 0 {
    return i + 1;
  }
  if a[i] == 1 {
    return list_end(a, i + 1);
  }
  return 0 - 1;
}

fn is_value(a: [i64]) -> bool
  requires len(a) <= 1000
  ensures result ==> len(a) >= 1
  ensures (len(a) == 1 && a[0] == 0) ==> result
  ensures (len(a) >= 1 && a[0] == 0 && len(a) != 1) ==> !result
{
  if len(a) == 0 {
    return false;
  }
  let e: i64 = value_end(a, 0);
  return e == len(a);
}
