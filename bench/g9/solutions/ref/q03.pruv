// G9 q03 reference: mutual recursive descent over a token array (0 = atom, 1 = open, 2 = close)
fn value_end(a: [i64], i: i64) -> i64
  requires 0 <= i && i <= len(a) && len(a) <= 1000
  ensures result == 0 - 1 || (i < result && result <= len(a))
  ensures (i < len(a) && a[i] == 0) ==> result == i + 1
  ensures (i == len(a) || (a[i] != 0 && a[i] != 1)) ==> result == 0 - 1
  decreases 2 * (len(a) - i) + 1
{
  if i == len(a) { return 0 - 1; }
  if a[i] == 0 { return i + 1; }
  if a[i] != 1 { return 0 - 1; }
  return items_end(a, i + 1);
}

fn items_end(a: [i64], j: i64) -> i64
  requires 0 <= j && j <= len(a) && len(a) <= 1000
  ensures result == 0 - 1 || (j < result && result <= len(a))
  decreases 2 * (len(a) - j) + 2
{
  if j == len(a) { return 0 - 1; }
  if a[j] == 2 { return j + 1; }
  let k: i64 = value_end(a, j);
  if k < 0 { return 0 - 1; }
  return items_end(a, k);
}

fn is_value(a: [i64]) -> bool
  requires len(a) <= 1000
  ensures result ==> len(a) >= 1
  ensures (len(a) == 1 && a[0] == 0) ==> result
  ensures (len(a) >= 1 && a[0] == 0 && len(a) != 1) ==> !result
{
  return value_end(a, 0) == len(a);
}
