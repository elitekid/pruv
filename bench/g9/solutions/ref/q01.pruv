// G9 q01 reference: recursive linear search with quantified postconditions
fn search_from(a: [i64], q: i64, i: i64) -> i64
  requires 0 <= i && i <= len(a)
  requires forall k in 0..i: a[k] != q
  ensures result == 0 - 1 || (i <= result && result < len(a))
  ensures result >= 0 ==> a[result] == q && (forall k in 0..result: a[k] != q)
  ensures result < 0 ==> (forall k in 0..len(a): a[k] != q)
  decreases len(a) - i
{
  if i == len(a) { return 0 - 1; }
  if a[i] == q { return i; }
  return search_from(a, q, i + 1);
}

fn find_first(a: [i64], q: i64) -> i64
  requires len(a) <= 1000000
  ensures result == 0 - 1 || (0 <= result && result < len(a))
  ensures result >= 0 ==> a[result] == q && (forall k in 0..result: a[k] != q)
  ensures result < 0 ==> (forall k in 0..len(a): a[k] != q)
{
  return search_from(a, q, 0);
}

fn all_below_from(a: [i64], t: i64, i: i64) -> bool
  requires 0 <= i && i <= len(a)
  ensures result == (forall k in i..len(a): a[k] < t)
  decreases len(a) - i
{
  if i == len(a) { return true; }
  if a[i] >= t { return false; }
  return all_below_from(a, t, i + 1);
}

fn all_below(a: [i64], t: i64) -> bool
  requires len(a) <= 1000000
  ensures result == (forall k in 0..len(a): a[k] < t)
{
  return all_below_from(a, t, 0);
}
