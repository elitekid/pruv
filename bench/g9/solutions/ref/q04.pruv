// G9 q04 reference: nested buffer fields; copies are independent
struct Buf { data: [i64] }
struct Pair { left: Buf, right: Buf }

fn bumped_first(a: [i64], d: i64) -> i64 ! alloc
  requires 1 <= len(a) && len(a) <= 1000
  requires -1000000000 <= a[0] && a[0] <= 1000000000
  requires -1000000000 <= d && d <= 1000000000
  ensures result == 2 * a[0] + d
{
  let p: Pair = Pair { left: Buf { data: copy(a) }, right: Buf { data: copy(a) } };
  let mut q: Pair = p;
  let mut w: [i64] = copy(q.left.data);
  w[0] = w[0] + d;
  q.left = Buf { data: copy(w) };
  assert p.left.data[0] == a[0];
  assert q.right.data[0] == a[0];
  return p.left.data[0] + q.left.data[0];
}

fn swapped_lengths(a: [i64], b: [i64]) -> i64 ! alloc
  requires len(a) <= 1000 && len(b) <= 1000
  ensures result == 1000 * len(b) + len(a)
{
  let p: Pair = Pair { left: Buf { data: copy(a) }, right: Buf { data: copy(b) } };
  let mut q: Pair = p;
  let t: Buf = q.left;
  q.left = q.right;
  q.right = t;
  assert len(p.left.data) == len(a);
  return 1000 * len(q.left.data) + len(q.right.data);
}
