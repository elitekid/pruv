// Lair cellText (src/documents/sheets.ts), commit 698e1bd1, the string branch:
// value.replace(/\r?\n/g, ' ').trim(). Every "\r\n" and every "\n" becomes one space (a lone "\r" stays),
// then the white space of ECMAScript String.prototype.trim is cut from both ends: U+0009..U+000D, U+0020,
// U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029, U+202F, U+205F, U+3000 and U+FEFF.
// Domain: well-formed strings (no lone surrogates), at most 10^12 UTF-8 bytes. The result is never longer
// than the input.

// End of the character starting at boundary i.
fn next(s: str, i: i64) -> i64
  requires 0 <= i && i < len(s)
  ensures i < result && result <= len(s)
  ensures is_char_boundary(s, result)
{
  let mut j: i64 = i + 1;
  while j < len(s) && !is_char_boundary(s, j)
    invariant i < j && j <= len(s)
    decreases len(s) - j
  {
    j = j + 1;
  }
  return j;
}

// Whether the character starting at boundary i is trim white space, read from its UTF-8 bytes.
fn space(s: str, i: i64) -> bool
  requires 0 <= i && i < len(s)
{
  let b: i64 = s[i];
  if (9 <= b && b <= 13) || b == 32 { return true; }
  if b == 194 {
    // U+00A0: C2 A0
    return i + 1 < len(s) && s[i + 1] == 160;
  }
  if i + 2 >= len(s) { return false; }
  let c: i64 = s[i + 1];
  let d: i64 = s[i + 2];
  // U+1680: E1 9A 80
  if b == 225 { return c == 154 && d == 128; }
  if b == 226 {
    // U+2000..U+200A: E2 80 80..8A; U+2028, U+2029: E2 80 A8, A9; U+202F: E2 80 AF; U+205F: E2 81 9F
    if c == 128 { return (128 <= d && d <= 138) || d == 168 || d == 169 || d == 175; }
    return c == 129 && d == 159;
  }
  // U+3000: E3 80 80
  if b == 227 { return c == 128 && d == 128; }
  // U+FEFF: EF BB BF
  if b == 239 { return c == 187 && d == 191; }
  return false;
}

pub fn cell_str(s: str) -> str ! alloc
  requires len(s) <= 1000000000000
  ensures len(result) <= len(s)
{
  // Pass 1: "\r\n" and "\n" become " ".
  let mut out: String = string_new();
  let mut i: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s)
    invariant is_char_boundary(s, i)
    invariant len(out) <= i
    decreases len(s) - i
  {
    // "\r" is one byte, so its end j is the start of the "\n" that may follow.
    let j: i64 = next(s, i);
    if s[i] == 13 && j < len(s) && s[j] == 10 {
      out = string_push_str(move out, " ");
      i = next(s, j);
    } else {
      if s[i] == 10 {
        out = string_push_str(move out, " ");
      } else {
        out = string_push_str(move out, substr(s, i, j));
      }
      i = j;
    }
  }
  let o: str = string_to_str(out);
  // Pass 2: a is the start of the first character that is not white space, b the end of the last one.
  let mut a: i64 = 0;
  let mut b: i64 = 0;
  let mut found: bool = false;
  let mut k: i64 = 0;
  while k < len(o)
    invariant 0 <= a && a <= b && b <= k && k <= len(o)
    invariant is_char_boundary(o, k)
    invariant is_char_boundary(o, a)
    invariant is_char_boundary(o, b)
    decreases len(o) - k
  {
    let e: i64 = next(o, k);
    if !space(o, k) {
      if !found {
        a = k;
        found = true;
      }
      b = e;
    }
    k = e;
  }
  return substr(o, a, b);
}
