// Lair luhn (src/shared/common-memory.ts, commit 698e1bd1), the Luhn check that sensitiveReason uses to
// tell a card number from other digit runs: from the last UTF-16 unit to the first, add (unit - 48),
// doubling every second one (and taking 9 off a doubled value over 9), and pass when the sum is a
// multiple of 10. The original does not check for digits, so any text has an answer.
// Pruv decodes the UTF-8 bytes into UTF-16 units in one forward pass and keeps two sums: one as if the
// even unit positions were doubled and one as if the odd ones were. The unit count at the end says
// which one is the right-to-left sum: the last unit is never doubled.
// Domain: text at most 10^10 UTF-8 bytes (the sum then stays far inside the exact JS integers).

fn luhn_value(u: i64, dbl: bool) -> i64
  requires 0 <= u && u <= 65535
  ensures -96 <= result && result <= 131070
{
  let mut v: i64 = u - 48;
  if dbl {
    v = v * 2;
    if v > 9 { v = v - 9; }
  }
  return v;
}

pub fn luhn(s: str) -> bool
  requires len(s) <= 10000000000
{
  let n: i64 = len(s);
  let mut i: i64 = 0;
  let mut k: i64 = 0;
  let mut even: i64 = 0;
  let mut odd: i64 = 0;
  while i < n
    invariant 0 <= k && k <= i && i <= n
    invariant -96 * k <= even && even <= 131070 * k
    invariant -96 * k <= odd && odd <= 131070 * k
    decreases n - i
  {
    let x: i64 = s[i];
    if x < 128 {
      even = even + luhn_value(x, k % 2 == 0);
      odd = odd + luhn_value(x, k % 2 == 1);
      k = k + 1;
      i = i + 1;
    } else if x < 224 && i + 1 < n {
      let u: i64 = (x % 32) * 64 + s[i + 1] % 64;
      even = even + luhn_value(u, k % 2 == 0);
      odd = odd + luhn_value(u, k % 2 == 1);
      k = k + 1;
      i = i + 2;
    } else if x < 240 && i + 2 < n {
      let u: i64 = (x % 16) * 4096 + (s[i + 1] % 64) * 64 + s[i + 2] % 64;
      even = even + luhn_value(u, k % 2 == 0);
      odd = odd + luhn_value(u, k % 2 == 1);
      k = k + 1;
      i = i + 3;
    } else if x >= 240 && i + 3 < n {
      let c: i64 = (x % 8) * 262144 + (s[i + 1] % 64) * 4096 + (s[i + 2] % 64) * 64 + s[i + 3] % 64 - 65536;
      let mut hi: i64 = 55296;
      let mut lo: i64 = 56320;
      if 0 <= c && c < 1048576 {
        hi = 55296 + c / 1024;
        lo = 56320 + c % 1024;
      }
      even = even + luhn_value(hi, k % 2 == 0);
      odd = odd + luhn_value(hi, k % 2 == 1);
      even = even + luhn_value(lo, k % 2 == 1);
      odd = odd + luhn_value(lo, k % 2 == 0);
      k = k + 2;
      i = i + 4;
    } else {
      i = n;
    }
  }
  let mut sum: i64 = odd;
  if k % 2 == 0 { sum = even; }
  if sum < 0 { sum = -sum; }
  return sum % 10 == 0;
}
