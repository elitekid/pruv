// Lair extractSheets grouping (src/documents/sheets.ts): the row pieces of one sheet, in order, grouped
// into chunks. A piece joins the open chunk unless the chunk is nonempty and either the chunk size plus
// the piece length plus 1 passes max or the piece row is more than FAR_ROWS = 50 rows after the row of
// the last piece in the chunk; the size starts at the UTF-16 length of the header "[시트: name]\n" and
// grows by the piece length plus 1 (the '\n' join). Per piece the host passes the row, col1, col2 and
// the UTF-16 length of the piece text. The result is per chunk [from, to, row1, row2, col1, col2]:
// pieces from..to (inclusive) and the minimum row, maximum row, minimum col1 and maximum col2 of them.
// Malformed input (arrays of different lengths, a row or column outside 1..10^15, a length outside
// 0..2^40) gives the single record [-1].
// range_of is Lair rangeOf: "<letters col1><row1>" for a single cell, else "<c1><r1>:<c2><r2>".

fn col_letters(col: i64) -> str ! alloc
  requires 0 <= col && col <= 1000000000000000
  ensures forall i in 0..len(result): 65 <= result[i] && result[i] <= 90
  ensures (len(result) == 0) == (col == 0)
  ensures len(result) <= col
  ensures col < 26 ==> len(result) <= 1
  ensures col < 676 ==> len(result) <= 2
  ensures col < 17576 ==> len(result) <= 3
  ensures col < 456976 ==> len(result) <= 4
  ensures col < 11881376 ==> len(result) <= 5
  ensures col < 308915776 ==> len(result) <= 6
  ensures col < 8031810176 ==> len(result) <= 7
  ensures col < 208827064576 ==> len(result) <= 8
  ensures col < 5429503678976 ==> len(result) <= 9
  ensures col < 141167095653376 ==> len(result) <= 10
  ensures col < 3670344486987776 ==> len(result) <= 11
  decreases col
{
  if col == 0 { return ""; }
  let prefix: str = col_letters((col-1)/26);
  let alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let digit: i64 = (col-1)%26;
  let letter: str = substr(alphabet, digit, digit+1);
  let mut out: String = string_new();
  out = string_push_str(move out, prefix);
  out = string_push_str(move out, letter);
  return string_to_str(out);
}

// JS String(n) for an integer 0 <= n <= 10^15.
fn digits(n: i64) -> str ! alloc
  requires 0 <= n && n <= 1000000000000000
  ensures len(result) <= 16
{
  let ten: str = "0123456789";
  let mut out: String = string_new();
  let mut p: i64 = 1000000000000000;
  let mut k: i64 = 0;
  while k < 16
    invariant 0 <= k && k <= 16
    invariant 0 <= p && p <= 1000000000000000
    invariant len(out) <= k
    decreases 16 - k
  {
    if p > 0 {
      let d: i64 = (n / p) % 10;
      if len(out) > 0 || d != 0 || p == 1 {
        out = string_push_str(move out, substr(ten, d, d + 1));
      }
    }
    p = p / 10;
    k = k + 1;
  }
  return string_to_str(out);
}

pub fn range_of(row1: i64, row2: i64, col1: i64, col2: i64) -> str ! alloc
  requires 1 <= row1 && row1 <= 1000000000000000 && 1 <= row2 && row2 <= 1000000000000000
  requires 1 <= col1 && col1 <= 1000000000000000 && 1 <= col2 && col2 <= 1000000000000000
{
  let mut out: String = string_new();
  out = string_push_str(move out, col_letters(col1));
  out = string_push_str(move out, digits(row1));
  if row1 != row2 || col1 != col2 {
    out = string_push_str(move out, ":");
    out = string_push_str(move out, col_letters(col2));
    out = string_push_str(move out, digits(row2));
  }
  return string_to_str(out);
}

fn put(inout out: [i64], k: i64, f: i64, t: i64, r1: i64, r2: i64, c1: i64, c2: i64) -> i64
  requires 0 <= k && k <= 1000000000000
  ensures len(out) == len(old(out))
  ensures result == k + 1
{
  if 6 * k + 5 < len(out) {
    out[6 * k] = f;
    out[6 * k + 1] = t;
    out[6 * k + 2] = r1;
    out[6 * k + 3] = r2;
    out[6 * k + 4] = c1;
    out[6 * k + 5] = c2;
  }
  return k + 1;
}

// The whole grouping. Writes records while there is room and returns their number (or -1 for malformed
// input), so a first call with an empty out counts and a second one fills.
fn chunks_into(rows: [i64], col1s: [i64], col2s: [i64], lens: [i64], header: i64, max: i64, inout out: [i64]) -> i64
  requires 0 <= header && header <= 1099511627776
  requires 1 <= max && max <= 1099511627776
  requires len(rows) <= 1000000000000
  ensures len(out) == len(old(out))
  ensures -1 <= result && result <= len(rows)
{
  let n: i64 = len(rows);
  if len(col1s) != n || len(col2s) != n || len(lens) != n { return -1; }
  let mut k: i64 = 0;
  let mut active: i64 = 0;
  let mut f: i64 = 0;
  let mut last: i64 = 0;
  let mut r1: i64 = 0;
  let mut r2: i64 = 0;
  let mut c1: i64 = 0;
  let mut c2: i64 = 0;
  let mut size: i64 = header;
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && len(out) == len(old(out))
    invariant 0 <= k && k + active <= j
    invariant 0 <= active && active <= 1 && (active == 1 || size == header)
    invariant header <= size && size <= header + 1099511627777
    invariant active == 0 || (0 <= f && f < j && 1 <= last && last <= 1000000000000000)
    decreases n - j
  {
    let row: i64 = rows[j];
    let a: i64 = col1s[j];
    let b: i64 = col2s[j];
    let u: i64 = lens[j];
    if row < 1 || row > 1000000000000000 || a < 1 || a > 1000000000000000 { return -1; }
    if b < 1 || b > 1000000000000000 || u < 0 || u > 1099511627776 { return -1; }
    if active == 1 && (size + u + 1 > max || row - last > 50) {
      k = put(inout out, k, f, j - 1, r1, r2, c1, c2);
      active = 0;
      size = header;
    }
    if active == 0 {
      f = j; r1 = row; r2 = row; c1 = a; c2 = b; active = 1;
    } else {
      if row < r1 { r1 = row; }
      if row > r2 { r2 = row; }
      if a < c1 { c1 = a; }
      if b > c2 { c2 = b; }
    }
    last = row;
    size = size + u + 1;
    j = j + 1;
  }
  if active == 1 { k = put(inout out, k, f, n - 1, r1, r2, c1, c2); }
  return k;
}

pub fn sheet_groups(rows: [i64], col1s: [i64], col2s: [i64], lens: [i64], header: i64, max: i64) -> [i64] ! alloc
  requires 0 <= header && header <= 1099511627776
  requires 1 <= max && max <= 1099511627776
  requires len(rows) <= 100000000000
{
  let mut none: [i64] = alloc(0, 0);
  let k: i64 = chunks_into(rows, col1s, col2s, lens, header, max, inout none);
  if k < 0 {
    let bad: [i64] = alloc(1, -1);
    return bad;
  }
  let mut out: [i64] = alloc(6 * k, 0);
  let filled: i64 = chunks_into(rows, col1s, col2s, lens, header, max, inout out);
  return out;
}
