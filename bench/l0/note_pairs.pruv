// Lair addNote / addMissing (src/documents/context.ts) and their helper padded: each call pushes one text to a
// list (draft.notes or draft.missing) and keeps the optional key list beside it (notesI18n or missingI18n). The key
// list stays absent until the first call that carries a key; from then on every call pads it with nulls up to the
// text list's length and pushes its key, or null. Only that bookkeeping is here; the host numbers the WireText
// keys.
// Input: n0 texts already in the list; has == 1 when the key list exists, with its entries in pre (0 = null,
// k > 0 = key k); has == 0 means no key list (pre is then empty). keys[j] is the key of call j (0 = none).
// Result: [0] when the key list is still absent after all calls, otherwise [1, entries of the final key list...].
// Domain: n0, len(pre) and len(keys) at most 10^7 each, keys and entries 0..10^9. The ensures pin the result
// down entry by entry: with no calls an existing key list is left as it is; otherwise the old entries stay, the
// gap up to the old text count is null and call j's key lands at base + j, where base is the larger of n0 and
// len(pre). So after at least one call, when the key list was not longer than the text list (what addNote alone
// keeps), the two lists end with the same length.

pub fn note_pairs(n0: i64, has: i64, pre: [i64], keys: [i64]) -> [i64] ! alloc
  requires 0 <= n0 && n0 <= 10000000
  requires has == 0 || has == 1
  requires len(pre) <= 10000000
  requires has == 1 || len(pre) == 0
  requires len(keys) <= 10000000
  requires forall i in 0..len(pre): 0 <= pre[i] && pre[i] <= 1000000000
  requires forall j in 0..len(keys): 0 <= keys[j] && keys[j] <= 1000000000
  ensures result[0] == 0 || result[0] == 1
  ensures result[0] == 1 || (has == 0 && len(result) == 1)
  ensures result[0] == 1 || forall j in 0..len(keys): keys[j] == 0
  ensures result[0] == 0 || has == 1 || exists j in 0..len(keys): keys[j] > 0
  ensures result[0] == 0 || len(keys) > 0 || len(result) == 1 + len(pre)
  ensures result[0] == 0 || len(keys) == 0 || len(pre) > n0 || len(result) == 1 + n0 + len(keys)
  ensures result[0] == 0 || len(pre) <= n0 || len(result) == 1 + len(pre) + len(keys)
  ensures result[0] == 0 || forall i in 0..len(pre): result[1 + i] == pre[i]
  ensures result[0] == 0 || len(keys) == 0 || forall i in 0..n0: i < len(pre) || result[1 + i] == 0
  ensures result[0] == 0 || len(pre) > n0 || forall j in 0..len(keys): result[1 + n0 + j] == keys[j]
  ensures result[0] == 0 || len(pre) <= n0 || forall j in 0..len(keys): result[1 + len(pre) + j] == keys[j]
{
  let m: i64 = len(keys);
  let p: i64 = len(pre);
  let mut on: i64 = has;
  let mut w: i64 = 0;
  let mut j: i64 = 0;
  while j < m
    invariant 0 <= j && j <= m
    invariant on == 0 || on == 1
    invariant on == 1 || (has == 0 && forall q in 0..j: keys[q] == 0)
    invariant on == 0 || has == 1 || (0 <= w && w < j && keys[w] > 0)
    decreases m - j
  {
    if keys[j] > 0 && on == 0 { on = 1; w = j; }
    j = j + 1;
  }
  if on == 0 {
    let none: [i64] = alloc(1, 0);
    return none;
  }
  let mut base: i64 = n0;
  if p > n0 || m == 0 { base = p; }
  let mut out: [i64] = alloc(1 + base + m, 0);
  out[0] = 1;
  let mut i: i64 = 0;
  while i < p
    invariant 0 <= i && i <= p && p <= base
    invariant len(out) == 1 + base + m && out[0] == 1
    invariant forall q in 0..i: out[1 + q] == pre[q]
    invariant forall q in p..base: out[1 + q] == 0
    decreases p - i
  {
    out[1 + i] = pre[i];
    i = i + 1;
  }
  let mut k: i64 = 0;
  while k < m
    invariant 0 <= k && k <= m
    invariant len(out) == 1 + base + m && out[0] == 1
    invariant forall q in 0..p: out[1 + q] == pre[q]
    invariant forall q in p..base: out[1 + q] == 0
    invariant forall q in 0..k: out[1 + base + q] == keys[q]
    decreases m - k
  {
    out[1 + base + k] = keys[k];
    k = k + 1;
  }
  return out;
}
