// Lair tokenize (src/documents/search.ts at 5d974738): text.toLowerCase(), the words of /[\p{L}\p{N}]+/gu,
// each word split into runs of the four CJK scripts (Hangul, Han, Hiragana, Katakana) and of the rest;
// a run is pushed whole unless its first UTF-16 unit is a CJK character (so a run starting with a
// supplementary-plane Han character is pushed whole); a CJK run of one character is pushed, one of 3..8
// characters is pushed whole, and every CJK run of two or more characters gives its two-character pairs.
// toLowerCase is the ICU root full lowercase: the simple mapping, U+0130 to "i" U+0307, and U+03A3 to
// final sigma U+03C2 when a Cased character comes before it past Case_Ignorable ones and none comes after
// it past Case_Ignorable ones (ICU tests Case_Ignorable first).
// Input: UTF-8 text. Output: [token count, then per token: n, n code points]; [-1] past 2^40 slots.
// The tables are Unicode 17.0 (ICU 78.2), generated by gen_tokenize_tables.py.

fn clen(s: str, i: i64, b: i64) -> i64
  requires 0 <= i && i < b && b <= len(s)
  ensures 1 <= result && result <= 4 && i + result <= b
{
  let x: i64 = s[i];
  let mut l: i64 = 1;
  if x >= 192 { l = 2; }
  if x >= 224 { l = 3; }
  if x >= 240 { l = 4; }
  if i + l > b { l = b - i; }
  return l;
}

// The code point of the l bytes at i.
fn cp_at(s: str, i: i64, l: i64) -> i64
  requires 0 <= i && 1 <= l && l <= 4 && i + l <= len(s)
  ensures 0 <= result && result < 2097152
{
  let x: i64 = s[i];
  if l == 1 { return x; }
  let mut v: i64 = x % 32;
  if l == 3 { v = x % 16; }
  if l == 4 { v = x % 8; }
  let mut k: i64 = 1;
  while k < l
    invariant 1 <= k && k <= l && 0 <= v && v < 2097152
    decreases l - k
  {
    let y: i64 = s[i + k];
    v = (v * 64 + y % 64) % 2097152;
    k = k + 1;
  }
  return v;
}

fn put(inout out: [i64], p: i64, v: i64) -> i64
  requires 0 <= p && p <= 1125899906842624
  ensures len(out) == len(old(out))
  ensures 0 <= result && result <= 1125899906842624
{
  if p < len(out) { out[p] = v; }
  if p < 1125899906842624 { return p + 1; }
  return p;
}

fn set(inout out: [i64], at: i64, v: i64) -> ()
  ensures len(out) == len(old(out))
{
  if 0 <= at && at < len(out) { out[at] = v; }
}

// A Cased character before u[i], past Case_Ignorable ones.
fn cased_before(u: [i64], i: i64) -> bool
  requires 0 <= i && i <= len(u)
{
  let mut j: i64 = i - 1;
  let mut r: i64 = 2;
  while j >= 0 && r == 2
    invariant -1 <= j && j < i
    decreases j + 1
  {
    r = ct(u[j]);
    j = j - 1;
  }
  return r == 1;
}

// A Cased character after u[i], past Case_Ignorable ones, before u[m].
fn cased_after(u: [i64], i: i64, m: i64) -> bool
  requires 0 <= i && i < m && m <= len(u)
{
  let mut j: i64 = i + 1;
  let mut r: i64 = 2;
  while j < m && r == 2
    invariant i < j && j <= m
    decreases m - j
  {
    r = ct(u[j]);
    j = j + 1;
  }
  return r == 1;
}

// Push w[a..b] as one token.
fn push(w: [i64], a: i64, b: i64, inout out: [i64], q0: i64) -> i64
  requires 0 <= a && a < b && b <= len(w)
  requires 0 <= q0 && q0 <= 1125899906842624
  ensures len(out) == len(old(out))
  ensures 0 <= result && result <= 1125899906842624
{
  let mut q: i64 = put(inout out, q0, b - a);
  let mut k: i64 = a;
  while k < b
    invariant a <= k && k <= b && 0 <= q && q <= 1125899906842624 && len(out) == len(old(out))
    decreases b - k
  {
    q = put(inout out, q, w[k]);
    k = k + 1;
  }
  return q;
}

// The end of the run of class k from a, before b.
fn run_end(w: [i64], a: i64, b: i64, k: i64) -> i64
  requires 0 <= a && a < b && b <= len(w)
  ensures a < result && result <= b
{
  let mut e: i64 = a + 1;
  while e < b && wc(w[e]) == k
    invariant a < e && e <= b
    decreases b - e
  {
    e = e + 1;
  }
  return e;
}

// The tokens of the word w[a..b]; next slot in q[0], token count in q[1].
fn word(w: [i64], a: i64, b: i64, inout out: [i64], inout q: [i64]) -> ()
  requires 0 <= a && a < b && b <= len(w) && len(q) == 2
  requires 0 <= q[0] && q[0] <= 1125899906842624 && 0 <= q[1] && q[1] <= 1125899906842624
  ensures len(out) == len(old(out)) && len(q) == 2
  ensures 0 <= q[0] && q[0] <= 1125899906842624 && 0 <= q[1] && q[1] <= 1125899906842624
{
  let mut p: i64 = q[0];
  let mut cnt: i64 = q[1];
  let mut r: i64 = a;
  while r < b
    invariant a <= r && r <= b && 0 <= p && p <= 1125899906842624 && 0 <= cnt && cnt <= 1125899906842624
    invariant len(out) == len(old(out)) && len(q) == 2
    decreases b - r
  {
    let k: i64 = wc(w[r]);
    let e: i64 = run_end(w, r, b, k);
    if k != 2 || w[r] > 65535 || e - r == 1 {
      p = push(w, r, e, inout out, p);
      if cnt < 1125899906842624 { cnt = cnt + 1; }
    } else {
      if e - r >= 3 && e - r <= 8 {
        p = push(w, r, e, inout out, p);
        if cnt < 1125899906842624 { cnt = cnt + 1; }
      }
      let mut j: i64 = r;
      while j + 1 < e
        invariant r <= j && j < e && 0 <= p && p <= 1125899906842624 && 0 <= cnt && cnt <= 1125899906842624
        invariant len(out) == len(old(out))
        decreases e - j
      {
        p = push(w, j, j + 2, inout out, p);
        if cnt < 1125899906842624 { cnt = cnt + 1; }
        j = j + 1;
      }
    }
    r = e;
  }
  q[0] = p;
  q[1] = cnt;
}

// The output of w[0..m] into out; the slot count.
fn emit(w: [i64], m: i64, inout out: [i64]) -> i64 ! alloc
  requires 0 <= m && m <= len(w)
  ensures len(out) == len(old(out))
  ensures 0 <= result && result <= 1125899906842624
{
  let mut q: [i64] = alloc(2, 0);
  q[0] = 1;
  let mut i: i64 = 0;
  while i < m
    invariant 0 <= i && i <= m && len(q) == 2 && len(out) == len(old(out))
    invariant 0 <= q[0] && q[0] <= 1125899906842624 && 0 <= q[1] && q[1] <= 1125899906842624
    decreases m - i
  {
    if wc(w[i]) == 0 {
      i = i + 1;
    } else {
      let mut e: i64 = i + 1;
      while e < m && wc(w[e]) != 0
        invariant i < e && e <= m
        decreases m - e
      {
        e = e + 1;
      }
      word(w, i, e, inout out, inout q);
      i = e;
    }
  }
  set(inout out, 0, q[1]);
  return q[0];
}

pub fn tokenize(s: str) -> [i64] ! alloc
  requires len(s) <= 274877906944
{
  let n: i64 = len(s);
  let mut u: [i64] = alloc(n + 1, 0);
  let mut nu: i64 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && 0 <= nu && nu <= i && len(u) == n + 1
    decreases n - i
  {
    let l: i64 = clen(s, i, n);
    u[nu] = cp_at(s, i, l);
    nu = nu + 1;
    i = i + l;
  }
  let mut w: [i64] = alloc(2 * nu + 1, 0);
  let mut m: i64 = 0;
  let mut k: i64 = 0;
  while k < nu
    invariant 0 <= k && k <= nu && 0 <= m && m <= 2 * k && len(w) == 2 * nu + 1
    decreases nu - k
  {
    let c: i64 = u[k];
    if c == 304 {
      w[m] = 105;
      w[m + 1] = 775;
      m = m + 2;
    } else {
      if c == 931 {
        w[m] = 963;
        if cased_before(u, k) && !cased_after(u, k, nu) { w[m] = 962; }
      } else {
        w[m] = lw1(c);
      }
      m = m + 1;
    }
    k = k + 1;
  }
  let mut none: [i64] = alloc(0, 0);
  let t: i64 = emit(w, m, inout none);
  if t > 1099511627776 {
    let bad: [i64] = alloc(1, -1);
    return bad;
  }
  let mut out: [i64] = alloc(t, 0);
  let f: i64 = emit(w, m, inout out);
  return out;
}

