// Lair shrinkJpeg (src/documents/image-shrink.ts), the verified parts: the EXIF orientation reader
// (readOrientation + orientationFromTiff), the scaled size, the box (area-average) shrink and the
// orientation transform of the decoded RGBA pixels. JPEG decoding and encoding stay in the host (jpeg-js).
// Every byte read and every pixel write is proved in bounds. The pixel reads and writes also carry
// guards (a read past the data gives 0, a write outside the output is skipped) and the box edges are
// capped at the image size; with len(data) == 4 * width * height, which the bridge checks, none of them
// fires, so the result is exactly TS's. Rounding is exact integer arithmetic; in this domain it equals
// TS's float Math.round / Math.floor (the true quotient is either exactly a half or at least
// 1 / (2 * divisor) away from one, far more than the float error).
// Domain: 1 <= width, height <= 65535 (the JPEG limit), 1 <= orientation <= 8.

// Big- or little-endian 16-bit value at i.
fn u16(b: [u8], i: i64, little: i64) -> i64
  requires 0 <= i && i + 2 <= len(b)
  ensures 0 <= result && result <= 65535
{
  if little == 1 { return b[i] + 256 * b[i + 1]; }
  return 256 * b[i] + b[i + 1];
}

// Big- or little-endian unsigned 32-bit value at i.
fn u32(b: [u8], i: i64, little: i64) -> i64
  requires 0 <= i && i + 4 <= len(b)
  ensures 0 <= result && result <= 4294967295
{
  if little == 1 { return b[i] + 256 * b[i + 1] + 65536 * b[i + 2] + 16777216 * b[i + 3]; }
  return 16777216 * b[i] + 65536 * b[i + 1] + 256 * b[i + 2] + b[i + 3];
}

// orientationFromTiff: the orientation tag (0x0112) of IFD0 of the TIFF header at tiff, inside ..end.
fn orientation_from_tiff(b: [u8], tiff: i64, end: i64) -> i64
  requires 0 <= tiff && tiff <= end && end <= len(b) && len(b) <= 1099511627776
  ensures 1 <= result && result <= 8
{
  if tiff + 8 > end { return 1; }
  let mut little: i64 = 0;
  if b[tiff] == 73 && b[tiff + 1] == 73 {
    little = 1;
  } else if b[tiff] == 77 && b[tiff + 1] == 77 {
    little = 0;
  } else {
    return 1;
  }
  if u16(b, tiff + 2, little) != 42 { return 1; }
  let ifd: i64 = tiff + u32(b, tiff + 4, little);
  if ifd + 2 > end { return 1; }
  let count: i64 = u16(b, ifd, little);
  let mut i: i64 = 0;
  while i < count
    invariant 0 <= i && i <= count
    decreases count - i
  {
    let entry: i64 = ifd + 2 + i * 12;
    if entry + 12 > end { return 1; }
    if u16(b, entry, little) == 274 {
      let value: i64 = u16(b, entry + 8, little);
      if value >= 1 && value <= 8 { return value; }
      return 1;
    }
    i = i + 1;
  }
  return 1;
}

// readOrientation: walk the JPEG markers after SOI to the APP1 Exif segment. 1 if absent or broken.
pub fn jpeg_orientation(b: [u8]) -> i64
  requires len(b) <= 1099511627776
  ensures 1 <= result && result <= 8
{
  let mut pos: i64 = 2;
  while pos + 4 <= len(b)
    invariant 2 <= pos && pos <= len(b) + 65537
    decreases len(b) - pos
  {
    if b[pos] != 255 { return 1; }
    let marker: i64 = b[pos + 1];
    if marker == 255 {
      pos = pos + 1;
    } else if marker == 216 || marker == 1 || (marker >= 208 && marker <= 215) {
      pos = pos + 2;
    } else {
      if marker == 218 || marker == 217 { return 1; }
      let length: i64 = 256 * b[pos + 2] + b[pos + 3];
      if length < 2 { return 1; }
      let mut end: i64 = pos + 2 + length;
      if end > len(b) { end = len(b); }
      if marker == 225 && pos + 10 <= end && b[pos + 4] == 69 && b[pos + 5] == 120 && b[pos + 6] == 105
        && b[pos + 7] == 102 && b[pos + 8] == 0 && b[pos + 9] == 0 {
        return orientation_from_tiff(b, pos + 10, end);
      }
      pos = pos + 2 + length;
    }
  }
  return 1;
}

// One scaled side: side itself if the long side fits in 2000, else max(1, round(side * 2000 / long)).
fn scaled_side(side: i64, long: i64) -> i64
  requires 1 <= side && side <= long && long <= 65535
  ensures 1 <= result && result <= 2000 && result <= long
{
  if long <= 2000 { return side; }
  let mut v: i64 = (4000 * side + long) / (2 * long);
  if v < 1 { v = 1; }
  if v > 2000 { v = 2000; }
  return v;
}

fn long_side(width: i64, height: i64) -> i64
  requires 1 <= width && width <= 65535 && 1 <= height && height <= 65535
  ensures width <= result && height <= result && result <= 65535
{
  if width >= height { return width; }
  return height;
}

// Width and height after the shrink, before the orientation transform.
pub fn shrink_width(width: i64, height: i64) -> i64
  requires 1 <= width && width <= 65535 && 1 <= height && height <= 65535
  ensures 1 <= result && result <= 2000
{
  return scaled_side(width, long_side(width, height));
}

pub fn shrink_height(width: i64, height: i64) -> i64
  requires 1 <= width && width <= 65535 && 1 <= height && height <= 65535
  ensures 1 <= result && result <= 2000
{
  return scaled_side(height, long_side(width, height));
}

// The low box edge floor(o * size / out) and the high one max(lo + 1, floor((o + 1) * size / out)),
// capped at size (never reached: o < out gives floor(o * size / out) < size and the high edge <= size).
fn edge_lo(o: i64, size: i64, out: i64) -> i64
  requires 0 <= o && o < out && out <= 2000 && 1 <= size && size <= 65535
  ensures 0 <= result && result < size
{
  let mut v: i64 = (o * size) / out;
  if v > size - 1 { v = size - 1; }
  return v;
}

fn edge_hi(o: i64, size: i64, out: i64, lo: i64) -> i64
  requires 0 <= o && o < out && out <= 2000 && 1 <= size && size <= 65535 && 0 <= lo && lo < size
  ensures lo < result && result <= size
{
  let mut v: i64 = ((o + 1) * size) / out;
  if v < lo + 1 { v = lo + 1; }
  if v > size { v = size; }
  return v;
}

// The source byte at i, or 0 past the data.
fn at(data: [u8], i: i64) -> i64
  requires 0 <= i
  ensures 0 <= result && result <= 255
{
  if i < len(data) { return data[i]; }
  return 0;
}

// Math.round(s / n) for 0 <= s, written into a Uint8ClampedArray (so above 255 becomes 255).
fn avg(s: i64, n: i64) -> i64
  requires 0 <= s && s <= 1099511627776 && 1 <= n && n <= 4294967296
  ensures 0 <= result && result <= 255
{
  let v: i64 = (2 * s + n) / (2 * n);
  if v > 255 { return 255; }
  return v;
}

// boxShrink: RGBA width x height -> out_w x out_h by area average, alpha 255, into out (4 * out_w * out_h).
fn box_shrink(data: [u8], width: i64, height: i64, out_w: i64, out_h: i64, inout out: [u8]) -> ()
  requires 1 <= width && width <= 65535 && 1 <= height && height <= 65535
  requires 1 <= out_w && out_w <= 2000 && 1 <= out_h && out_h <= 2000
  ensures len(out) == len(old(out))
{
  let mut write: i64 = 0;
  let mut oy: i64 = 0;
  while oy < out_h
    invariant 0 <= oy && oy <= out_h && 0 <= write && len(out) == len(old(out))
    invariant write <= 4 * 2000 * oy
    decreases out_h - oy
  {
    let y0: i64 = edge_lo(oy, height, out_h);
    let y1: i64 = edge_hi(oy, height, out_h, y0);
    let mut ox: i64 = 0;
    while ox < out_w
      invariant 0 <= ox && ox <= out_w && 0 <= write && len(out) == len(old(out))
      invariant write <= 4 * 2000 * oy + 4 * ox
      decreases out_w - ox
    {
      let x0: i64 = edge_lo(ox, width, out_w);
      let x1: i64 = edge_hi(ox, width, out_w, x0);
      let mut r: i64 = 0;
      let mut g: i64 = 0;
      let mut b: i64 = 0;
      let mut y: i64 = y0;
      while y < y1
        invariant y0 <= y && y <= y1
        invariant 0 <= r && r <= 16711425 * (y - y0)
        invariant 0 <= g && g <= 16711425 * (y - y0)
        invariant 0 <= b && b <= 16711425 * (y - y0)
        decreases y1 - y
      {
        let mut read: i64 = (y * width + x0) * 4;
        let mut x: i64 = x0;
        while x < x1
          invariant x0 <= x && x <= x1 && 0 <= read
          invariant 0 <= r && r <= 16711425 * (y - y0) + 255 * (x - x0)
          invariant 0 <= g && g <= 16711425 * (y - y0) + 255 * (x - x0)
          invariant 0 <= b && b <= 16711425 * (y - y0) + 255 * (x - x0)
          invariant read <= (y * width + x) * 4
          decreases x1 - x
        {
          r = r + at(data, read);
          g = g + at(data, read + 1);
          b = b + at(data, read + 2);
          read = read + 4;
          x = x + 1;
        }
        y = y + 1;
      }
      let n: i64 = (y1 - y0) * (x1 - x0);
      if write + 3 < len(out) {
        out[write] = avg(r, n);
        out[write + 1] = avg(g, n);
        out[write + 2] = avg(b, n);
        out[write + 3] = 255;
      }
      write = write + 4;
      ox = ox + 1;
    }
    oy = oy + 1;
  }
}

// applyOrientation for orientation 2..8: move each 4-byte pixel of the width x height image src to its
// place in out (out_w = height and out_h = width for 5..8, else unchanged).
fn orient(src: [u8], width: i64, height: i64, orientation: i64, inout out: [u8]) -> ()
  requires 1 <= width && width <= 2000 && 1 <= height && height <= 2000
  requires 2 <= orientation && orientation <= 8
  ensures len(out) == len(old(out))
{
  let mut out_w: i64 = width;
  if orientation >= 5 { out_w = height; }
  let mut y: i64 = 0;
  while y < height
    invariant 0 <= y && y <= height && len(out) == len(old(out))
    decreases height - y
  {
    let mut x: i64 = 0;
    while x < width
      invariant 0 <= x && x <= width && len(out) == len(old(out))
      decreases width - x
    {
      let mut dx: i64 = x;
      let mut dy: i64 = y;
      if orientation == 2 {
        dx = width - 1 - x;
      } else if orientation == 3 {
        dx = width - 1 - x;
        dy = height - 1 - y;
      } else if orientation == 4 {
        dy = height - 1 - y;
      } else if orientation == 5 {
        dx = y;
        dy = x;
      } else if orientation == 6 {
        dx = height - 1 - y;
        dy = x;
      } else if orientation == 7 {
        dx = height - 1 - y;
        dy = width - 1 - x;
      } else {
        dx = y;
        dy = width - 1 - x;
      }
      let t: i64 = (dy * out_w + dx) * 4;
      let f: i64 = (y * width + x) * 4;
      if t + 3 < len(out) && f + 3 < len(src) {
        out[t] = src[f];
        out[t + 1] = src[f + 1];
        out[t + 2] = src[f + 2];
        out[t + 3] = src[f + 3];
      }
      x = x + 1;
    }
    y = y + 1;
  }
}

// The pixel part of shrinkJpeg: the upright, shrunk RGBA pixels, or an empty array where TS returns
// undefined because nothing needs doing (long side <= 2000 and orientation 1). The host gets the size
// from shrink_width / shrink_height, swapped for orientation 5..8.
pub fn shrink_pixels(data: [u8], width: i64, height: i64, orientation: i64) -> [u8] ! alloc
  requires 1 <= width && width <= 65535 && 1 <= height && height <= 65535
  requires 1 <= orientation && orientation <= 8
{
  if long_side(width, height) <= 2000 && orientation == 1 { return alloc(0, 0); }
  let sw: i64 = shrink_width(width, height);
  let sh: i64 = shrink_height(width, height);
  let mut scaled: [u8] = alloc(4 * sw * sh, 0);
  box_shrink(data, width, height, sw, sh, inout scaled);
  if orientation == 1 { return scaled; }
  let mut out: [u8] = alloc(4 * sw * sh, 0);
  orient(scaled, sw, sh, orientation, inout out);
  return out;
}
