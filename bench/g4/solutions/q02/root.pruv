// G4 q02 reference: a recursive tree service. The recursive type and every recursive function live in the child
// module crate::tree; the root exposes only scalar (i64 in, i64 out) host entries that build a tree internally.
mod tree;

// private root helper: the tree type never appears in a host entry
fn make(n: i64) -> crate::tree::Tree ! alloc
  requires 0 <= n && n <= 1000
  ensures size(result) == 2 * n + 1
{
  return crate::tree::build(0, n);
}

pub fn node_total(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 1000
  ensures result == n
{
  let t: crate::tree::Tree = make(n);
  return crate::tree::node_count(t);
}

pub fn leaf_total(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 1000
  ensures result == n + 1
{
  let t: crate::tree::Tree = make(n);
  return crate::tree::leaf_count(t);
}

pub fn tree_height(n: i64) -> i64 ! alloc
  requires 0 <= n && n <= 1000
  ensures 0 <= result && result <= 2 * n + 1
{
  let t: crate::tree::Tree = make(n);
  return crate::tree::height(t);
}
