// perf: arr_i64 와 같은 프로그램, N = 0 (프로세스 시작 비용 측정, 기대 출력 0).
fn main() -> () ! io, alloc {
  let mut a: [i64] = alloc(0, 0);
  let mut i: i64 = 0;
  while i < 0
    invariant 0 <= i && i <= 0
    invariant len(a) == 0
    decreases 0 - i
  {
    a[i] = i % 200;
    i = i + 1;
  }
  let mut c: i64 = 0;
  let mut j: i64 = 0;
  while j < 0
    invariant 0 <= j && j <= 0
    invariant len(a) == 0
    invariant 0 <= c && c <= j
    decreases 0 - j
  {
    let v: i64 = a[j];
    if v >= 100 {
      c = c + 1;
    }
    j = j + 1;
  }
  print(c);
}
