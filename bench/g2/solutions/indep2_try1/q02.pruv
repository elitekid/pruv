fn ascii_mask(a: [u8]) -> [u8] ! alloc
  requires len(a) <= 1_000_000
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): (a[k] < 128 ==> result[k] == a[k]) && (a[k] >= 128 ==> result[k] == 63)
{
  let mut b: [u8] = alloc(len(a), 0);
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(b) == len(a)
    invariant forall k in 0..i: (a[k] < 128 ==> b[k] == a[k]) && (a[k] >= 128 ==> b[k] == 63)
    decreases len(a) - i
  {
    let v: i64 = a[i];
    if v < 128 {
      b[i] = v;
    } else {
      b[i] = 63;
    }
    i = i + 1;
  }
  return b;
}
