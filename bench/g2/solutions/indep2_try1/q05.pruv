fn count_chars(s: str) -> i64
  requires len(s) <= 1_000_000
  ensures result == count(t in 0..len(s): s[t] < 128 || s[t] >= 192)
{
  let mut c: i64 = 0;
  let mut i: i64 = 0;
  while i < len(s)
    invariant 0 <= i && i <= len(s)
    invariant c == count(t in 0..i: s[t] < 128 || s[t] >= 192)
    decreases len(s) - i
  {
    let b: i64 = s[i];
    if b < 128 || b >= 192 {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}
