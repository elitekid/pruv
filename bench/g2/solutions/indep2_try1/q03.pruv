fn add_sat(a: [u8], d: i64) -> [u8] ! alloc
  requires -255 <= d && d <= 255
  requires len(a) <= 1_000_000
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): (a[k] + d <= 0 ==> result[k] == 0) && (a[k] + d >= 255 ==> result[k] == 255) && ((0 < a[k] + d && a[k] + d < 255) ==> result[k] == a[k] + d)
{
  let mut b: [u8] = alloc(len(a), 0);
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant len(b) == len(a)
    invariant forall k in 0..i: (a[k] + d <= 0 ==> b[k] == 0) && (a[k] + d >= 255 ==> b[k] == 255) && ((0 < a[k] + d && a[k] + d < 255) ==> b[k] == a[k] + d)
    decreases len(a) - i
  {
    let t: i64 = a[i] + d;
    if t <= 0 {
      b[i] = 0;
    } else if t >= 255 {
      b[i] = 255;
    } else {
      b[i] = t;
    }
    i = i + 1;
  }
  return b;
}
