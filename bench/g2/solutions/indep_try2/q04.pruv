fn longest_true_run(a: [bool]) -> i64
  requires len(a) <= 1_000_000
  ensures 0 <= result && result <= len(a)
  ensures exists s in 0..len(a) + 1: s + result <= len(a) && (forall k in s..s + result: a[k])
  ensures forall s in 0..len(a) + 1: forall t in s..len(a) + 1: (forall k in s..t: a[k]) ==> t - s <= result
{
  let mut i: i64 = 0;
  let mut cur: i64 = 0;
  let mut best: i64 = 0;
  let mut bstart: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant 0 <= cur && cur <= best
    invariant 0 <= best && best <= i
    invariant 0 <= bstart && bstart + best <= i
    invariant forall k in bstart..bstart + best: a[k]
    invariant forall k in i - cur..i: a[k]
    invariant forall s in 0..i + 1: (forall k in s..i: a[k]) ==> i - s <= cur
    invariant forall s in 0..i + 1: forall t in s..i + 1: (forall k in s..t: a[k]) ==> t - s <= best
    decreases len(a) - i
  {
    if a[i] {
      cur = cur + 1;
      if cur > best {
        best = cur;
        bstart = i + 1 - cur;
      }
    } else {
      cur = 0;
    }
    i = i + 1;
  }
  return best;
}
