fn count_less(a: [i64], x: i64) -> i64
  ensures 0 <= result && result <= len(a)
  ensures result == count(k in 0..len(a): a[k] < x)
{
  let mut c: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant 0 <= c && c <= i
    invariant c == count(k in 0..i: a[k] < x)
    decreases len(a) - i
  {
    if a[i] < x {
      c = c + 1;
    }
    i = i + 1;
  }
  return c;
}
