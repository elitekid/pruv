fn dot(a: [i64 | -1_000_000..=1_000_000; <=1_000_000], b: [i64 | -1_000_000..=1_000_000; <=1_000_000]) -> Result<i64>
  ensures is_ok(result) == (len(a) == len(b))
  ensures !is_ok(result) ==> err_val(result) == 1
  ensures is_ok(result) ==> ok_val(result) == sum(k in 0..len(a): a[k] * b[k])
{
  if len(a) != len(b) {
    return Err(1);
  }
  let mut s: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant s >= -1_000_000_000_000 * i && s <= 1_000_000_000_000 * i
    invariant s == sum(k in 0..i: a[k] * b[k])
    decreases len(a) - i
  {
    s = s + a[i] * b[i];
    i = i + 1;
  }
  return Ok(s);
}
