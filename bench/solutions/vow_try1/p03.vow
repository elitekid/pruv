fn is_sorted(a: [i64]) -> bool
  ensures result == (forall k in 1..len(a): a[k - 1] <= a[k])
{
  let mut i: i64 = 1;
  while i < len(a)
    invariant 1 <= i && (i <= len(a) || len(a) == 0)
    invariant forall k in 1..i: a[k - 1] <= a[k]
    decreases len(a) - i
  {
    if a[i - 1] > a[i] {
      return false;
    }
    i = i + 1;
  }
  return true;
}
