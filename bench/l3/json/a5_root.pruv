// Plain-array host wrappers. Size preconditions only bound flat output allocation.
mod json;
mod lex;
mod parse;
mod lines;

fn prefix(data: [i64], n: i64) -> [i64] ! alloc
  requires 0 <= n && n <= len(data)
{
  let mut out: [i64] = alloc(n, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(out) == n
    decreases n - i
  { out[i] = data[i]; i = i + 1; }
  return out;
}

// Triples (start,end,next), then (0,offset) for Done or (1,offset) for NeedMore.
pub fn split(data: [u8], is_final: bool) -> [i64] ! alloc
  requires len(data) <= 219902325554
{
  let mut out: [i64] = alloc(3 * len(data) + 2, 0);
  let mut offset: i64 = 0;
  let mut used: i64 = 0;
  while offset <= len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant 0 <= used && used <= 3 * offset
    invariant len(out) == 3 * len(data) + 2
    decreases len(data) - offset + 1
  {
    let step: crate::lines::JsonlStep = crate::lines::jsonl_next(data, offset, is_final);
    match step {
      crate::lines::JsonlStep::Line(start, end, next) => {
        out[used] = start; out[used + 1] = end; out[used + 2] = next;
        used = used + 3; offset = next;
      }
      crate::lines::JsonlStep::NeedMore => {
        out[used] = 1; out[used + 1] = offset;
        return prefix(out, used + 2);
      }
      crate::lines::JsonlStep::Done => {
        out[used] = 0; out[used + 1] = offset;
        return prefix(out, used + 2);
      }
    }
  }
  return prefix(out, used);
}

// Per physical line: [one-based line, accepted, absolute error or -1, kind, records].
pub fn import_lines(data: [u8], base: i64) -> [i64] ! alloc
  requires len(data) <= 219902325554
{
  let mut out: [i64] = alloc(5 * len(data), 0);
  let mut offset: i64 = 0;
  let mut line: i64 = 0;
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant 0 <= line && line <= offset
    invariant len(out) == 5 * len(data)
    decreases len(data) - offset
  {
    let step: crate::lines::JsonlStep = crate::lines::jsonl_next(data, offset, true);
    match step {
      crate::lines::JsonlStep::Line(start, end, next) => {
        let p: i64 = 5 * line;
        out[p] = line + 1;
        let parsed: crate::json::JsonParse = crate::lines::parse_range(data, start, end);
        match parsed {
          crate::json::JsonParse::Parsed(document) => {
            out[p + 1] = 1; out[p + 2] = -1; out[p + 3] = 0;
            out[p + 4] = len(document.tape) / 6;
          }
          crate::json::JsonParse::Failed(error) => {
            out[p + 1] = 0;
            out[p + 2] = crate::lines::absolute_offset(base, start, error.position);
            out[p + 3] = error.kind; out[p + 4] = 0;
          }
        }
        offset = next; line = line + 1;
      }
      crate::lines::JsonlStep::Done => { return prefix(out, 5 * line); }
      crate::lines::JsonlStep::NeedMore => { return prefix(out, 5 * line); }
    }
  }
  return prefix(out, 5 * line);
}

// [accepted, relative error or -1, kind, records, owned source length].
pub fn range_summary(data: [u8], lo: i64, hi: i64) -> [i64] ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(data)
{
  let mut out: [i64] = alloc(5, 0);
  let parsed: crate::json::JsonParse = crate::lines::parse_range(data, lo, hi);
  match parsed {
    crate::json::JsonParse::Parsed(document) => {
      out[0] = 1; out[1] = -1; out[3] = len(document.tape) / 6;
      out[4] = len(document.source);
    }
    crate::json::JsonParse::Failed(error) => { out[1] = error.position; out[2] = error.kind; }
  }
  return out;
}

pub fn absolute_offset(base: i64, start: i64, position: i64) -> i64
{ return crate::lines::absolute_offset(base, start, position); }
