// L3-1 A1 root: plain-array host wrappers for text.pruv and entry.pruv fixtures (root pub fns take [u8]
// and return [i64]). Byte inputs become str through the checked UTF-8 adapter; invalid UTF-8 gives [-1].
// Text ops return [0, ...bytes] ([-2] when a bound is out of range). Entry ops take a whole line and call
// parse_line: [9] not an object, [8, position] line defect. Field: [0,...bytes] Value, [1] Missing,
// [2,kind] Defect. Title: [0,rank,...bytes] Ranked, [1,0] NoTitle, [2,kind] Defect.
mod json;
mod lex;
mod parse;
mod lines;
mod jstr;
mod access;
mod text;
mod entry;

fn lead1(a: i64) -> [i64] ! alloc
{
  let mut out: [i64] = alloc(1, 0);
  out[0] = a;
  return out;
}

fn lead2(a: i64, b: i64) -> [i64] ! alloc
{
  let mut out: [i64] = alloc(2, 0);
  out[0] = a; out[1] = b;
  return out;
}

// lead followed by the bytes of s widened to i64.
fn widen(s: str, lead: [i64]) -> [i64] ! alloc
{
  if len(lead) > 2 || len(s) > 1000000000 { return lead1(-3); }
  let mut out: [i64] = alloc(len(lead) + len(s), 0);
  let mut i: i64 = 0;
  while i < len(lead)
    invariant 0 <= i && i <= len(lead) && len(out) == len(lead) + len(s)
    decreases len(lead) - i
  { out[i] = lead[i]; i = i + 1; }
  let mut j: i64 = 0;
  while j < len(s)
    invariant 0 <= j && j <= len(s) && len(out) == len(lead) + len(s)
    decreases len(s) - j
  { out[len(lead) + j] = s[j]; j = j + 1; }
  return out;
}

fn pack_field(f: crate::entry::Field) -> [i64] ! alloc
{
  match f {
    crate::entry::Field::Value(t) => { let lead: [i64] = lead1(0); return widen(t, lead); }
    crate::entry::Field::Missing => { return lead1(1); }
    crate::entry::Field::Defect(k) => { return lead2(2, k); }
  }
}

fn pack_title(t: crate::entry::Title) -> [i64] ! alloc
{
  match t {
    crate::entry::Title::Ranked(level, s) => { let lead: [i64] = lead2(0, level); return widen(s, lead); }
    crate::entry::Title::NoTitle => { return lead2(1, 0); }
    crate::entry::Title::Defect(k) => { return lead2(2, k); }
  }
}

pub fn one_line_w(data: [u8], max: i64) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  if max < 0 || max > 100000000000 || len(s) > 100000000000 { return lead1(-2); }
  let r: str = crate::text::one_line(s, max);
  let lead: [i64] = lead1(0);
  return widen(r, lead);
}

pub fn clip_bytes_w(data: [u8], max: i64) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  if max < 0 || max > 100000000 || len(s) > 100000000 { return lead1(-2); }
  let r: str = crate::text::clip_bytes(s, max);
  let lead: [i64] = lead1(0);
  return widen(r, lead);
}

pub fn trim_w(data: [u8]) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  let r: str = crate::text::trim(s);
  let lead: [i64] = lead1(0);
  return widen(r, lead);
}

pub fn is_blank_w(data: [u8]) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  if crate::text::is_blank(s) { return lead1(1); }
  return lead1(0);
}

pub fn space_len_w(data: [u8], at: i64) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  if at < 0 || at > len(s) { return lead1(-2); }
  return lead1(crate::text::space_len(s, at));
}

pub fn engine_line_w(data: [u8], origin: bool) -> [i64] ! alloc
{
  let s: str = crate::jstr::adapter_probe(data);
  if len(s) != len(data) { return lead1(-1); }
  if crate::text::engine_line(s, origin) { return lead1(1); }
  return lead1(0);
}

pub fn dropped_user_w(head: [u8]) -> [i64] ! alloc
{
  if crate::text::dropped_user(head) { return lead1(1); }
  return lead1(0);
}

// [0] Object, [1] Skip, [2, position] Defect.
pub fn line_kind_w(line: [u8]) -> [i64] ! alloc
{
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => { return lead1(0); }
    crate::entry::Line::Skip => { return lead1(1); }
    crate::entry::Line::Defect(p) => { return lead2(2, p); }
  }
}

pub fn string_field_w(line: [u8], key: [u8]) -> [i64] ! alloc
{
  let k: str = crate::jstr::adapter_probe(key);
  if len(k) != len(key) { return lead1(-1); }
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let f: crate::entry::Field = crate::entry::string_field(d, crate::access::root(d), k);
      return pack_field(f);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

// [1] present object, [0] missing or another kind, [-2] corrupt.
pub fn object_field_w(line: [u8], key: [u8]) -> [i64] ! alloc
{
  let k: str = crate::jstr::adapter_probe(key);
  if len(k) != len(key) { return lead1(-1); }
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let f: i64 = crate::entry::object_field(d, crate::access::root(d), k);
      if f >= 0 { return lead1(1); }
      if f == -1 { return lead1(0); }
      return lead1(-2);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

pub fn is_true_w(line: [u8], key: [u8]) -> [i64] ! alloc
{
  let k: str = crate::jstr::adapter_probe(key);
  if len(k) != len(key) { return lead1(-1); }
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let v: i64 = crate::entry::is_true(d, crate::access::root(d), k);
      if v < 0 { return lead2(2, v); }
      return lead1(v);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

pub fn task_origin_w(line: [u8]) -> [i64] ! alloc
{
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let v: i64 = crate::entry::task_origin(d, crate::access::root(d));
      if v < 0 { return lead2(2, v); }
      return lead1(v);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

pub fn human_text_w(line: [u8]) -> [i64] ! alloc
{
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let f: crate::entry::Field = crate::entry::human_text(d);
      return pack_field(f);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

pub fn pick_title_w(line: [u8], first: [u8], second: [u8]) -> [i64] ! alloc
{
  let a: str = crate::jstr::adapter_probe(first);
  if len(a) != len(first) { return lead1(-1); }
  let b: str = crate::jstr::adapter_probe(second);
  if len(b) != len(second) { return lead1(-1); }
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let f: crate::entry::Field = crate::entry::pick_title(d, crate::access::root(d), a, b);
      return pack_field(f);
    }
    crate::entry::Line::Skip => { return lead1(9); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}

pub fn title_of_w(line: [u8]) -> [i64] ! alloc
{
  let l: crate::entry::Line = crate::entry::parse_line(line, 0, len(line));
  match l {
    crate::entry::Line::Object(d) => {
      let t: crate::entry::Title = crate::entry::title_of(d);
      return pack_title(t);
    }
    crate::entry::Line::Skip => { return lead2(9, 0); }
    crate::entry::Line::Defect(p) => { return lead2(8, p); }
  }
}
