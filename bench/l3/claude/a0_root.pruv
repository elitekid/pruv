// L3-1 A0 root: plain-array host wrappers for framing and packet fixtures (root pub fns return [i64] only).
mod json;
mod lex;
mod parse;
mod lines;
mod boundary;
mod framing;

fn prefix(data: [i64], n: i64) -> [i64] ! alloc
  requires 0 <= n && n <= len(data)
{
  let mut out: [i64] = alloc(n, 0);
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n && len(out) == n
    decreases n - i
  { out[i] = data[i]; i = i + 1; }
  return out;
}

fn pair(a: i64, b: i64) -> [i64] ! alloc
{
  let mut out: [i64] = alloc(2, 0);
  out[0] = a; out[1] = b;
  return out;
}

// [0, (start,end,next)...] or [1, 65536] when the edge is oversized.
pub fn edge_frames(data: [u8], is_tail: bool, cut: bool) -> [i64] ! alloc
{
  if len(data) > crate::boundary::limit_edge_bytes() { return pair(1, 65536); }
  let mut out: [i64] = alloc(3 * len(data) + 2, 0);
  let mut offset: i64 = 0;
  let mut is_final: bool = !cut;
  if is_tail {
    offset = crate::framing::skip_first(data, cut);
    is_final = true;
  }
  let mut used: i64 = 1;
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant 1 <= used && used <= 3 * offset + 1
    invariant len(out) == 3 * len(data) + 2
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::edge_next(data, offset, is_final);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        out[used] = start; out[used + 1] = end; out[used + 2] = next;
        used = used + 3; offset = next;
      }
      crate::framing::Frame::Dropped(start, prefix_end, next) => { return prefix(out, used); }
      crate::framing::Frame::Done => { return prefix(out, used); }
    }
  }
  return prefix(out, used);
}

// [0, (kind,start,end,next)...] (kind 0 Entry, kind 1 Dropped with end = prefix_end) or [1, 8388608].
pub fn window_frames(data: [u8], cut: bool) -> [i64] ! alloc
{
  if len(data) > crate::boundary::limit_window_bytes() { return pair(1, 8388608); }
  let mut out: [i64] = alloc(4 * len(data) + 2, 0);
  let mut offset: i64 = crate::framing::skip_first(data, cut);
  let mut used: i64 = 1;
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant 1 <= used && used <= 4 * offset + 1
    invariant len(out) == 4 * len(data) + 2
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::window_next(data, offset);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        out[used] = 0; out[used + 1] = start; out[used + 2] = end; out[used + 3] = next;
        used = used + 4; offset = next;
      }
      crate::framing::Frame::Dropped(start, prefix_end, next) => {
        out[used] = 1; out[used + 1] = start; out[used + 2] = prefix_end; out[used + 3] = next;
        used = used + 4; offset = next;
      }
      crate::framing::Frame::Done => { return prefix(out, used); }
    }
  }
  return prefix(out, used);
}

pub fn packet(meta: [i64], turns: [i64], text: [u8]) -> [i64] ! alloc
{
  let o: crate::boundary::ImportOutput = crate::boundary::make_output(meta, turns, text);
  return crate::boundary::pack_result(crate::boundary::ImportResult::Imported(o));
}

pub fn failed_packet(code: i64, position: i64) -> [i64] ! alloc
{
  return crate::boundary::pack_result(crate::boundary::ImportResult::Failed(code, position));
}

// [-1] for out-of-range arguments, else the widened bytes of dst after copy_span on a copy.
pub fn copy_probe(dst: [u8], at: i64, src: [u8], lo: i64, hi: i64) -> [i64] ! alloc
{
  if lo < 0 || lo > hi || hi > len(src) || at < 0 || at > len(dst) || hi - lo > len(dst) - at {
    let mut bad: [i64] = alloc(1, 0);
    bad[0] = -1;
    return bad;
  }
  let mut d: [u8] = copy(dst);
  crate::boundary::copy_span(inout d, at, src, lo, hi);
  let mut out: [i64] = alloc(len(d), 0);
  let mut i: i64 = 0;
  while i < len(d)
    invariant 0 <= i && i <= len(d) && len(out) == len(d)
    decreases len(d) - i
  { out[i] = d[i]; i = i + 1; }
  return out;
}
