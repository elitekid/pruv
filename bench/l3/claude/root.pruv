// L3-1 host entry points: the three packet wrappers of the pure Claude transcript import (root pub fns take
// plain arrays and return [i64]; the buffer-bearing ImportResult cannot cross the root).
//   head_packet(data, cut_after)    data: at most 65536 bytes read at offset 0; nonzero cut_after = the file
//                                   extends beyond them
//   tail_packet(data, cut_before)   data: at most 65536 bytes of the file tail; nonzero cut_before = the window
//                                   starts after offset 0
//   window_packet(data, cut_before) data: at most 8388608 bytes of the file end; same flag meaning
// Result: success [0, 14, turn_slots, byte_len, ...meta(14), ...turns(10 each), ...text bytes widened to i64];
//         failure [code, position] (1 InputTooLarge, 2 InternalInvariant), no partial payload.
// Paths, plan tracking, mtime fallback and exception translation stay in the host.
mod json;
mod lex;
mod parse;
mod lines;
mod jstr;
mod access;
mod boundary;
mod framing;
mod text;
mod entry;
mod time;
mod turns;
mod import;

pub fn head_packet(data: [u8], cut_after: i64) -> [i64] ! alloc
{
  let r: crate::boundary::ImportResult = crate::import::read_head(data, cut_after != 0);
  return crate::boundary::pack_result(r);
}

pub fn tail_packet(data: [u8], cut_before: i64) -> [i64] ! alloc
{
  let r: crate::boundary::ImportResult = crate::import::tail_info(data, cut_before != 0);
  return crate::boundary::pack_result(r);
}

pub fn window_packet(data: [u8], cut_before: i64) -> [i64] ! alloc
{
  let r: crate::boundary::ImportResult = crate::import::read_window(data, cut_before != 0);
  return crate::boundary::pack_result(r);
}
