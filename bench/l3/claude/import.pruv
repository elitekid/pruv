// L3-1 A2/A4 import cores (mirror of claude.ts readHead, tailInfo and the readClaude loop): head metadata,
// tail title/lastAt and the window import over already-read byte windows, published through
// boundary::ImportResult.
// Head/tail share the edge framing of framing::edge_next. The window uses framing::window_next, the collector
// of turns.pruv and `consume_entry` (one parsed object: titles, human prompt, assistant reply/tools/model).
// No path discovery, plan tracking or exception translation (host duties).
// Selection rules (tested through the helpers and the whole results):
//   head: cwd/entrypoint = first string value (empty counts); title = one_line(first human text, 120);
//         stop once all three exist (unobservable apart from skipped work).
//   tail: lastAt = last accepted timestamp in input order; title = last maximum rank, ties to the later line.

// ---- selection helpers ----

// A candidate of `rank` replaces the current best (0 = none yet) when nothing is held or its rank is >=.
pub fn replaces(best: i64, rank: i64) -> bool
  requires 0 <= best && best <= 3 && 1 <= rank && rank <= 3
  ensures result ==> (best == 0 || rank >= best)
  ensures (best == 0 || rank >= best) ==> result
{
  if best == 0 { return true; }
  return rank >= best;
}

// Index of the last maximum of ranks 1..3 (-1 for none): every rank is <= it, every later one is smaller.
pub fn last_max(ranks: [u8]) -> i64
  requires forall i in 0..len(ranks): (1 <= ranks[i] && ranks[i] <= 3)
  ensures len(ranks) == 0 ==> result == -1
  ensures len(ranks) > 0 ==> (0 <= result && result < len(ranks))
  ensures len(ranks) > 0 ==> (forall i in 0..len(ranks): ranks[i] <= ranks[result])
  ensures len(ranks) > 0 ==> (forall i in result + 1..len(ranks): ranks[i] < ranks[result])
{
  let mut best: i64 = -1;
  let mut i: i64 = 0;
  while i < len(ranks)
    invariant 0 <= i && i <= len(ranks)
    invariant forall t in 0..len(ranks): (1 <= ranks[t] && ranks[t] <= 3)
    invariant i == 0 ==> best == -1
    invariant i > 0 ==> (0 <= best && best < i)
    invariant i > 0 ==> (forall t in 0..i: ranks[t] <= ranks[best])
    invariant i > 0 ==> (forall t in best + 1..i: ranks[t] < ranks[best])
    decreases len(ranks) - i
  {
    let r: i64 = ranks[i];
    if best == -1 {
      best = i;
    } else {
      let b: i64 = ranks[best];
      if replaces(b, r) { best = i; }
    }
    i = i + 1;
  }
  return best;
}

// Index of the first nonzero flag (a defined candidate), -1 when none: every earlier flag is zero.
pub fn first_present(flags: [u8]) -> i64
  ensures result >= -1
  ensures result == -1 ==> (forall i in 0..len(flags): flags[i] == 0)
  ensures result >= 0 ==> (result < len(flags) && flags[result] != 0 && (forall i in 0..result: flags[i] == 0))
{
  let mut i: i64 = 0;
  while i < len(flags)
    invariant 0 <= i && i <= len(flags)
    invariant forall t in 0..i: flags[t] == 0
    decreases len(flags) - i
  {
    if flags[i] != 0 { return i; }
    i = i + 1;
  }
  return -1;
}

// ---- output assembly ----

// Position inside [start, end] for a parser defect offset p of the line (start when p is out of range).
fn fail_at(start: i64, end: i64, p: i64) -> crate::boundary::ImportResult
  requires 0 <= start && start <= end
{
  if p >= 0 && p <= end - start {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), start + p);
  }
  return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), start);
}

fn fail_zero() -> crate::boundary::ImportResult
{
  return crate::boundary::ImportResult::Failed(crate::boundary::code_internal_invariant(), 0);
}

// 14 slots: version 1, the mode, everything else absent/zero.
fn meta_new(mode: i64) -> [i64] ! alloc
  requires 0 <= mode && mode <= 2
  ensures len(result) == 14 && result[0] == 1 && result[1] == mode && result[2] == 0 && result[3] == 0
  ensures result[4] == -1 && result[5] == 0 && result[6] == -1 && result[7] == 0 && result[8] == -1 && result[9] == 0
  ensures result[10] == -1 && result[11] == 0 && result[12] == -1 && result[13] == 0
{
  let mut m: [i64] = alloc(14, 0);
  m[0] = 1;
  m[1] = mode;
  m[4] = -1;
  m[6] = -1;
  m[8] = -1;
  m[10] = -1;
  m[12] = -1;
  return m;
}

// Copy the bytes of s into dst at `at`; every other byte is unchanged.
fn put_str(inout dst: [u8], at: i64, s: str) -> ()
  requires 0 <= at && at <= len(dst) && len(s) <= len(dst) - at
  ensures len(dst) == len(old(dst))
  ensures forall k in 0..len(s): dst[at + k] == s[k]
  ensures forall k in 0..len(dst): ((k < at || k >= at + len(s)) ==> dst[k] == old(dst)[k])
{
  let n: i64 = len(s);
  let mut j: i64 = 0;
  while j < n
    invariant 0 <= j && j <= n && n == len(s) && 0 <= at && at <= len(dst) && n <= len(dst) - at && len(dst) == len(old(dst))
    invariant forall k in 0..j: dst[at + k] == s[k]
    invariant forall k in 0..len(dst): ((k < at || k >= at + j) ==> dst[k] == old(dst)[k])
    decreases n - j
  {
    let b: i64 = s[j];
    dst[at + j] = b;
    j = j + 1;
  }
}

// Checked publication of a turn-free record.
fn publish(meta: [i64], text: [u8]) -> crate::boundary::ImportResult ! alloc
{
  let turns: [i64] = alloc(0, 0);
  if !crate::boundary::check_output(meta, turns, text) { return fail_zero(); }
  let o: crate::boundary::ImportOutput = crate::boundary::make_output(meta, turns, text);
  return crate::boundary::ImportResult::Imported(o);
}

// Head record: text is title, cwd, entrypoint (absent values are empty and take no space).
fn head_result(title: str, has_title: bool, cwd: str, has_cwd: bool, ep: str, has_ep: bool) -> crate::boundary::ImportResult ! alloc
{
  let tl: i64 = len(title);
  let cl: i64 = len(cwd);
  let el: i64 = len(ep);
  if tl > 5646080 || cl > 5646080 || el > 5646080 { return fail_zero(); }
  let total: i64 = tl + cl + el;
  if total > 5646080 { return fail_zero(); }
  let mut text: [u8] = alloc(total, 0);
  put_str(inout text, 0, title);
  put_str(inout text, tl, cwd);
  put_str(inout text, tl + cl, ep);
  let mut m: [i64] = meta_new(0);
  if has_title { m[4] = 0; m[5] = tl; }
  if has_cwd { m[6] = tl; m[7] = cl; }
  if has_ep { m[8] = tl + cl; m[9] = el; }
  return publish(m, text);
}

// Tail record: text is title, lastAt (24 bytes).
fn tail_result(title: str, has_title: bool, last: [u8], has_at: bool) -> crate::boundary::ImportResult ! alloc
{
  let tl: i64 = len(title);
  if tl > 5646080 { return fail_zero(); }
  let mut extra: i64 = 0;
  if has_at {
    if len(last) != 24 { return fail_zero(); }
    extra = 24;
  }
  let total: i64 = tl + extra;
  let mut text: [u8] = alloc(total, 0);
  put_str(inout text, 0, title);
  let mut m: [i64] = meta_new(1);
  if has_title { m[4] = 0; m[5] = tl; }
  if has_at {
    crate::boundary::copy_span(inout text, tl, last, 0, 24);
    m[10] = tl;
    m[11] = 24;
  }
  return publish(m, text);
}

// ---- head ----

// claude.ts readHead over at most 65536 bytes read at offset 0; cut_after: the file extends beyond them.
pub fn read_head(data: [u8], cut_after: bool) -> crate::boundary::ImportResult ! alloc
{
  if len(data) > crate::boundary::limit_edge_bytes() {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_input_too_large(), 0);
  }
  let mut cwd: str = "";
  let mut ep: str = "";
  let mut title: str = "";
  let mut has_cwd: bool = false;
  let mut has_ep: bool = false;
  let mut has_title: bool = false;
  let mut idle: bool = false;
  let mut offset: i64 = 0;
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::edge_next(data, offset, !cut_after);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            let root: i64 = crate::access::root(d);
            if !has_cwd {
              let f: crate::entry::Field = crate::entry::string_field(d, root, "cwd");
              match f {
                crate::entry::Field::Value(v) => { cwd = copy(v); has_cwd = true; }
                crate::entry::Field::Missing => { idle = true; }
                crate::entry::Field::Defect(e) => { return fail_at(start, end, 0); }
              }
            }
            if !has_ep {
              let g: crate::entry::Field = crate::entry::string_field(d, root, "entrypoint");
              match g {
                crate::entry::Field::Value(v) => { ep = copy(v); has_ep = true; }
                crate::entry::Field::Missing => { idle = true; }
                crate::entry::Field::Defect(e) => { return fail_at(start, end, 0); }
              }
            }
            if !has_title {
              let h: crate::entry::Field = crate::entry::human_text(d);
              match h {
                crate::entry::Field::Value(t) => {
                  if len(t) > 50331648 { return fail_at(start, end, 0); }
                  title = crate::text::one_line(t, 120);
                  has_title = true;
                }
                crate::entry::Field::Missing => { idle = true; }
                crate::entry::Field::Defect(e) => { return fail_at(start, end, 0); }
              }
            }
          }
          crate::entry::Line::Skip => { idle = true; }
          crate::entry::Line::Defect(p) => { return fail_at(start, end, p); }
        }
        offset = next;
        if has_cwd && has_ep && has_title { offset = len(data); }
      }
      crate::framing::Frame::Dropped(s, e, n) => { offset = len(data); }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  return head_result(title, has_title, cwd, has_cwd, ep, has_ep);
}

// ---- tail ----

// claude.ts tailInfo over at most 65536 bytes of the file tail; cut_before: the window starts after offset 0
// (the first range through its first LF is then discarded). A final unterminated range is accepted.
pub fn tail_info(data: [u8], cut_before: bool) -> crate::boundary::ImportResult ! alloc
{
  if len(data) > crate::boundary::limit_edge_bytes() {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_input_too_large(), 0);
  }
  let mut best: str = "";
  let mut best_rank: i64 = 0;
  let mut last: [u8] = alloc(0, 0);
  let mut has_at: bool = false;
  let mut idle: bool = false;
  let mut offset: i64 = crate::framing::skip_first(data, cut_before);
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data)
    invariant 0 <= best_rank && best_rank <= 3
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::edge_next(data, offset, true);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            let root: i64 = crate::access::root(d);
            let tf: i64 = crate::access::field(d, root, "timestamp");
            if tf < -1 { return fail_at(start, end, 0); }
            if tf >= 0 {
              let iso: crate::time::Iso = crate::time::iso_of(d, tf);
              if iso.status < 0 { return fail_at(start, end, 0); }
              if iso.status == 0 {
                last = copy(iso.text);
                has_at = true;
              }
            }
            let t: crate::entry::Title = crate::entry::title_of(d);
            match t {
              crate::entry::Title::Ranked(rank, text) => {
                if rank < 1 || rank > 3 { return fail_at(start, end, 0); }
                if len(text) > 50331648 { return fail_at(start, end, 0); }
                if replaces(best_rank, rank) {
                  best_rank = rank;
                  best = copy(text);
                }
              }
              crate::entry::Title::NoTitle => { idle = true; }
              crate::entry::Title::Defect(e) => { return fail_at(start, end, 0); }
            }
          }
          crate::entry::Line::Skip => { idle = true; }
          crate::entry::Line::Defect(p) => { return fail_at(start, end, p); }
        }
        offset = next;
      }
      crate::framing::Frame::Dropped(s, e, n) => { offset = len(data); }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  if len(best) > 100000000000 { return fail_zero(); }
  let title: str = crate::text::one_line(best, 120);
  return tail_result(title, best_rank > 0, last, has_at);
}

// ---- window (A4) ----
//
// Collector state travels through three caller-owned arrays (see turns.pruv): st [4], sl [1600], buf [13116800].
// The invariant repeated in every contract below (`s` ranges over the 200 slots):
//   ranges  lengths, 0 <= st[0] <= 1e12, 0 <= st[3] < 200, st[1] and st[2] are 0/1
//   I3(s)   0 <= prompt <= 32768, 0 <= reply <= budget <= 32768, 0 <= tools <= 1e15, flags 0/1
//   I4(s)   ring ordering of the draft ordinals

// What one consumed entry contributes: the rank (0 = none) and untrimmed text of a title candidate, and a model
// id (empty = none; a synthetic model is never published). Defect: parser/accessor defect, never malformed data.
pub enum Effect { Done(rank: i64, title: str, model: str), Defect(kind: i64) }
enum Stamp { At(text: str), Bad(kind: i64) }

// isoOf(entry.timestamp): the 24-byte canonical text, or "" when missing or unsupported.
fn stamp_of(doc: crate::json::JsonDocument) -> Stamp ! alloc
{
  let root: i64 = crate::access::root(doc);
  let none: str = "";
  let tf: i64 = crate::access::field(doc, root, "timestamp");
  if tf == -1 { return Stamp::At(copy(none)); }
  if tf < 0 { return Stamp::Bad(tf); }
  let iso: crate::time::Iso = crate::time::iso_of(doc, tf);
  if iso.status < 0 { return Stamp::Bad(iso.status); }
  if iso.status != 0 { return Stamp::At(copy(none)); }
  if len(iso.text) != 24 { return Stamp::Bad(-4); }
  let s: str = crate::jstr::adapter_probe(iso.text);
  if len(s) != 24 { return Stamp::Bad(-4); }
  return Stamp::At(copy(s));
}

// The content blocks of an assistant message in order: string-valued text blocks call answer, tool_use blocks
// call tool (whatever their name/id), everything else is ignored. 0 on success, -4 on a defect. The collector
// state keeps its scalar part (st unchanged); answer/tool only touch the current slot.
fn answer_blocks(doc: crate::json::JsonDocument, c: i64, at: str, inout st: [i64], inout sl: [i64], inout buf: [u8]) -> i64 ! alloc
  requires 0 <= c && c < len(doc.tape) / 6
  requires len(at) == 0 || len(at) == 24
  requires len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800 && 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800
  ensures st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  if len(doc.tape) > 6291456 { return -4; }
  let stop: i64 = doc.tape[6 * c + 3];
  if stop <= c || stop > len(doc.tape) / 6 { return -4; }
  let mut idle: bool = false;
  let mut j: i64 = c + 1;
  while j < stop
    invariant 0 <= c && c < j && j <= stop && stop <= len(doc.tape) / 6 && len(doc.tape) <= 6291456
    invariant len(at) == 0 || len(at) == 24
    invariant len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800 && 0 <= st[0] && st[0] <= 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
    invariant st[0] == old(st)[0] && st[1] == old(st)[1] && st[2] == old(st)[2] && st[3] == old(st)[3]
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases stop - j
  {
    let next: i64 = doc.tape[6 * j + 3];
    if next <= j || next > stop || doc.tape[6 * j + 4] != c { return -4; }
    let bk: i64 = crate::access::kind(doc, j);
    if bk < 0 { return -4; }
    if bk == 6 {
      let ty: i64 = crate::entry::string_id(doc, j, "type");
      if ty < -1 { return -4; }
      if ty >= 0 {
        let txt: i64 = crate::access::string_is(doc, ty, "text");
        if txt < 0 { return -4; }
        if txt == 1 {
          let tx: crate::entry::Field = crate::entry::string_field(doc, j, "text");
          match tx {
            crate::entry::Field::Value(x) => {
              if len(x) > 50331648 { return -4; }
              crate::turns::answer(inout st, inout sl, inout buf, x, at);
            }
            crate::entry::Field::Missing => { idle = true; }
            crate::entry::Field::Defect(e) => { return -4; }
          }
        } else {
          let tu: i64 = crate::access::string_is(doc, ty, "tool_use");
          if tu < 0 { return -4; }
          if tu == 1 { crate::turns::tool(inout st, inout sl); }
        }
      } else { idle = true; }
    }
    j = next;
  }
  return 0;
}

// The loop body of claude.ts readClaude for one parsed object (the root of doc):
//   1. titleOf (every object): rank and untrimmed text of the candidate.
//   2. humanText: a prompt begins a draft (createdAt = isoOf(timestamp)) and the entry is done.
//   3. otherwise only type == "assistant" with isSidechain !== true proceeds (isMeta alone does not matter);
//      message must be an object; model "<synthetic>" suppresses the entry unless isApiErrorMessage === true and
//      is never reported; the last nonempty nonsynthetic string model wins even without content or draft;
//      string content calls answer once (also for ""), array content goes block by block (answer_blocks).
// Collector state: at most one begin per call, so st[0] grows by at most 1.
pub fn consume_entry(doc: crate::json::JsonDocument, inout st: [i64], inout sl: [i64], inout buf: [u8]) -> Effect ! alloc
  requires len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800 && 0 <= st[0] && st[0] < 1000000000000 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  requires forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  requires forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
  ensures len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800
  ensures old(st)[0] <= st[0] && st[0] <= old(st)[0] + 1 && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
  ensures forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
  ensures forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
{
  let root: i64 = crate::access::root(doc);
  let nothing: str = "";
  let mut idle: bool = false;
  // 1. title candidate
  let mut rank: i64 = 0;
  let mut title: str = "";
  let t: crate::entry::Title = crate::entry::title_of(doc);
  match t {
    crate::entry::Title::Ranked(r, x) => {
      if r < 1 || r > 3 { return Effect::Defect(-4); }
      if len(x) > 50331648 { return Effect::Defect(-4); }
      rank = r;
      title = copy(x);
    }
    crate::entry::Title::NoTitle => { idle = true; }
    crate::entry::Title::Defect(e) => { return Effect::Defect(e); }
  }
  // the entry's timestamp (absent = "")
  let mut at: str = "";
  let sv: Stamp = stamp_of(doc);
  match sv {
    Stamp::At(x) => { at = copy(x); }
    Stamp::Bad(e) => { return Effect::Defect(e); }
  }
  if len(at) != 0 && len(at) != 24 { return Effect::Defect(-4); }
  // 2. human prompt
  let h: crate::entry::Field = crate::entry::human_text(doc);
  match h {
    crate::entry::Field::Value(p) => {
      if len(p) > 50331648 { return Effect::Defect(-4); }
      crate::turns::begin(inout st, inout sl, inout buf, p, at);
      return Effect::Done(rank, copy(title), copy(nothing));
    }
    crate::entry::Field::Missing => { idle = true; }
    crate::entry::Field::Defect(e) => { return Effect::Defect(e); }
  }
  // 3. assistant entries
  let asst: i64 = crate::entry::field_is(doc, root, "type", "assistant");
  if asst < 0 { return Effect::Defect(asst); }
  if asst == 0 { return Effect::Done(rank, copy(title), copy(nothing)); }
  let side: i64 = crate::entry::is_true(doc, root, "isSidechain");
  if side < 0 { return Effect::Defect(side); }
  if side == 1 { return Effect::Done(rank, copy(title), copy(nothing)); }
  let msg: i64 = crate::entry::object_field(doc, root, "message");
  if msg == -1 { return Effect::Done(rank, copy(title), copy(nothing)); }
  if msg < 0 { return Effect::Defect(msg); }
  let mut model: str = "";
  let mf: crate::entry::Field = crate::entry::string_field(doc, msg, "model");
  match mf {
    crate::entry::Field::Value(m) => {
      if crate::text::same(m, "<synthetic>") {
        let api: i64 = crate::entry::is_true(doc, root, "isApiErrorMessage");
        if api < 0 { return Effect::Defect(api); }
        if api != 1 { return Effect::Done(rank, copy(title), copy(nothing)); }
      } else {
        if len(m) > 50331648 { return Effect::Defect(-4); }
        model = copy(m);
      }
    }
    crate::entry::Field::Missing => { idle = true; }
    crate::entry::Field::Defect(e) => { return Effect::Defect(e); }
  }
  let c: i64 = crate::access::field(doc, msg, "content");
  if c == -1 || c == -2 { return Effect::Done(rank, copy(title), copy(model)); }
  if c < 0 { return Effect::Defect(c); }
  let k: i64 = crate::access::kind(doc, c);
  if k < 0 { return Effect::Defect(k); }
  if k == 4 {
    let tx: crate::jstr::Text = crate::access::string_text(doc, c);
    match tx {
      crate::jstr::Text::InternalInvariant(e) => { return Effect::Defect(e); }
      crate::jstr::Text::Decoded(v) => {
        if len(v) > 50331648 { return Effect::Defect(-4); }
        crate::turns::answer(inout st, inout sl, inout buf, v, at);
      }
    }
    return Effect::Done(rank, copy(title), copy(model));
  }
  if k != 5 { return Effect::Done(rank, copy(title), copy(model)); }
  let r: i64 = answer_blocks(doc, c, at, inout st, inout sl, inout buf);
  if r < 0 { return Effect::Defect(r); }
  return Effect::Done(rank, copy(title), copy(model));
}

// Checked publication of a record with turns.
fn publish_turns(meta: [i64], turns: [i64], text: [u8]) -> crate::boundary::ImportResult ! alloc
{
  if !crate::boundary::check_output(meta, turns, text) { return fail_zero(); }
  let o: crate::boundary::ImportOutput = crate::boundary::make_output(meta, turns, text);
  return crate::boundary::ImportResult::Imported(o);
}

// claude.ts readClaude over at most 8388608 bytes of the file end; cut_before: the window starts after offset 0.
// The first range through its first LF is then discarded; only LF-terminated lines are processed (a short
// unterminated tail is ignored); a line over 1048576 raw bytes is never parsed: one Dropped event, and when its
// 8 KiB prefix looks like a human line (text::dropped_user) skip_user runs before later lines.
// Result text: title, model, then the turns (prompt, reply, createdAt, completedAt each, oldest first).
// omittedBefore = cut_before || turn-suffix loss (an ignored malformed/oversized line alone does not set it).
pub fn read_window(data: [u8], cut_before: bool) -> crate::boundary::ImportResult ! alloc
{
  if len(data) > crate::boundary::limit_window_bytes() {
    return crate::boundary::ImportResult::Failed(crate::boundary::code_input_too_large(), 0);
  }
  let mut st: [i64] = crate::turns::new_state();
  let mut sl: [i64] = crate::turns::new_slots();
  let mut buf: [u8] = crate::turns::new_buffer();
  let mut best: str = "";
  let mut best_rank: i64 = 0;
  let mut model: str = "";
  let mut idle: bool = false;
  let mut offset: i64 = crate::framing::skip_first(data, cut_before);
  while offset < len(data)
    invariant 0 <= offset && offset <= len(data) && len(data) <= 8388608
    invariant 0 <= best_rank && best_rank <= 3
    invariant len(st) == 4 && len(sl) == 1600 && len(buf) == 13116800 && 0 <= st[0] && st[0] <= offset && 0 <= st[3] && st[3] < 200 && (st[1] == 0 || st[1] == 1) && (st[2] == 0 || st[2] == 1)
    invariant forall s in 0..200: (0 <= sl[8 * s] && sl[8 * s] <= 32768 && 0 <= sl[8 * s + 1] && sl[8 * s + 1] <= sl[8 * s + 2] && sl[8 * s + 2] <= 32768 && 0 <= sl[8 * s + 3] && sl[8 * s + 3] <= 1000000000000000 && (sl[8 * s + 4] == 0 || sl[8 * s + 4] == 1) && (sl[8 * s + 5] == 0 || sl[8 * s + 5] == 1) && (sl[8 * s + 6] == 0 || sl[8 * s + 6] == 1))
    invariant forall s in 0..200: ((st[0] <= s ==> sl[8 * s + 7] == -1) && (st[0] > s ==> (0 <= sl[8 * s + 7] && sl[8 * s + 7] < st[0] && st[0] - 200 <= sl[8 * s + 7] && sl[8 * s + 7] % 200 == s)))
    decreases len(data) - offset
  {
    let step: crate::framing::Frame = crate::framing::window_next(data, offset);
    match step {
      crate::framing::Frame::Entry(start, end, next) => {
        if start < 0 || start > end || end > len(data) || next <= offset || next > len(data) { return fail_zero(); }
        let line: crate::entry::Line = crate::entry::parse_line(data, start, end);
        match line {
          crate::entry::Line::Object(d) => {
            let eff: Effect = consume_entry(d, inout st, inout sl, inout buf);
            match eff {
              Effect::Done(rank, cand, mid) => {
                if rank >= 1 && rank <= 3 {
                  if replaces(best_rank, rank) {
                    best_rank = rank;
                    best = copy(cand);
                  }
                }
                if len(mid) > 0 { model = copy(mid); }
              }
              Effect::Defect(kind) => { return fail_at(start, end, 0); }
            }
          }
          crate::entry::Line::Skip => { idle = true; }
          crate::entry::Line::Defect(p) => { return fail_at(start, end, p); }
        }
        offset = next;
      }
      crate::framing::Frame::Dropped(s, e, n) => {
        if s < 0 || s > e || e > len(data) || e - s > 8192 || n <= offset || n > len(data) { return fail_zero(); }
        let mut head: [u8] = alloc(e - s, 0);
        crate::boundary::copy_span(inout head, 0, data, s, e);
        if crate::text::dropped_user(head) { crate::turns::skip_user(inout st); }
        offset = n;
      }
      crate::framing::Frame::Done => { offset = len(data); }
    }
  }
  // result assembly: title (one_line of the winning candidate; empty = absent), model, turns
  if len(best) > 100000000000 { return fail_zero(); }
  let title: str = crate::text::one_line(best, 120);
  let tl: i64 = len(title);
  let ml: i64 = len(model);
  if tl > 4096 || ml > 3145728 { return fail_zero(); }
  let base: i64 = tl + ml;
  let col: crate::turns::Collected = crate::turns::finish(st, sl, buf, base);
  let nt: i64 = len(col.turns);
  let nx: i64 = len(col.text);
  if nt < 0 || nt > 2000 || nx < 0 || nx > 2106752 { return fail_zero(); }
  if col.kept < 0 || col.kept > 200 || nt != 10 * col.kept { return fail_zero(); }
  let total: i64 = base + nx;
  let mut packed: [u8] = alloc(total, 0);
  put_str(inout packed, 0, title);
  put_str(inout packed, tl, model);
  crate::boundary::copy_span(inout packed, base, col.text, 0, nx);
  let mut m: [i64] = meta_new(2);
  if cut_before || col.trimmed == 1 { m[2] = 1; }
  m[3] = col.kept;
  if tl > 0 { m[4] = 0; m[5] = tl; }
  if ml > 0 { m[12] = tl; m[13] = ml; }
  return publish_turns(m, col.turns, packed);
}
