// G6 q02 reference: a scalar-key histogram (HashMap<i64, i64>) answers "how often does q occur in a"
fn count_value(a: [i64], q: i64) -> i64 ! alloc
  requires len(a) <= 1000000
  ensures result == count(k in 0..len(a): a[k] == q)
{
  let mut m: HashMap<i64, i64> = map_new::<i64, i64>();
  let mut c: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant 0 <= c && c <= i
    invariant len(m) <= i
    invariant c == count(k in 0..i: a[k] == q)
    invariant c == 0 ==> !is_some(map_lookup::<i64, i64>(m, q))
    invariant c > 0 ==> is_some(map_lookup::<i64, i64>(m, q)) && some_val(map_lookup::<i64, i64>(m, q)) == c
    decreases len(a) - i
  {
    let x: i64 = a[i];
    let cur: Option<i64> = map_get::<i64, i64>(m, x);
    match cur {
      Some(n) => {
        if n < 1000000 {
          m = map_insert::<i64, i64>(move m, x, n + 1);
        } else {
          m = map_insert::<i64, i64>(move m, x, n);
        }
      }
      None => {
        m = map_insert::<i64, i64>(move m, x, 1);
      }
    }
    if x == q {
      c = c + 1;
    }
    i = i + 1;
  }
  let r: Option<i64> = map_get::<i64, i64>(m, q);
  match r {
    Some(n) => { return n; }
    None => { return 0; }
  }
}

fn seen(a: [i64], q: i64) -> bool ! alloc
  requires len(a) <= 1000000
  ensures result ==> count(k in 0..len(a): a[k] == q) > 0
  ensures !result ==> count(k in 0..len(a): a[k] == q) == 0
{
  let n: i64 = count_value(a, q);
  return n > 0;
}
