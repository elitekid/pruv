struct Stats { count: i64, sum: i64, min: Option<i64>, max: Option<i64> }

fn stats(a: [i64]) -> Stats
  requires len(a) >= 0 && len(a) <= 1_000_000
  requires forall k in 0..len(a): a[k] >= -1_000_000_000 && a[k] <= 1_000_000_000
  ensures result.count == len(a)
  ensures result.sum == sum(k in 0..len(a): a[k])
  ensures len(a) == 0 ==> !is_some(result.min) && !is_some(result.max)
  ensures len(a) > 0 ==> is_some(result.min) && is_some(result.max)
  ensures len(a) > 0 ==> (forall k in 0..len(a): some_val(result.min) <= a[k]) && (exists k in 0..len(a): a[k] == some_val(result.min))
  ensures len(a) > 0 ==> (forall k in 0..len(a): some_val(result.max) >= a[k]) && (exists k in 0..len(a): a[k] == some_val(result.max))
{
  let mut s: i64 = 0;
  let mut mn: i64 = 0;
  let mut mx: i64 = 0;
  let mut i: i64 = 0;
  while i < len(a)
    invariant 0 <= i && i <= len(a)
    invariant s == sum(k in 0..i: a[k])
    invariant s >= -1_000_000_000 * i && s <= 1_000_000_000 * i
    invariant i > 0 ==> (forall k in 0..i: mn <= a[k]) && (exists k in 0..i: a[k] == mn)
    invariant i > 0 ==> (forall k in 0..i: mx >= a[k]) && (exists k in 0..i: a[k] == mx)
    decreases len(a) - i
  {
    s = s + a[i];
    if i == 0 {
      mn = a[i];
      mx = a[i];
    } else {
      if a[i] < mn {
        mn = a[i];
      }
      if a[i] > mx {
        mx = a[i];
      }
    }
    i = i + 1;
  }
  if len(a) == 0 {
    return Stats { count: len(a), sum: s, min: None, max: None };
  } else {
    return Stats { count: len(a), sum: s, min: Some(mn), max: Some(mx) };
  }
}
