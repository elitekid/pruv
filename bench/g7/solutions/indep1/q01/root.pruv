fn saturate(inout dst: [u8], lo: i64, hi: i64, c: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(dst)
  requires 0 <= c && c <= 255
  ensures forall k in lo..hi: old(dst)[k] + c <= 255 ==> dst[k] == old(dst)[k] + c
  ensures forall k in lo..hi: old(dst)[k] + c > 255 ==> dst[k] == 255
  ensures forall k in 0..len(dst): (k < lo || k >= hi) ==> dst[k] == old(dst)[k]
{
  let mut i: i64 = lo;
  while i < hi
    invariant lo <= i && i <= hi
    invariant forall k in lo..i: old(dst)[k] + c <= 255 ==> dst[k] == old(dst)[k] + c
    invariant forall k in lo..i: old(dst)[k] + c > 255 ==> dst[k] == 255
    invariant forall k in 0..lo: dst[k] == old(dst)[k]
    invariant forall k in i..len(dst): dst[k] == old(dst)[k]
    decreases hi - i
  {
    let value: i64 = dst[i] + c;
    if value <= 255 {
      dst[i] = value;
    } else {
      dst[i] = 255;
    }
    i = i + 1;
  }
  return;
}

fn wrap(inout dst: [u8], lo: i64, hi: i64, c: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(dst)
  requires 0 <= c && c <= 255
  ensures forall k in lo..hi: dst[k] == (old(dst)[k] + c) % 256
  ensures forall k in 0..len(dst): (k < lo || k >= hi) ==> dst[k] == old(dst)[k]
{
  let mut i: i64 = lo;
  while i < hi
    invariant lo <= i && i <= hi
    invariant forall k in lo..i: dst[k] == (old(dst)[k] + c) % 256
    invariant forall k in 0..lo: dst[k] == old(dst)[k]
    invariant forall k in i..len(dst): dst[k] == old(dst)[k]
    decreases hi - i
  {
    dst[i] = (dst[i] + c) % 256;
    i = i + 1;
  }
  return;
}

pub fn transform(a: [u8], b: [u8], lo: i64, hi: i64, c: i64, pick: i64) -> [u8] ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(a) && hi <= len(b) && 0 <= c && c <= 255
  requires pick == 0 || pick == 1
  ensures pick == 0 ==> len(result) == len(a)
  ensures pick == 1 ==> len(result) == len(b)
  ensures forall k in 0..len(result): (pick == 0 && lo <= k && k < hi && a[k] + c <= 255) ==> result[k] == a[k] + c
  ensures forall k in 0..len(result): (pick == 0 && lo <= k && k < hi && a[k] + c > 255) ==> result[k] == 255
  ensures forall k in 0..len(result): (pick == 1 && lo <= k && k < hi) ==> result[k] == (b[k] + c) % 256
  ensures forall k in 0..len(result): (pick == 0 && (k < lo || k >= hi)) ==> result[k] == a[k]
  ensures forall k in 0..len(result): (pick == 1 && (k < lo || k >= hi)) ==> result[k] == b[k]
{
  let mut left: [u8] = copy(a);
  let mut right: [u8] = copy(b);
  par {
    saturate(inout left, lo, hi, c);
    wrap(inout right, lo, hi, c);
  }
  if pick == 0 {
    return left;
  } else {
    return right;
  }
}
