// G3 q03 reference: first element of a nonempty [T], exposed through two concrete wrappers
fn first<T: Element>(a: [T]) -> T
  requires len(a) > 0
  ensures result == a[0]
{
  return a[0];
}

fn head_int(a: [i64]) -> i64
  requires len(a) > 0
  ensures result == a[0]
{
  return first::<i64>(a);
}

fn head_bool(a: [bool]) -> bool
  requires len(a) > 0
  ensures result == a[0]
{
  return first::<bool>(a);
}
