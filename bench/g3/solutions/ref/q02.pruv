// G3 q02 reference: Option fallback, exposed through two concrete wrappers
fn get_or<T>(o: Option<T>, d: T) -> T
  ensures is_some(o) ==> result == some_val(o)
  ensures !is_some(o) ==> result == d
{
  match o {
    Some(v) => { return v; }
    None => { return d; }
  }
}

fn get_or_int(has: bool, v: i64, d: i64) -> i64
  ensures has ==> result == v
  ensures !has ==> result == d
{
  if has {
    return get_or::<i64>(Some::<i64>(v), d);
  }
  return get_or::<i64>(None::<i64>, d);
}

fn get_or_bool(has: bool, v: bool, d: bool) -> bool
  ensures has ==> result == v
  ensures !has ==> result == d
{
  if has {
    return get_or::<bool>(Some::<bool>(v), d);
  }
  return get_or::<bool>(None::<bool>, d);
}
