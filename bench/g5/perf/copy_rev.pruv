// G5 perf (prior read-parameter style): `rev` reads its array parameter, copies it (intrinsic copy), reverses the copy and
// returns it. Same host entries and the same pointwise contract as inout_rev.pruv.
//   rev_once(a)    one reversal (one copy)
//   rev_n(a, n)    one copy of the input, then n reversals `w = rev(w)`; every reversal copies and frees once
fn rev(a: [i64]) -> [i64] ! alloc
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): result[k] == a[len(a) - 1 - k]
{
  let n: i64 = len(a);
  let mut w: [i64] = copy(a);
  let mut i: i64 = 0;
  let mut j: i64 = n - 1;
  while i < j
    invariant 0 <= i && i <= n
    invariant j == n - 1 - i
    invariant len(w) == n
    invariant len(a) == n
    invariant forall k in 0..i: w[k] == a[n - 1 - k]
    invariant forall k in 0..n: j < k ==> w[k] == a[n - 1 - k]
    invariant forall k in 0..n: i <= k && k <= j ==> w[k] == a[k]
    decreases j - i
  {
    let x: i64 = w[i];
    let y: i64 = w[j];
    w[i] = y;
    w[j] = x;
    i = i + 1;
    j = j - 1;
  }
  return w;
}

pub fn rev_once(a: [i64]) -> [i64] ! alloc
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): result[k] == a[len(a) - 1 - k]
{
  return rev(a);
}

pub fn rev_n(a: [i64], n: i64) -> [i64] ! alloc
  requires 0 <= n
  ensures len(result) == len(a)
{
  let mut w: [i64] = copy(a);
  let mut c: i64 = 0;
  while c < n
    invariant 0 <= c && c <= n
    invariant len(w) == len(a)
    decreases n - c
  {
    w = rev(w);
    c = c + 1;
  }
  return w;
}
