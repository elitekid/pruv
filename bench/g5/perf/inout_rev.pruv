// G5 perf (inout style): in-place reversal of an [i64] through an inout helper. `rev` never allocates, copies or frees;
// the ordinary host entries own their working local (one copy of the input) and call it.
// Host entries (the driver calls these):
//   rev_once(a)    one reversal; setup (one copy) included
//   rev_n(a, n)    one copy, then n in-place reversals; n == 0 measures the setup alone
fn swap_at(inout a: [i64], i: i64, j: i64) -> ()
  requires 0 <= i && i < len(a) && 0 <= j && j < len(a)
  ensures len(a) == len(old(a))
  ensures a[i] == old(a)[j]
  ensures a[j] == old(a)[i]
  ensures forall k in 0..len(a): k != i && k != j ==> a[k] == old(a)[k]
{
  let x: i64 = a[i];
  let y: i64 = a[j];
  a[i] = y;
  a[j] = x;
}

fn rev(inout a: [i64]) -> ()
  ensures len(a) == len(old(a))
  ensures forall k in 0..len(a): a[k] == old(a)[len(a) - 1 - k]
{
  let n: i64 = len(a);
  let mut i: i64 = 0;
  let mut j: i64 = n - 1;
  while i < j
    invariant 0 <= i && i <= n
    invariant j == n - 1 - i
    invariant len(a) == n
    invariant n == len(old(a))
    invariant forall k in 0..i: a[k] == old(a)[n - 1 - k]
    invariant forall k in 0..n: j < k ==> a[k] == old(a)[n - 1 - k]
    invariant forall k in 0..n: i <= k && k <= j ==> a[k] == old(a)[k]
    decreases j - i
  {
    swap_at(inout a, i, j);
    i = i + 1;
    j = j - 1;
  }
}

pub fn rev_once(a: [i64]) -> [i64] ! alloc
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): result[k] == a[len(a) - 1 - k]
{
  let mut w: [i64] = copy(a);
  rev(inout w);
  return w;
}

pub fn rev_n(a: [i64], n: i64) -> [i64] ! alloc
  requires 0 <= n
  ensures len(result) == len(a)
{
  let mut w: [i64] = copy(a);
  let mut c: i64 = 0;
  while c < n
    invariant 0 <= c && c <= n
    invariant len(w) == len(a)
    decreases n - c
  {
    rev(inout w);
    c = c + 1;
  }
  return w;
}
