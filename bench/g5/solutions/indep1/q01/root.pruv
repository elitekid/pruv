// Element update helpers (in place, exact contracts against old(b)).
fn sat_at(inout b: [u8], i: i64, c: i64) -> ()
  requires 0 <= i && i < len(b) && 0 <= c && c <= 255
  ensures old(b)[i] + c <= 255 ==> b[i] == old(b)[i] + c
  ensures old(b)[i] + c > 255 ==> b[i] == 255
  ensures forall k in 0..len(b): k != i ==> b[k] == old(b)[k]
{
  let x: i64 = b[i] + c;
  if x > 255 {
    b[i] = 255;
  } else {
    b[i] = x;
  }
}

fn wrap_at(inout b: [u8], i: i64, c: i64) -> ()
  requires 0 <= i && i < len(b) && 0 <= c && c <= 255
  ensures b[i] == (old(b)[i] + c) % 256
  ensures forall k in 0..len(b): k != i ==> b[k] == old(b)[k]
{
  let x: i64 = b[i] + c;
  b[i] = x % 256;
}

fn set_at(inout b: [u8], i: i64, v: i64) -> ()
  requires 0 <= i && i < len(b) && 0 <= v && v <= 255
  ensures b[i] == v
  ensures forall k in 0..len(b): k != i ==> b[k] == old(b)[k]
{
  b[i] = v;
}

// Range helpers.
fn sat_range(inout b: [u8], lo: i64, hi: i64, c: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(b) && 0 <= c && c <= 255
  ensures forall k in 0..len(b): (lo <= k && k < hi && old(b)[k] + c <= 255) ==> b[k] == old(b)[k] + c
  ensures forall k in 0..len(b): (lo <= k && k < hi && old(b)[k] + c > 255) ==> b[k] == 255
  ensures forall k in 0..len(b): (k < lo || k >= hi) ==> b[k] == old(b)[k]
{
  let mut i: i64 = lo;
  while i < hi
    invariant lo <= i && i <= hi && hi <= len(b)
    invariant forall k in 0..len(b): (lo <= k && k < i && old(b)[k] + c <= 255) ==> b[k] == old(b)[k] + c
    invariant forall k in 0..len(b): (lo <= k && k < i && old(b)[k] + c > 255) ==> b[k] == 255
    invariant forall k in 0..len(b): (k < lo || k >= i) ==> b[k] == old(b)[k]
    decreases hi - i
  {
    sat_at(inout b, i, c);
    i = i + 1;
  }
}

fn wrap_range(inout b: [u8], lo: i64, hi: i64, c: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(b) && 0 <= c && c <= 255
  ensures forall k in 0..len(b): (lo <= k && k < hi) ==> b[k] == (old(b)[k] + c) % 256
  ensures forall k in 0..len(b): (k < lo || k >= hi) ==> b[k] == old(b)[k]
{
  let mut i: i64 = lo;
  while i < hi
    invariant lo <= i && i <= hi && hi <= len(b)
    invariant forall k in 0..len(b): (lo <= k && k < i) ==> b[k] == (old(b)[k] + c) % 256
    invariant forall k in 0..len(b): (k < lo || k >= i) ==> b[k] == old(b)[k]
    decreases hi - i
  {
    wrap_at(inout b, i, c);
    i = i + 1;
  }
}

fn fill_range(inout b: [u8], lo: i64, hi: i64, v: i64) -> ()
  requires 0 <= lo && lo <= hi && hi <= len(b) && 0 <= v && v <= 255
  ensures forall k in 0..len(b): (lo <= k && k < hi) ==> b[k] == v
  ensures forall k in 0..len(b): (k < lo || k >= hi) ==> b[k] == old(b)[k]
{
  let mut i: i64 = lo;
  while i < hi
    invariant lo <= i && i <= hi && hi <= len(b)
    invariant forall k in 0..len(b): (lo <= k && k < i) ==> b[k] == v
    invariant forall k in 0..len(b): (k < lo || k >= i) ==> b[k] == old(b)[k]
    decreases hi - i
  {
    set_at(inout b, i, v);
    i = i + 1;
  }
}

pub fn add_sat(a: [u8], lo: i64, hi: i64, c: i64) -> [u8] ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(a) && 0 <= c && c <= 255
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): (lo <= k && k < hi && a[k] + c <= 255) ==> result[k] == a[k] + c
  ensures forall k in 0..len(a): (lo <= k && k < hi && a[k] + c > 255) ==> result[k] == 255
  ensures forall k in 0..len(a): (k < lo || k >= hi) ==> result[k] == a[k]
{
  let mut w: [u8] = copy(a);
  sat_range(inout w, lo, hi, c);
  return w;
}

pub fn add_wrap(a: [u8], lo: i64, hi: i64, c: i64) -> [u8] ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(a) && 0 <= c && c <= 255
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): (lo <= k && k < hi) ==> result[k] == (a[k] + c) % 256
  ensures forall k in 0..len(a): (k < lo || k >= hi) ==> result[k] == a[k]
{
  let mut w: [u8] = copy(a);
  wrap_range(inout w, lo, hi, c);
  return w;
}

pub fn fill_bytes(a: [u8], lo: i64, hi: i64, v: i64) -> [u8] ! alloc
  requires 0 <= lo && lo <= hi && hi <= len(a) && 0 <= v && v <= 255
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): (lo <= k && k < hi) ==> result[k] == v
  ensures forall k in 0..len(a): (k < lo || k >= hi) ==> result[k] == a[k]
{
  let mut w: [u8] = copy(a);
  fill_range(inout w, lo, hi, v);
  return w;
}
