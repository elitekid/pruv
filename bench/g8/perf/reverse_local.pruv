fn local_reverse_i64(a: [i64]) -> [i64] ! alloc
  ensures len(result) == len(a)
  ensures forall k in 0..len(a): result[k] == a[len(a) - 1 - k]
{
  let mut out: [i64] = alloc(len(a), 0);
  let mut i: i64 = 0;
  while i < len(a)
    invariant len(out) == len(a)
    invariant 0 <= i && i <= len(a)
    invariant forall k in 0..i: out[k] == a[len(a) - 1 - k]
    decreases len(a) - i
  {
    out[i] = a[len(a) - 1 - i];
    i = i + 1;
  }
  return out;
}



pub fn run(a: [i64]) -> [i64] ! alloc

{ return local_reverse_i64(a); }
