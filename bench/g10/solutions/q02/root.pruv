fn count(f: File) -> i64
  requires file_size(f) <= 4096
  ensures 0 <= result && result <= 4097 * 10001
{
  let n: i64 = file_size(f);
  if n == 0 { return 0; }
  let mut lines: i64 = 0;
  let mut commas: i64 = 0;
  let mut i: i64 = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant 0 <= lines && lines <= i
    invariant 0 <= commas && commas <= i
    invariant lines + commas <= i
    decreases n - i
  {
    let b: i64 = file_byte(f, i);
    if b == 10 { lines = lines + 1; }
    if b == 44 { commas = commas + 1; }
    i = i + 1;
  }
  if file_byte(f, n - 1) != 10 { lines = lines + 1; }
  return lines * 10000 + lines + commas;
}
pub fn count_fields(path: str) -> i64 ! fs, alloc
  ensures -2 <= result && result <= 4097 * 10001
{
  let f: File = file_open_read(path);
  if !file_readable(f) { return -1; }
  let g: File = file_read_all(move f);
  if !file_ok(g) { return -1; }
  if file_size(g) > 4096 { return -2; }
  return count(g);
}
